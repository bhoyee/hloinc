{% extends "layouts/public.njk" %}
{% import "partials/ds-error.njk" as err %}

{% block mainClass %}ds{% endblock %}

{# "Page not found" (404), and "Page removed" (410) for old WordPress pages that are gone for good. #}
{% block content %}
  {% if code == 410 %}
    {{ err.panel('410', 'Page removed', 'This page is no longer available', 'It was part of our old website and has been removed. Everything you need is on our new site: start from the home page, or contact us and we will help.', site) }}
  {% else %}
    {{ err.panel('404', 'Page not found', 'We can’t find that page', 'The link may be out of date, or the page may have moved. Try one of the pages below, or contact us and we will help you find it.', site) }}
  {% endif %}
{% endblock %}
