{% extends "layouts/public.njk" %}
{% import "partials/ds-error.njk" as err %}

{% block mainClass %}ds{% endblock %}

{% block content %}
  {% set extra %}{% if errorRef %}<p class="d-fine-print">If you contact us about this, please mention reference <strong>{{ errorRef }}</strong>.</p>{% endif %}{% if stack %}<pre class="d-stack">{{ stack }}</pre>{% endif %}{% endset %}
  {% if status >= 500 %}
    {{ err.panel(status, 'Something went wrong', 'Sorry, something went wrong on our side', 'Please try again in a few minutes. If it keeps happening, call or email us and we will help straight away.', site, extra) }}
  {% else %}
    {{ err.panel(status, title, title, message, site, extra) }}
  {% endif %}
{% endblock %}
