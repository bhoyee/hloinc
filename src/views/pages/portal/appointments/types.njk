{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}

{% import "partials/appointment-nav.njk" as apptNav with context %}
{% block actions %}
  <div class="flex flex-wrap gap-2">
    {{ apptNav.nav('types') }}
    <a href="/portal/appointments/types/new" class="btn-secondary shrink-0">{{ icon('plus', 'size-4') }} New type</a>
  </div>
{% endblock %}

{% block content %}
  <p class="mb-5 flex max-w-3xl gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-[15px] text-amber-900">
    {{ icon('info', 'mt-0.5 size-5 shrink-0') }} HLO needs to confirm which appointment types visitors can request, how long each takes and how many can happen at once (client question 5).
  </p>
  <div class="overflow-x-auto rounded-3xl border border-line bg-white shadow-soft" tabindex="0" role="region" aria-label="Appointment types">
    <table class="w-full min-w-[640px] text-left text-[15px]">
      <caption class="sr-only">Appointment types</caption>
      <thead class="border-b border-line bg-surface text-sm text-muted">
        <tr>
          <th scope="col" class="px-5 py-3 font-semibold">Type</th>
          <th scope="col" class="px-5 py-3 font-semibold">Length</th>
          <th scope="col" class="px-5 py-3 font-semibold">At once</th>
          <th scope="col" class="px-5 py-3 font-semibold">On the website</th>
          <th scope="col" class="px-5 py-3 font-semibold">Appointments</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {% for t in types %}
          <tr class="hover:bg-surface">
            <th scope="row" class="px-5 py-4 font-normal">
              <a href="/portal/appointments/types/{{ t.id }}" class="font-semibold text-ink hover:text-brand-700">{{ t.name }}</a>
              {% if t.description %}<span class="block text-sm text-muted">{{ t.description }}</span>{% endif %}
            </th>
            <td class="px-5 py-4">{{ t.duration_minutes }} min</td>
            <td class="px-5 py-4">{{ t.capacity }}</td>
            <td class="px-5 py-4">{% if t.active %}<span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-800 ring-1 ring-brand-100">Available</span>{% else %}<span class="rounded-full bg-surface px-2.5 py-1 text-xs font-semibold text-muted ring-1 ring-line">Hidden</span>{% endif %}</td>
            <td class="px-5 py-4 text-muted">{{ t.uses }}</td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="px-5 py-8 text-center text-muted">No appointment types yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
