{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  <form method="post" action="/portal/appointments" class="max-w-3xl space-y-6" novalidate data-once>
    {{ ui.errorSummary(errors) }}
    <input type="hidden" name="_csrf" value="{{ csrfToken() }}">

    <section class="rounded-3xl border border-line bg-white p-6 shadow-soft sm:p-8">
      <fieldset id="f-source" tabindex="-1">
        <legend class="form-label">How did they contact us?</legend>
        <div class="mt-2 grid gap-3 sm:grid-cols-2">
          {% for o in [{ v: 'walk_in', l: 'Walk-in', d: 'They’re here at the office', i: 'users' }, { v: 'phone', l: 'Phone call', d: 'Booked over the phone', i: 'phone' }] %}
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-line p-4 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
              <input type="radio" name="source" value="{{ o.v }}" class="size-5 accent-brand-700" {% if values.source == o.v %}checked{% endif %}>
              <span class="icon-tile size-10">{{ icon(o.i, 'size-5') }}</span>
              <span><span class="block font-semibold text-ink">{{ o.l }}</span><span class="block text-sm text-muted">{{ o.d }}</span></span>
            </label>
          {% endfor %}
        </div>
        {{ ui.fieldError('source', errors) }}
      </fieldset>

      <div class="mt-6">
        <label for="f-type_id" class="form-label">Appointment type</label>
        <select id="f-type_id" name="type_id" class="form-control" required {% if errors.type_id %}aria-invalid="true" aria-describedby="f-type_id-error"{% endif %}>
          {% for t in types %}<option value="{{ t.id }}" data-duration="{{ t.duration_minutes }}" {% if values.type_id == t.id | string %}selected{% endif %}>{{ t.name }} ({{ t.duration_minutes }} min)</option>{% endfor %}
        </select>
        {{ ui.fieldError('type_id', errors) }}
      </div>
    </section>

    <section class="rounded-3xl border border-line bg-white p-6 shadow-soft sm:p-8">
      <h2 class="text-lg font-bold">Who</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        {{ ui.input('name', 'Name', values, errors, autocomplete='off') }}
        {{ ui.input('phone', 'Phone', values, errors, type='tel', required=false, autocomplete='off') }}
      </div>
      <div class="mt-5">{{ ui.input('email', 'Email', values, errors, type='email', required=false, autocomplete='off', hint='Needed to email a confirmation.') }}</div>
      <div class="mt-5">{{ ui.textarea('notes', 'Reason for the visit', values, errors, required=false, rows=3, maxlength=1000, hint='Brief. No diagnoses or medication details.') }}</div>
    </section>

    <section class="rounded-3xl border border-line bg-white p-6 shadow-soft sm:p-8">
      <h2 class="text-lg font-bold">When</h2>
      <p class="mt-1 text-[15px] text-muted">For a walk-in happening now, leave the current time.</p>
      <div class="mt-5 grid gap-5 sm:grid-cols-3">
        {{ ui.input('date', 'Date', values, errors, type='date') }}
        {{ ui.input('time', 'Start time', values, errors, type='time', attrs='step="300"') }}
        {{ ui.input('duration_minutes', 'Length (minutes)', values, errors, type='number', attrs='min="5" max="480" step="5"') }}
      </div>
      <div class="mt-5">
        <label for="f-assigned_to" class="form-label">With <span class="font-normal text-muted">(optional)</span></label>
        <select id="f-assigned_to" name="assigned_to" class="form-control">
          <option value="">Not assigned</option>
          {% for s in staff %}<option value="{{ s.id }}" {% if values.assigned_to == s.id | string %}selected{% endif %}>{{ s.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="mt-5">{{ ui.textarea('staff_notes', 'Staff notes', values, errors, required=false, rows=2, maxlength=2000, hint='Only staff see these.') }}</div>
      <label class="mt-5 flex items-start gap-3">
        <input type="checkbox" name="notify" value="yes" class="mt-1 size-5 shrink-0 accent-brand-700" {% if values.notify == 'yes' %}checked{% endif %}>
        <span><span class="font-semibold text-ink">Email a confirmation</span><span class="block text-sm text-muted">Uses the email address above.</span></span>
      </label>
      {% if problems.length %}
        <div class="mt-5 rounded-2xl border-2 border-amber-300 bg-amber-50 p-4" role="alert" tabindex="-1" data-focus-on-load>
          <p class="font-semibold text-amber-900">Check this time</p>
          <ul class="mt-1 list-disc pl-5 text-[15px] text-amber-900">{% for p in problems %}<li>{{ p }}</li>{% endfor %}</ul>
          <label class="mt-3 flex items-center gap-3 font-semibold text-ink"><input type="checkbox" name="override" value="yes" class="size-5 accent-brand-700"> I understand — book it anyway</label>
        </div>
      {% endif %}
    </section>

    <div class="flex flex-wrap gap-3">
      <button type="submit" class="btn-primary">{{ icon('check', 'size-4') }} Log appointment</button>
      <a href="/portal/appointments" class="btn-secondary">Cancel</a>
    </div>
  </form>
{% endblock %}
