{% extends "layouts/base.njk" %}

{% block meta %}
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="{{ csrfToken() }}">
{% endblock %}
{% block scripts %}<script src="/js/cms-editor.js" defer></script>{% endblock %}
{% block bodyClass %}h-dvh overflow-hidden bg-[#e9efec]{% endblock %}

{% block body %}
<div class="flex h-dvh flex-col" data-cms-editor data-page="{{ page.key }}" data-editable="{{ 'yes' if editable else 'no' }}">
  {# Toolbar #}
  <header class="z-10 flex shrink-0 flex-wrap items-center gap-2 border-b border-line bg-white px-3 py-2 shadow-sm sm:gap-3 sm:px-4">
    <a href="/portal/content" class="grid size-10 shrink-0 place-items-center rounded-xl text-ink hover:bg-surface" title="Back to Site content">
      {{ icon('chevron-right', 'size-5 rotate-180') }}<span class="sr-only">Back to Site content</span>
    </a>

    <div class="min-w-0">
      <label for="cms-page" class="sr-only">Page</label>
      <select id="cms-page" class="form-control !w-auto max-w-[15rem] !py-2 font-semibold" data-page-picker>
        {% set lastGroup = '' %}
        {% for p in pages %}
          {% if p.group != lastGroup %}{% if lastGroup %}</optgroup>{% endif %}<optgroup label="{{ p.group }}">{% set lastGroup = p.group %}{% endif %}
          <option value="{{ p.key }}" {% if p.key == page.key %}selected{% endif %}>{{ p.label }}{% if not p.editable %} (view only){% endif %}</option>
        {% endfor %}
        </optgroup>
      </select>
    </div>

    <p class="hidden items-center gap-2 rounded-full bg-surface px-3 py-1.5 text-sm font-medium text-muted ring-1 ring-line md:flex" aria-live="polite">
      <span class="size-2 rounded-full bg-[#93a49b]" data-status-dot aria-hidden="true"></span>
      <span data-status>Loading…</span>
    </p>

    <div class="ml-auto flex items-center gap-1 rounded-xl bg-surface p-1 ring-1 ring-line" role="group" aria-label="Preview size">
      {% for d in [{ k: 'desktop', l: 'Desktop', i: 'dashboard' }, { k: 'tablet', l: 'Tablet', i: 'device' }, { k: 'phone', l: 'Phone', i: 'phone' }] %}
        <button type="button" class="grid size-9 place-items-center rounded-lg text-muted hover:text-ink aria-pressed:bg-white aria-pressed:text-ink aria-pressed:shadow-sm" aria-pressed="{{ 'true' if d.k == 'desktop' else 'false' }}" data-device="{{ d.k }}" title="{{ d.l }}">
          {{ icon(d.i, 'size-4') }}<span class="sr-only">{{ d.l }}</span>
        </button>
      {% endfor %}
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {% if editable %}
        <button type="button" class="btn-secondary !px-4 !py-2" data-open-settings>{{ icon('pencil', 'size-4') }}<span class="hidden lg:inline">Page settings</span></button>
        <button type="button" class="btn-secondary !px-4 !py-2" data-open-history>{{ icon('clock', 'size-4') }}<span class="hidden lg:inline">History</span></button>
      {% endif %}
      <a href="{{ previewUrl }}" target="_blank" rel="noopener" class="btn-secondary !px-4 !py-2">{{ icon('eye', 'size-4') }}<span class="hidden lg:inline">Preview</span></a>
      {% if editable %}
        <button type="button" class="btn-secondary !px-4 !py-2" data-discard disabled>Discard</button>
        <button type="button" class="btn-primary !px-5 !py-2" data-publish disabled>{{ icon('check', 'size-4') }} Publish</button>
      {% else %}
        <span class="rounded-full bg-surface px-3 py-1.5 text-sm font-semibold text-muted ring-1 ring-line">{{ icon('lock', 'inline size-3.5') }} View only</span>
      {% endif %}
    </div>
  </header>

  {% if editable %}
    <p class="shrink-0 bg-brand-950 px-4 py-2 text-center text-xs text-brand-100 sm:text-sm">
      Click any text to edit it · click a photo to change it · hover a card or section for more options. Changes save as a draft; visitors see them after you <strong class="text-white">Publish</strong>.
    </p>
  {% endif %}

  {# The page itself #}
  <main id="main" class="min-h-0 flex-1 overflow-auto p-0 sm:p-4">
    <div class="mx-auto h-full overflow-hidden bg-white shadow-lift transition-[max-width] duration-300 sm:rounded-2xl" data-frame-wrap>
      <iframe src="{{ frameUrl }}" title="{{ page.label }} page (editing)" class="block size-full border-0" data-frame></iframe>
    </div>
  </main>
</div>

{# Page settings #}
<dialog class="cms-dialog" aria-labelledby="settings-h" data-settings-dialog>
  <form method="dialog">
    <div class="cms-dialog-body">
      <h2 id="settings-h" class="font-display text-xl font-bold">Page settings</h2>
      <p class="mt-1 text-sm text-muted">How this page appears in the browser tab and in Google search results.</p>
      <div class="mt-5 space-y-5" data-settings-fields></div>
    </div>
    <div class="cms-dialog-foot">
      <button value="cancel" class="btn-secondary !py-2.5">Cancel</button>
      <button value="save" class="btn-primary !py-2.5" data-settings-save>Save</button>
    </div>
  </form>
</dialog>

{# History #}
<dialog class="cms-dialog" aria-labelledby="history-h" data-history-dialog>
  <div class="cms-dialog-body">
    <h2 id="history-h" class="font-display text-xl font-bold">Published versions</h2>
    <p class="mt-1 text-sm text-muted">Restoring a version copies it into the draft, so you can check it before publishing.</p>
    <ol class="mt-5 divide-y divide-line" data-history-list></ol>
    <div class="mt-6 rounded-2xl bg-surface p-4 text-sm ring-1 ring-line">
      <p class="font-semibold text-ink">Start again</p>
      <p class="mt-1 text-muted">Put this page back to the original design and text, as a draft.</p>
      <button type="button" class="mt-3 font-semibold text-accent-700 hover:text-accent-800" data-reset>{{ icon('refresh', 'inline size-4') }} Use the original page</button>
    </div>
  </div>
  <div class="cms-dialog-foot"><button type="button" class="btn-secondary !py-2.5" data-close-history>Close</button></div>
</dialog>
{% endblock %}
