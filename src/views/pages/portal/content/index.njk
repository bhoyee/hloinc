{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}

{% block actions %}
  <a href="/" target="_blank" rel="noopener" class="btn-secondary">{{ icon('external', 'size-4') }} View the website</a>
{% endblock %}

{% block content %}
  <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {% for s in sections %}
      <li>
        <a href="/portal/content/{{ s.key }}" class="group relative flex h-full flex-col rounded-3xl border border-line bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift">
          <span class="flex items-start justify-between gap-3">
            <span class="icon-tile size-12 transition duration-300 group-hover:bg-brand-700 group-hover:text-white group-hover:ring-brand-700">{{ icon(s.icon, 'size-6') }}</span>
            {% if not s.editable %}<span class="rounded-full bg-surface px-2.5 py-1 text-xs font-semibold text-muted ring-1 ring-line">{{ icon('lock', 'inline size-3.5') }} View only</span>{% endif %}
          </span>
          <span class="mt-4 font-display text-lg font-bold text-ink group-hover:text-brand-700">{{ s.label }}</span>
          <span class="mt-1 text-[15px] text-muted">{{ s.description }}</span>
          <span class="mt-auto pt-4 text-xs text-muted">
            {% if lastChanged[s.key] %}Last changed {{ lastChanged[s.key].at | date({ month: 'short', day: 'numeric', year: 'numeric' }) }} by {{ lastChanged[s.key].by }}{% else %}Original text{% endif %}
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
  <p class="mt-6 flex items-start gap-2 text-sm text-muted">{{ icon('info', 'mt-0.5 size-4 shrink-0') }} Every change is recorded in the audit log with the old and new text. Job postings and announcements have their own sections in the menu.</p>
{% endblock %}
