{% extends "layouts/portal-auth.njk" %}
{% import "partials/ui.njk" as ui %}

{% block card %}
  <h1 class="text-2xl font-extrabold">Reset your password</h1>
  <p class="mt-1.5 text-[15px] text-muted">Enter your work email and we’ll send you a link to choose a new password.</p>

  <form method="post" action="/portal/forgot-password" class="mt-6 space-y-5" novalidate data-once>
    <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
    {{ ui.input('email', 'Email address', values, errors, type='email', autocomplete='username') }}
    <button type="submit" class="btn-primary w-full">Send reset link</button>
  </form>
  <p class="mt-6 text-center text-sm"><a href="/portal/login" class="font-semibold text-brand-700 hover:text-brand-800">&larr; Back to sign in</a></p>
{% endblock %}
