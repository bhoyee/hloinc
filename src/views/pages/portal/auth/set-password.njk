{% extends "layouts/portal-auth.njk" %}
{% import "partials/ui.njk" as ui %}

{% block card %}
  <h1 class="text-2xl font-extrabold">{{ heading }}</h1>
  <p class="mt-1.5 text-[15px] text-muted">{{ intro }}</p>
  <p class="mt-4 rounded-2xl bg-surface px-4 py-3 text-sm text-ink ring-1 ring-line">Account: <strong>{{ user.email }}</strong></p>

  <form method="post" class="mt-6 space-y-5" novalidate data-once>
    {{ ui.errorSummary(errors) }}
    <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
    {# Lets password managers save the new password against the right account. #}
    <input type="email" name="username" value="{{ user.email }}" autocomplete="username" class="sr-only" tabindex="-1" aria-hidden="true" readonly>
    {% include "partials/portal-new-password.njk" %}
    <button type="submit" class="btn-primary w-full">Save password</button>
  </form>
{% endblock %}
