{% extends "layouts/portal-auth.njk" %}
{% import "partials/ui.njk" as ui %}

{% block card %}
  <span class="icon-tile-red">{{ icon('device', 'size-6') }}</span>
  <h1 class="mt-5 text-2xl font-extrabold">Two-step sign in</h1>
  <p class="mt-1.5 text-[15px] text-muted">Open your authenticator app and enter the 6-digit code for the HLO Staff Portal.</p>

  <form method="post" action="/portal/login/verify" class="mt-6 space-y-5" novalidate data-once>
    <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
    <div>
      <label for="f-code" class="form-label">Code</label>
      <input id="f-code" name="code" class="form-control text-center font-mono text-2xl tracking-[0.4em]" inputmode="numeric"
             autocomplete="one-time-code" maxlength="20" required aria-required="true" autofocus
             {% if errors.code %}aria-invalid="true" aria-describedby="f-code-error"{% endif %}>
      {{ ui.fieldError('code', errors) }}
    </div>
    <button type="submit" class="btn-primary w-full">Verify and sign in</button>
  </form>

  <details class="mt-6 rounded-2xl bg-surface p-4 text-[15px] ring-1 ring-line">
    <summary class="cursor-pointer font-semibold text-ink">Can’t use your app?</summary>
    <p class="mt-2 text-muted">Enter one of your recovery codes (like <span class="font-mono">7KQ4-M2XP</span>) in the box above instead. Each code works once. If you have none left, ask an administrator to reset your two-step sign-in.</p>
  </details>
  <p class="mt-6 text-center text-sm"><a href="/portal/login" class="font-semibold text-brand-700 hover:text-brand-800">Start over</a></p>
{% endblock %}
