{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}
{% import "partials/portal-badges.njk" as badges %}

{% block actions %}
  <div class="flex flex-wrap gap-2">
    <a href="/careers" target="_blank" rel="noopener" class="btn-secondary">{{ icon('external', 'size-4') }} Careers page</a>
    {% if can('jobs.applications') %}<a href="/portal/applications" class="btn-secondary">{{ icon('document', 'size-4') }} Applications{% if navBadges.applications %} <span class="rounded-full bg-accent-600 px-2 py-0.5 text-xs font-bold text-white">{{ navBadges.applications }} new</span>{% endif %}</a>{% endif %}
    {% if can('jobs.edit') %}<a href="/portal/jobs/new" class="btn-primary">{{ icon('plus', 'size-4') }} New job</a>{% endif %}
  </div>
{% endblock %}

{% block content %}
  <nav aria-label="Job lists" class="mb-5 flex gap-1 overflow-x-auto rounded-2xl border border-line bg-white p-1.5 shadow-soft">
    {% for t in tabs %}
      <a href="/portal/jobs?tab={{ t.key }}" {% if t.key == tab %}aria-current="page"{% endif %}
         class="flex shrink-0 items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition {{ 'bg-brand-700 text-white' if t.key == tab else 'text-muted hover:bg-surface hover:text-ink' }}">
        {{ t.label }}
        <span class="rounded-full px-2 py-0.5 text-xs {{ 'bg-white text-brand-800' if t.key == tab else 'bg-surface ring-1 ring-line' }}">{{ counts[t.key] }}</span>
      </a>
    {% endfor %}
  </nav>

  <form method="get" data-live-filter="#jobs-results" action="/portal/jobs" role="search" aria-label="Search jobs" class="mb-5 flex gap-3 rounded-3xl border border-line bg-white p-4 shadow-soft">
    <input type="hidden" name="tab" value="{{ tab }}">
    <div class="relative flex-1">
      <label for="f-q" class="sr-only">Search by title, department or location</label>
      <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-muted">{{ icon('search', 'size-5') }}</span>
      <input id="f-q" type="search" name="q" value="{{ q }}" placeholder="Title, department or location" class="form-control !pl-12" maxlength="100">
    </div>
    <button type="submit" class="btn-green" data-live-hide>Search</button>
  </form>

  <div id="jobs-results" data-live-results>
  {{ ui.listBar(pager, 'jobs') }}

  {% if items.length %}
    <ul class="divide-y divide-line overflow-hidden rounded-3xl border border-line bg-white shadow-soft">
      {% for j in items %}
        <li class="group relative transition-colors hover:bg-surface focus-within:bg-surface">
          <div class="flex flex-col gap-3 px-5 py-4 sm:px-6 lg:flex-row lg:items-center lg:gap-6">
            <span class="hidden size-11 shrink-0 place-items-center rounded-2xl sm:grid {{ 'bg-brand-50 text-brand-700 ring-1 ring-brand-100' if j.status == 'published' else 'bg-surface text-muted ring-1 ring-line' }}">{{ icon('briefcase', 'size-5') }}</span>
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-center gap-2">
                <a href="/portal/jobs/{{ j.id }}" class="font-semibold text-ink after:absolute after:inset-0 after:content-[''] group-hover:text-brand-700 focus-visible:outline-none">{{ j.title }}</a>
                {{ badges.status(j.status, statusLabels[j.status]) }}
                {% if j.status == 'published' and not j.pay_range %}<span class="inline-flex items-center gap-1 text-xs font-semibold text-accent-700">{{ icon('exclamation', 'size-3.5') }} No pay range</span>{% endif %}
              </p>
              <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
                {% if j.department %}<span>{{ j.department }}</span>{% endif %}
                {% if j.location %}<span class="inline-flex items-center gap-1">{{ icon('map-pin', 'size-3.5') }} {{ j.location }}</span>{% endif %}
                {% if j.employment_type %}<span>{{ j.employment_type }}</span>{% endif %}
                {% if j.pay_range %}<span class="font-medium text-ink">{{ j.pay_range }}</span>{% endif %}
              </p>
            </div>
            <div class="text-sm text-muted lg:w-60 lg:text-right">
              {% if j.status == 'published' and j.published_at %}<p class="font-semibold text-ink">Live since {{ j.published_at | date({ month: 'short', day: 'numeric', year: 'numeric' }) }}</p>{% endif %}
              <p>Updated {{ j.updated_at | date({ month: 'short', day: 'numeric' }) }}{% if j.updated_by_name %} by {{ j.updated_by_name }}{% endif %}</p>
              {% if applicationCounts %}
                {% set ac = applicationCounts[j.id] %}
                <a href="/portal/applications?tab=all&job={{ j.id }}" class="relative z-10 mt-1 inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:underline">{{ icon('document', 'size-3.5') }} {{ ac.total if ac else 0 }} {{ 'application' if ac and ac.total == 1 else 'applications' }}{% if ac and ac.fresh %} <span class="rounded-full bg-accent-600 px-1.5 text-xs text-white">{{ ac.fresh }} new</span>{% endif %}</a>
              {% endif %}
            </div>
          </div>
          <span class="pointer-events-none absolute inset-0 ring-accent-500 ring-inset group-has-[a:focus-visible]:ring-3" aria-hidden="true"></span>
        </li>
      {% endfor %}
    </ul>
    {{ ui.pager(pager, 'jobs') }}
  {% else %}
    <div class="rounded-3xl border-2 border-dashed border-line p-10 text-center">
      <span class="icon-tile mx-auto">{{ icon('briefcase', 'size-6') }}</span>
      <p class="mt-4 text-lg font-semibold text-ink">{% if q %}No jobs match “{{ q }}”{% elif tab == 'published' %}No jobs on the careers page{% elif tab == 'draft' %}No drafts{% elif tab == 'archived' %}Nothing archived{% else %}No jobs yet{% endif %}</p>
      <p class="mt-1 text-muted">{% if tab == 'published' and not q %}The careers page tells visitors there are no openings right now.{% else %}Try another tab or search.{% endif %}</p>
      {% if can('jobs.edit') and not q %}<a href="/portal/jobs/new" class="btn-primary mt-5">{{ icon('plus', 'size-4') }} New job</a>{% endif %}
    </div>
  {% endif %}
  </div>
{% endblock %}
