{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}
{% import "partials/portal-badges.njk" as badges %}

{% block content %}
  <nav aria-label="Inbox lists" class="mb-5 flex gap-1 overflow-x-auto rounded-2xl border border-line bg-white p-1.5 shadow-soft">
    {% for t in tabs %}
      <a href="/portal/messages?tab={{ t.key }}" {% if t.key == tab %}aria-current="page"{% endif %}
         class="flex shrink-0 items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition {{ 'bg-brand-700 text-white' if t.key == tab else 'text-muted hover:bg-surface hover:text-ink' }}">
        {{ t.label }}
        <span class="rounded-full px-2 py-0.5 text-xs {{ 'bg-white text-brand-800' if t.key == tab else ('bg-accent-600 text-white' if t.key == 'new' and counts[t.key] else 'bg-surface ring-1 ring-line') }}">{{ counts[t.key] }}</span>
      </a>
    {% endfor %}
  </nav>

  <form method="get" action="/portal/messages" role="search" aria-label="Filter messages" class="mb-5 grid gap-3 rounded-3xl border border-line bg-white p-4 shadow-soft sm:grid-cols-2 xl:grid-cols-[2fr_1fr_1fr_auto_auto] xl:items-center">
    <input type="hidden" name="tab" value="{{ tab }}">
    <div class="relative sm:col-span-2 xl:col-span-1">
      <label for="f-q" class="sr-only">Search by name, email, phone or text</label>
      <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-muted">{{ icon('search', 'size-5') }}</span>
      <input id="f-q" type="search" name="q" value="{{ filters.q }}" placeholder="Name, email, phone or text" class="form-control !pl-12" maxlength="100">
    </div>
    <div>
      <label for="f-type" class="sr-only">Type</label>
      <select id="f-type" name="type" class="form-control">
        <option value="">Messages and referrals</option>
        {% for key, label in typeLabels %}<option value="{{ key }}" {% if filters.type == key %}selected{% endif %}>{{ label }}s only</option>{% endfor %}
      </select>
    </div>
    {% if not intakeOnly %}
      <div>
        <label for="f-recipient" class="sr-only">Sent to</label>
        <select id="f-recipient" name="recipient" class="form-control">
          <option value="">Sent to anyone</option>
          {% for key, label in recipientLabels %}<option value="{{ key }}" {% if filters.recipient == key %}selected{% endif %}>{{ label }}</option>{% endfor %}
        </select>
      </div>
    {% endif %}
    <label class="flex items-center gap-2 text-sm font-medium text-ink">
      <input type="checkbox" name="mine" value="1" class="size-4 accent-brand-700" {% if filters.mine %}checked{% endif %}> Assigned to me
    </label>
    <button type="submit" class="btn-green">Filter</button>
  </form>

  {% if items.length %}
    <ul class="divide-y divide-line overflow-hidden rounded-3xl border border-line bg-white shadow-soft">
      {% for m in items %}
        <li class="group relative transition-colors hover:bg-surface focus-within:bg-surface {{ 'bg-amber-50/40' if m.status == 'new' and not m.archived_at }}">
          <div class="flex gap-4 px-5 py-4 sm:px-6">
            <span class="hidden size-11 shrink-0 place-items-center rounded-2xl sm:grid {{ 'bg-accent-50 text-accent-600 ring-1 ring-accent-100' if m.type == 'referral' else 'bg-brand-50 text-brand-700 ring-1 ring-brand-100' }}">{{ icon('document' if m.type == 'referral' else 'mail', 'size-5') }}</span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <p class="flex min-w-0 flex-wrap items-center gap-2">
                  <a href="/portal/messages/{{ m.id }}" class="font-semibold text-ink after:absolute after:inset-0 after:content-[''] group-hover:text-brand-700 focus-visible:outline-none {{ 'font-bold' if m.status == 'new' }}">{{ m.name }}</a>
                  {% if m.type == 'referral' %}<span class="rounded-full bg-accent-50 px-2 py-0.5 text-xs font-semibold text-accent-700 ring-1 ring-accent-200">Referral</span>{% endif %}
                  {{ badges.status(m.status, statusLabels[m.status]) }}
                  {% if m.email_status == 'failed' %}<span class="inline-flex items-center gap-1 text-xs font-semibold text-accent-700">{{ icon('exclamation', 'size-3.5') }} Email not delivered</span>{% endif %}
                </p>
                <span class="shrink-0 text-sm text-muted">{{ m.created_at | date({ month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) }}</span>
              </div>
              <p class="mt-1 line-clamp-1 text-sm text-ink/80">
                {% if m.type == 'referral' and m.details %}For <strong class="font-semibold">{{ m.details.person_name }}</strong> · {{ m.details.county }} · {% endif %}{{ m.message }}
              </p>
              <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
                <span>To {{ recipientLabels[m.recipient] or m.recipient }}</span>
                {% if m.assigned_name %}<span class="inline-flex items-center gap-1">{{ icon('users', 'size-3.5') }} {{ m.assigned_name }}</span>{% endif %}
              </p>
            </div>
          </div>
          <span class="pointer-events-none absolute inset-0 ring-accent-500 ring-inset group-has-[a:focus-visible]:ring-3" aria-hidden="true"></span>
        </li>
      {% endfor %}
    </ul>
    {% if pages > 1 %}
      <nav aria-label="Message pages" class="mt-6 flex items-center justify-between">
        {% if prevUrl %}<a href="{{ prevUrl }}" rel="prev" class="btn-secondary !py-2">&larr; Previous</a>{% else %}<span></span>{% endif %}
        <span class="text-sm text-muted">Page {{ page }} of {{ pages }} · {{ total }} total</span>
        {% if nextUrl %}<a href="{{ nextUrl }}" rel="next" class="btn-secondary !py-2">Next &rarr;</a>{% else %}<span></span>{% endif %}
      </nav>
    {% endif %}
  {% else %}
    <div class="rounded-3xl border-2 border-dashed border-line p-10 text-center">
      <span class="icon-tile mx-auto">{{ icon('inbox', 'size-6') }}</span>
      <p class="mt-4 text-lg font-semibold text-ink">{% if filters.q or filters.type or filters.recipient or filters.mine %}Nothing matches those filters{% elif tab == 'new' %}You’re all caught up{% else %}Nothing here{% endif %}</p>
      <p class="mt-1 text-muted">{% if tab == 'new' %}New messages and referrals from the website appear here.{% else %}Try another tab or filter.{% endif %}</p>
    </div>
  {% endif %}
{% endblock %}
