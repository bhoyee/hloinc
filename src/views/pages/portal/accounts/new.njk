{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  <section class="max-w-2xl rounded-3xl border border-line bg-white p-6 shadow-soft sm:p-8">
    <p class="mb-6 flex gap-3 rounded-2xl bg-surface p-4 text-[15px] text-muted ring-1 ring-line">
      {{ icon('mail', 'mt-0.5 size-5 shrink-0 text-brand-700') }}
      <span>We’ll email the person a link to choose their own password. You never need to know or share it.</span>
    </p>
    <form method="post" action="/portal/accounts" class="space-y-5" novalidate data-once>
      {{ ui.errorSummary(errors) }}
      <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
      <div class="grid gap-5 sm:grid-cols-2">
        {{ ui.input('name', 'Full name', values, errors, autocomplete='off') }}
        {{ ui.input('email', 'Work email', values, errors, type='email', autocomplete='off') }}
      </div>
      {{ ui.input('phone', 'Phone', values, errors, type='tel', required=false, autocomplete='off') }}
      {% include "partials/portal-role-select.njk" %}
      <div class="flex flex-wrap gap-3 pt-2">
        <button type="submit" class="btn-primary">{{ icon('mail', 'size-4') }} Create and send invitation</button>
        <a href="/portal/accounts" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </section>
{% endblock %}
