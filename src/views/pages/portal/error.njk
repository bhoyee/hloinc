{% extends "layouts/portal.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  <section class="max-w-2xl rounded-3xl border border-line bg-white p-8 shadow-soft">
    <span class="icon-tile-red">{{ icon('lock' if status == 403 else 'exclamation', 'size-6') }}</span>
    <p class="mt-5 text-sm font-semibold text-accent-600">Error {{ status }}</p>
    <p class="mt-1 text-lg text-ink">{{ message }}</p>
    {% if errorRef %}<p class="mt-3 text-sm text-muted">Reference <span class="font-mono font-semibold text-ink">{{ errorRef }}</span></p>{% endif %}
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/portal" class="btn-green">Back to the dashboard</a>
      {% if status >= 500 %}
        <a href="/portal/help/new?category=broken&error={{ errorRef }}&from={{ from | urlencode }}" class="btn-secondary">{{ icon('question', 'size-4') }} Report this problem</a>
      {% elif status == 403 %}
        <a href="/portal/help/new?category=access&from={{ from | urlencode }}" class="btn-secondary">{{ icon('question', 'size-4') }} Ask for access</a>
      {% endif %}
    </div>
    {% if stack %}<pre class="mt-8 overflow-x-auto rounded-xl bg-ink p-4 text-xs text-white">{{ stack }}</pre>{% endif %}
  </section>
{% endblock %}
