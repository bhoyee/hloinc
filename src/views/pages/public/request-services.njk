{% extends "layouts/public.njk" %}
{% import "partials/ds.njk" as ds %}
{% import "partials/ds-fields.njk" as f %}
{% import "partials/ui.njk" as ui %}

{% block mainClass %}ds{% endblock %}

{% block content %}
  {{ ds.pageHead('Ask about services', cms.text('request-services.head.title', 'Ask about services'), cms.text('request-services.head.intro', 'We would love to help as much as we can. Reach out and set a day for a consultation with one of our representatives. We can address your questions and concerns before you decide on our services.')) }}

  <section><div class="d-wrap d-form-layout">
    {% if flash and flash.type == 'success' %}
      <div class="d-card">{{ f.success(flash, '/request-services') }}</div>
    {% else %}
    <form id="request-form" class="d-card" method="post" action="/request-services#request-form" novalidate data-wizard data-once>
      <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
      {{ ui.honeypot() }}
      {{ f.progress(['About you', 'About them', 'Review']) }}
      {% include "partials/ds-form-status.njk" %}

      <fieldset class="d-step" data-step="1"><legend>{{ cms.text('request-services.step1', 'About you') }}</legend>
        <div class="d-row">{{ f.text('rq-first_name', 'first_name', 'First name', values, errors, true, 'text', 'given-name', 60) }}{{ f.text('rq-last_name', 'last_name', 'Last name', values, errors, true, 'text', 'family-name', 60) }}</div>
        <div class="d-row">{{ f.text('rq-phone', 'phone', 'Phone', values, errors, true, 'tel', 'tel', 30) }}{{ f.text('rq-email', 'email', 'Email', values, errors, true, 'email', 'email', 191) }}</div>
        <div class="d-field" role="group" aria-labelledby="grp-contact"><span class="d-lbl" id="grp-contact">How do you prefer to be contacted?</span>
          <div class="d-choice">
            <label><input type="radio" name="preferred_contact" value="phone"{% if values.preferred_contact != 'email' %} checked{% endif %}> Phone</label>
            <label><input type="radio" name="preferred_contact" value="email"{% if values.preferred_contact == 'email' %} checked{% endif %}> Email</label>
          </div>{{ ds.err('preferred_contact', errors) }}</div>
        {# Shown only for a call (public/js/ds.js). #}
        <div data-call-only>{{ f.select('rq-best_time', 'best_time', 'Best time to call', values, errors, options.bestTime, true) }}</div>
      </fieldset>

      <fieldset class="d-step" data-step="2"><legend>{{ cms.text('request-services.step2', 'About the individual who needs support') }}</legend>
        {{ f.select('rq-relationship', 'relationship', 'Your relationship to the individual', values, errors, options.relationship, true) }}
        <div class="d-row">{{ f.text('rq-individual_first_name', 'individual_first_name', 'Their first name', values, errors, false, 'text', '', 60) }}{{ f.select('rq-county', 'county', 'County where support is needed', values, errors, counties) }}</div>
        <div class="d-row">
          {{ f.select('rq-dda_eligibility', 'dda_eligibility', 'DDA eligibility', values, errors, options.ddaEligibility, false, 'DDA is the Maryland agency that decides who qualifies for funded services. “Not sure” is fine.') }}
          {{ f.select('rq-pcp', 'pcp', 'Person-Centered Plan (PCP)', values, errors, options.pcp, false, 'A plan the person and their team write about their goals. “Not started yet” is okay.') }}
        </div>
        {{ f.select('rq-priority_category', 'priority_category', 'DDA funding priority category, if known', values, errors, options.priority, false, 'If your coordinator mentioned Crisis Resolution or Crisis Prevention, choose that. Otherwise “Not sure” is fine.') }}
        {{ f.services('grp-services', 'Services of interest', values, errors, services) }}
        <div class="d-field"><label for="rq-message">Anything else we should know?</label><textarea id="rq-message" name="message" maxlength="1500"{{ f.invalid('message', errors) }}>{{ values.message }}</textarea><div class="d-hint">Optional. A sentence or two is plenty.</div>{{ ds.err('message', errors) }}</div>
      </fieldset>

      <fieldset class="d-step" data-step="3"><legend>Review and send</legend>
        <div class="d-review-wrap"><p class="d-hint d-review-hint">Please check the details below.</p><dl class="d-review"></dl></div>
        <div class="d-field"><label class="d-check-row"><input type="checkbox" name="consent" value="yes" required{% if values.consent == 'yes' %} checked{% endif %}{{ f.invalid('consent', errors) }}> <span>{{ cms.text('request-services.consent', 'I confirm the information above is correct and I agree to be contacted about services.') }}</span></label>{{ ds.err('consent', errors) }}</div>
        {{ ui.captcha(turnstileSiteKey, errors) }}
      </fieldset>

      {{ f.actions(cms.text('request-services.submit', 'Send request')) }}
      <p class="d-form-note">Fields marked <span class="d-req">*</span> are required.</p>
    </form>
    {% endif %}

    {% set doc = 'request-services' %}
    {% include "partials/ds-form-aside.njk" %}
  </div></section>
{% endblock %}
