{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}
{% import "partials/sections.njk" as shared %}

{% block content %}
  {% for sec in cms.sections('services', { hero: 'Top banner', approach: 'Our approach', homes: 'Apartment homes', planning: 'How support is planned', approved: 'Approved services', support: 'Who we support', help: 'Help choosing', cta: 'Call to action' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'hero' %}
    {% call ui.pageHero(cms.text('services.hero.eyebrow', 'What we do'), cms.text('services.hero.title', 'Our services'), cms.text('services.hero.intro', page.pledge), [{ label: 'Services' }]) %}
      <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-2">
        {% for l in [
          { href: '#approach', label: cms.text('services.nav.approach', 'Our approach') },
          { href: '#homes', label: cms.text('services.nav.homes', 'Apartment homes') },
          { href: '#planning', label: cms.text('services.nav.planning', 'How support is planned') },
          { href: '#approved', label: cms.text('services.nav.approved', 'Approved services') },
          { href: '#who-we-support', label: cms.text('services.nav.support', 'Who we support') }
        ] %}
          <a href="{{ l.href }}" class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-brand-800 ring-1 ring-line hover:bg-brand-50">{{ l.label }}</a>
        {% endfor %}
      </nav>
    {% endcall %}

  {% elif sec.key == 'approach' %}
    {% set startCta1 = cms.link('services.approach.cta1', 'Request services', '/request-services') %}
    {% set startCta2 = cms.link('services.approach.cta2', 'Make a referral', '/referrals') %}
    <section id="approach" class="section scroll-mt-24">
      <div class="container-page grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start lg:gap-16">
        <div>
          <h2 class="text-3xl font-extrabold sm:text-4xl">{{ cms.text('services.approach.title', page.approachTitle) }}</h2>
          <div class="prose-hlo mt-5 text-lg">{{ cms.rich('services.approach.text', page.approach) }}</div>
        </div>
        <div class="rounded-3xl bg-accent-700 p-7 text-white shadow-lift sm:p-8">
          <h3 class="text-2xl font-bold text-white">{{ cms.text('services.approach.readyTitle', 'Ready to start?') }}</h3>
          <p class="mt-2 text-accent-50">{{ cms.text('services.approach.readyText', 'Request services for yourself or a loved one, or send a referral if you are a coordinator or agency.') }}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="{{ startCta1.href }}" {{ startCta1.attrs }} class="btn-light !text-accent-800">{{ startCta1.label }}</a>
            <a href="{{ startCta2.href }}" {{ startCta2.attrs }} class="btn-ghost-light">{{ startCta2.label }}</a>
          </div>
        </div>
      </div>
    </section>

  {% elif sec.key == 'homes' %}
    {{ shared.homes(true) }}

  {% elif sec.key == 'planning' %}
    {{ shared.planning(true) }}

  {% elif sec.key == 'approved' %}
    {{ shared.services(services, conditions, false) }}

  {% elif sec.key == 'support' %}
    {% set supportContact = cms.link('services.support.cta', 'contact us', '/contact') %}
    <section id="who-we-support" class="section scroll-mt-24 bg-cream">
      <div class="container-page">
        <div class="max-w-2xl">
          <p class="eyebrow">{{ cms.text('services.support.eyebrow', 'Who we support') }}</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{{ cms.text('services.support.title', 'Adults with any of the following conditions') }}</h2>
          <p class="mt-4 text-lg text-muted">{{ cms.text('services.support.intro', 'We also accept under our care adults with any of the following conditions.') }}</p>
        </div>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {% for need in cms.list('services.support.needs', cms.objects(supportNeeds)) %}
            {% set red = loop.index is odd %}
            <li class="group flex items-center gap-3 rounded-2xl border border-line bg-white px-4 py-3.5 text-ink transition duration-200 hover:-translate-y-0.5 hover:shadow-soft {{ 'hover:border-accent-200' if red else 'hover:border-brand-300' }}" {{ need.attrs }}>
              <span class="grid size-8 shrink-0 place-items-center rounded-full transition duration-200 {{ 'bg-accent-50 text-accent-600 group-hover:bg-accent-600' if red else 'bg-brand-50 text-brand-700 group-hover:bg-brand-700' }} group-hover:text-white">{{ icon('check', 'size-4') }}</span>
              <span class="font-medium">{{ need.text('label') }}</span>
            </li>
          {% endfor %}
        </ul>
        <p class="mt-8 text-[15px] text-muted">{{ cms.text('services.support.outro', 'For more information about our services and how we can help your loved ones, do not hesitate to') }} <a href="{{ supportContact.href }}" {{ supportContact.attrs }} class="link">{{ supportContact.label }}</a>.</p>
        <p class="mt-4 flex gap-3 rounded-2xl border border-brand-200 bg-brand-50 p-4 text-[15px] text-brand-900">
          {{ icon('info', 'mt-0.5 size-5 shrink-0') }} <span>{{ cms.text('services.support.note', eligibilityNote) }}</span>
        </p>
      </div>
    </section>

  {% elif sec.key == 'help' %}
    {% set compareCard = cms.link('services.help.compare', 'View comparison', '/getting-started#compare') %}
    {% set talkCard = cms.link('services.help.talk', 'Send a message', '/contact?to=intake') %}
    <section id="help-choosing" class="section bg-cream">
      <div class="container-page">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-14">
          <div class="reveal">
            <p class="eyebrow">{{ cms.text('services.help.eyebrow', 'Help choosing') }}</p>
            <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">{{ cms.text('services.help.title', 'Not sure which service fits?') }}</h2>
            <p class="mt-4 text-lg text-muted">{{ cms.text('services.help.intro', 'That’s completely normal. Many people use more than one service, and your Coordinator of Community Services and our intake team can help you decide. Here’s a quick guide to start:') }}</p>

            <ul class="mt-8 space-y-3">
              {% for g in cms.list('services.help.guide', [
                { need: 'I live with family and want help with daily life', slug: 'personal-supports' },
                { need: 'I’d like a home of my own, with support', slug: 'supported-living' },
                { need: 'I’d like to live in a shared home with staff on hand', slug: 'community-residential-services' },
                { need: 'Our family caregiver needs a break', slug: 'respite-care' },
                { need: 'I want to get out, try new things and make friends', slug: 'community-development-services' },
                { need: 'I want help finding or keeping a job', slug: 'employment-services' }
              ]) %}
                {% set svc = serviceBySlug[g.slug] or services[0] %}
                <li {{ g.attrs }}>
                  <a href="/services/{{ svc.slug }}" class="group flex items-center gap-4 rounded-2xl border border-line bg-white p-4 transition duration-200 hover:border-brand-300 hover:shadow-soft sm:p-5">
                    <span class="grid size-10 shrink-0 place-items-center rounded-full {{ 'bg-accent-50 text-accent-600' if loop.index is odd else 'bg-brand-50 text-brand-700' }}">{{ icon(svc.icon, 'size-5') }}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-[15px] text-muted">“{{ g.text('need') }}”</span>
                      <span class="mt-0.5 block font-display font-bold text-ink group-hover:text-brand-700">{{ cms.text('services.help.maySuit', 'May suit:') }} {{ svc.name }}</span>
                    </span>
                    {{ icon('arrow-right', 'size-5 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-accent-600') }}
                  </a>
                </li>
              {% endfor %}
            </ul>
            <p class="mt-5 text-sm text-muted">{{ cms.text('services.help.note', 'This guide is a starting point only. The services each person receives depend on their eligibility and person-centered plan.') }}</p>
          </div>

          <div class="reveal flex flex-col gap-5 lg:pt-14">
            <a href="{{ compareCard.href }}" {{ compareCard.attrs }} class="group relative overflow-hidden rounded-3xl bg-brand-800 p-7 text-white shadow-lift transition duration-300 hover:-translate-y-1 hover:bg-brand-900 sm:p-9">
              <span class="pointer-events-none absolute -right-8 -bottom-10 text-white/10 transition duration-500 group-hover:scale-110" aria-hidden="true">{{ icon('document', 'size-48') }}</span>
              <span class="relative grid size-12 place-items-center rounded-2xl bg-white/15 ring-1 ring-white/25">{{ icon('document', 'size-6') }}</span>
              <span class="relative mt-6 block font-display text-2xl font-bold">{{ cms.text('services.help.compareTitle', 'Compare services side by side') }}</span>
              <span class="relative mt-2 block text-brand-100">{{ cms.text('services.help.compareText', 'See where each service happens and who it may suit, all in one table.') }}</span>
              <span class="relative mt-6 inline-flex items-center gap-2 font-semibold">{{ compareCard.label }} {{ icon('arrow-right', 'size-5 transition group-hover:translate-x-1') }}</span>
            </a>

            <a href="{{ talkCard.href }}" {{ talkCard.attrs }} class="group relative overflow-hidden rounded-3xl bg-accent-700 p-7 text-white shadow-lift transition duration-300 hover:-translate-y-1 hover:bg-accent-800 sm:p-9">
              <span class="pointer-events-none absolute -right-8 -bottom-10 text-white/10 transition duration-500 group-hover:scale-110" aria-hidden="true">{{ icon('chat', 'size-48') }}</span>
              <span class="relative grid size-12 place-items-center rounded-2xl bg-white/15 ring-1 ring-white/25">{{ icon('chat', 'size-6') }}</span>
              <span class="relative mt-6 block font-display text-2xl font-bold">{{ cms.text('services.help.talkTitle', 'Talk to our intake team') }}</span>
              <span class="relative mt-2 block text-accent-50">{{ cms.text('services.help.talkText', 'Tell us a little about what you’re looking for and we’ll help you find the right fit.') }}</span>
              <span class="relative mt-6 inline-flex items-center gap-2 font-semibold">{{ talkCard.label }} {{ icon('arrow-right', 'size-5 transition group-hover:translate-x-1') }}</span>
            </a>

            <div class="flex items-center gap-4 rounded-3xl border border-line bg-white p-5 sm:p-6">
              <span class="icon-tile">{{ icon('phone', 'size-6') }}</span>
              <p class="text-[15px] text-muted">{{ cms.text('services.help.callPrompt', 'Prefer to talk? Call') }} <a href="{{ site.phone | telHref }}" class="font-semibold text-ink hover:text-brand-700">{{ site.phone }}</a><br>{{ site.hours }}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  {% elif sec.key == 'cta' %}
    {{ ui.ctaBand(site) }}
  {% endif %}
  </div>
  {% endfor %}
  {# No CTA band here: the help section above already offers intake and contact. #}
{% endblock %}
