{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {{ ui.pageHero('Resources', 'Helpful organizations and planning resources', 'Information from independent organizations for people with disabilities, families and caregivers.', [{ label: 'Resources' }]) }}

  <section class="section">
    <div class="container-page">
      <p class="mb-12 flex gap-3 rounded-2xl border border-line bg-surface p-5 text-[15px] text-muted">
        {{ icon('info', 'mt-0.5 size-5 shrink-0 text-brand-700') }}
        <span>These organizations are independent of HLO. They are listed for information only and are not HLO services. Links open the organization’s own website.</span>
      </p>

      {% for group in resources %}
        <h2 class="{{ 'mt-16' if not loop.first }} text-2xl font-bold">{{ group.group }}</h2>
        <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {% for r in group.items %}
            <li>
              <a href="{{ r.url }}" rel="noopener noreferrer" target="_blank" class="card card-hover group flex h-full flex-col !p-6">
                <span class="flex items-start justify-between gap-4">
                  <span class="font-display text-lg leading-snug font-bold text-ink">{{ r.name }}</span>
                  {{ icon('external', 'size-5 shrink-0 text-brand-600') }}
                </span>
                <span class="mt-2 flex-1 text-[15px] text-muted">{{ r.description }}</span>
                <span class="mt-4 text-sm font-medium text-brand-700 group-hover:underline">{{ r.url | replace('https://', '') | replace('www.', '') }}<span class="sr-only"> (opens in a new tab)</span></span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </div>
  </section>

  {{ ui.ctaBand(site) }}
{% endblock %}
