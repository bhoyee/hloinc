{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% set fullAddress = site.address.street + ', ' + site.address.city + ', ' + site.address.state + ' ' + site.address.zip %}

{% block content %}
  {{ ui.pageHero('Contact', 'We’re here to help', 'Call, email, visit our office or send a message, and we will get back to you as soon as we can.', [{ label: 'Contact' }], 'contact', 'Three colleagues having a friendly conversation') }}

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        {{ ui.flash(flash) }}
        <div class="card">
          <h2 class="text-2xl font-bold">Send us a message</h2>
          <p class="mt-2 text-[15px] text-muted">Fields marked as optional can be left blank. Please don’t include diagnoses or medication details.</p>

          <form method="post" action="/contact" class="relative mt-8 space-y-6" novalidate data-once>
            {{ ui.errorSummary(errors) }}
            <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
            {{ ui.honeypot() }}

            <div>
              <label for="f-recipient" class="form-label">Who would you like to contact?</label>
              <select id="f-recipient" name="recipient" class="form-control" required aria-required="true"
                {% if errors.recipient %}aria-invalid="true" aria-describedby="f-recipient-error"{% endif %}>
                {% for r in recipients %}
                  <option value="{{ r.key }}" {% if values.recipient == r.key %}selected{% endif %}>{{ r.label }}</option>
                {% endfor %}
              </select>
              {{ ui.fieldError('recipient', errors) }}
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              {{ ui.input('name', 'Your name', values, errors, autocomplete='name') }}
              {{ ui.input('phone', 'Phone', values, errors, type='tel', required=false, autocomplete='tel') }}
            </div>
            {{ ui.input('email', 'Email address', values, errors, type='email', autocomplete='email') }}
            {{ ui.textarea('message', 'Your message', values, errors, rows=6) }}

            <button type="submit" class="btn-primary">Send message {{ icon('arrow-right', 'size-4') }}</button>
          </form>
        </div>
      </div>

      <aside class="space-y-5">
        <div class="card !p-6">
          <h2 class="text-lg font-bold">Call or email</h2>
          <ul class="mt-4 space-y-4">
            <li><a href="{{ site.phone | telHref }}" class="flex items-center gap-4 font-semibold text-ink hover:text-brand-700"><span class="icon-tile size-11">{{ icon('phone', 'size-5') }}</span>{{ site.phone }}</a></li>
            <li><a href="mailto:{{ site.email }}" class="flex items-center gap-4 font-semibold text-ink hover:text-brand-700"><span class="icon-tile size-11">{{ icon('mail', 'size-5') }}</span>{{ site.email }}</a></li>
          </ul>
        </div>

        <div id="visit" class="card !p-6">
          <h2 class="text-lg font-bold">Visit our office</h2>
          <address class="mt-4 flex gap-3 not-italic text-ink">
            {{ icon('map-pin', 'mt-0.5 size-5 shrink-0 text-brand-600') }}
            <span>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span>
          </address>
          <p class="mt-3 flex gap-3 text-ink">{{ icon('clock', 'mt-0.5 size-5 shrink-0 text-brand-600') }} {{ site.hours }}</p>
          <p class="mt-4 rounded-2xl bg-surface p-4 text-[15px] text-muted ring-1 ring-line">{{ site.walkIn }}</p>
          <a href="https://www.google.com/maps/dir/?api=1&amp;destination={{ fullAddress | urlencode }}" target="_blank" rel="noopener noreferrer" class="btn-secondary mt-5 w-full">
            {{ icon('map-pin', 'size-4') }} Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
          </a>
        </div>

        <a href="/appointments/request" class="card card-hover group flex items-center gap-4 !p-6">
          <span class="icon-tile">{{ icon('calendar', 'size-6') }}</span>
          <span class="flex-1">
            <span class="block font-bold text-ink">Request an appointment</span>
            <span class="block text-[15px] text-muted">Book a time in advance</span>
          </span>
          {{ icon('arrow-right', 'size-5 text-brand-600 transition group-hover:translate-x-1') }}
        </a>
      </aside>
    </div>
  </section>
{% endblock %}
