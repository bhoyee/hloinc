{% extends "layouts/public.njk" %}
{% import "partials/ds.njk" as ds %}

{% block mainClass %}ds{% endblock %}

{#
  Privacy policy, Accessibility, Nondiscrimination and language help (and the hidden Terms,
  Data Protection and Cookie Policy), in HLO's design, version 41. Each section is an
  editable item; `doc.cmsKey` starts a page's keys afresh when its wording is replaced.
#}
{% block content %}
  {% set k = doc.cmsKey or doc.slug %}
  {% set items = cms.list(k + '.sections', sections) %}
  {{ ds.pageHead(doc.title, cms.text(k + '.title', doc.title), cms.text(k + '.summary', doc.summary)) }}

  <section><div class="d-wrap"><div class="d-legal">
    <p class="d-updated">{{ cms.text(k + '.updatedLabel', doc.updatedLabel or 'Last updated:') }} {{ cms.text(k + '.lastUpdated', doc.lastUpdated | date) }}</p>
    {% for s in items %}
      {% if not s.onlyIf or features[s.onlyIf] or cms.isEditing() %}
        <div id="{{ s.id or ('section-' + loop.index) }}" class="d-legal-sec{{ ' d-faded' if s.onlyIf and not features[s.onlyIf] }}" {{ s.attrs }}>
          {% if s.onlyIf and not features[s.onlyIf] %}<p class="d-fine-print">Shown only when the {{ s.onlyIf }} feature is switched on</p>{% endif %}
          <h2>{{ s.text('heading') }}</h2>
          {{ s.rich('body') }}
          {% set table = tables[s.id] %}
          {% if table %}
            {# Focusable so keyboard users can scroll the table on narrow screens. #}
            <div class="d-legal-table" tabindex="0" role="region" aria-label="{{ table.caption }}">
              <table>
                <caption class="d-sr-only">{{ table.caption }}</caption>
                <thead><tr>{% for h in table.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
                <tbody>
                  {% for row in table.rows %}
                    <tr>{% for cell in row %}{% if loop.first %}<th scope="row"><code>{{ cell }}</code></th>{% else %}<td>{{ cell }}</td>{% endif %}{% endfor %}</tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    <h2 id="contact-us">{{ cms.text('site.legal.contactTitle', 'Contact us') }}</h2>
    <address>{{ site.legalName }}<br>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}<br>
      Phone: <a href="{{ site.phone | telHref }}">{{ site.phone }}</a><br>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.hours }}</address>

    {% set others = [] %}
    {% for l in legalLinks %}{% if l.slug != doc.slug %}{% set _ = others.push(l) %}{% endif %}{% endfor %}
    {% if others.length %}
      <p class="d-fine-print">{{ cms.text('site.legal.seeAlso', 'See also:') }}
        {% for l in others %}<a href="/{{ l.slug }}">{{ l.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {% endif %}
  </div></div></section>
{% endblock %}
