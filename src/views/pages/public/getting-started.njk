{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% for sec in cms.sections('getting-started', { hero: 'Top banner', steps: 'How it works', compare: 'Compare services', referrals: 'Referrals', resources: 'Resources note', cta: 'Call to action' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'hero' %}
    {% set gsCta1 = cms.link('getting-started.hero.cta1', 'Request an intake appointment', '/appointments/request') %}
    {% set gsCta2 = cms.link('getting-started.hero.cta2', 'Send a referral', '/referrals') %}
    {% call ui.pageHero(cms.text('getting-started.hero.eyebrow', 'Intake'), cms.text('getting-started.hero.title', page.title), cms.text('getting-started.hero.intro', page.intro), [{ label: 'Getting started' }], cms.image('getting-started.hero.image', 'getting-started', 'A support worker warmly greeting a woman with a handshake')) %}
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="{{ gsCta1.href }}" {{ gsCta1.attrs }} class="btn-primary">{{ icon('calendar', 'size-4') }} {{ gsCta1.label }}</a>
        <a href="{{ gsCta2.href }}" {{ gsCta2.attrs }} class="btn-green">{{ icon('document', 'size-4') }} {{ gsCta2.label }}</a>
      </div>
      <p class="mt-5 text-[15px] text-muted">{{ cms.text('getting-started.hero.callPrompt', 'Prefer to talk? Call') }} <a href="{{ site.phone | telHref }}" class="font-semibold text-ink hover:text-brand-700">{{ site.phone }}</a></p>
    {% endcall %}

  {% elif sec.key == 'steps' %}
  {# Steps — a timeline: horizontal on large screens, vertical on phones. #}
  <section class="section">
    <div class="container-page">
      {{ ui.sectionHeading(cms.text('getting-started.steps.eyebrow', 'How it works'), cms.text('getting-started.steps.title', 'Three simple steps'), cms.text('getting-started.steps.intro', 'We keep the first conversation easy. You do not need to have every answer ready.'), true) }}
      <ol class="relative mt-14 grid gap-6 lg:grid-cols-3">
        <span class="absolute top-7 bottom-7 left-7 w-0.5 -translate-x-1/2 bg-gradient-to-b from-accent-200 via-brand-200 to-brand-300 lg:hidden" aria-hidden="true"></span>
        <span class="absolute top-7 right-[16.67%] left-[16.67%] hidden border-t-2 border-dashed border-brand-200 lg:block" aria-hidden="true"></span>

        {% for step in cms.list('getting-started.steps.items', page.steps) %}
          {% set red = loop.index is odd %}
          <li class="reveal group relative flex gap-5 lg:flex-col lg:gap-6" {{ step.attrs }}>
            <span class="relative z-10 grid size-14 shrink-0 place-items-center rounded-full border-2 bg-white font-display text-xl font-extrabold ring-8 ring-white transition duration-300 group-hover:scale-110 group-hover:text-white lg:self-center {{ 'border-accent-600 text-accent-600 group-hover:bg-accent-600' if red else 'border-brand-700 text-brand-700 group-hover:bg-brand-700' }}">
              <span class="sr-only">Step </span>{{ loop.index }}
            </span>
            <div class="relative flex-1 overflow-hidden rounded-3xl border border-line bg-white p-6 shadow-soft transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-lift {{ 'group-hover:border-accent-200' if red else 'group-hover:border-brand-300' }}">
              <span class="absolute inset-x-0 top-0 h-1.5 origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100 {{ 'bg-accent-600' if red else 'bg-brand-600' }}" aria-hidden="true"></span>
              <div class="flex items-center justify-between gap-3">
                <span class="grid size-11 place-items-center rounded-2xl ring-1 transition duration-300 {{ 'bg-accent-50 text-accent-600 ring-accent-100 group-hover:bg-accent-600' if red else 'bg-brand-50 text-brand-700 ring-brand-100 group-hover:bg-brand-700' }} group-hover:text-white group-hover:ring-transparent">{{ icon(step.icon or 'check', 'size-5') }}</span>
                <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">{{ step.text('who') }}</span>
              </div>
              <h3 class="mt-5 text-lg leading-snug font-bold">{{ step.text('title') }}</h3>
              <p class="mt-2 text-[15px] text-muted">{{ step.text('text') }}</p>
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  {% elif sec.key == 'compare' %}
  {# Comparison — filter buttons are revealed by site.js; without JS every service shows. #}
  <section id="compare" class="section bg-cream" data-filter-scope>
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        {{ ui.sectionHeading(cms.text('getting-started.compare.eyebrow', 'Compare'), cms.text('getting-started.compare.title', 'Which service might fit?'), cms.text('getting-started.compare.intro', 'A quick side-by-side view. Your coordinator and our intake team can help you decide.')) }}
        <div class="lg:shrink-0 lg:text-right" data-filter-controls hidden>
          <p id="filter-label" class="text-sm font-semibold text-ink">{{ cms.text('getting-started.compare.filterLabel', 'Where would you like support?') }}</p>
          <div role="group" aria-labelledby="filter-label" class="mt-3 flex flex-wrap gap-2 lg:justify-end">
            <button type="button" data-filter="all" aria-pressed="true" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink transition hover:border-brand-300 aria-pressed:border-brand-700 aria-pressed:bg-brand-700 aria-pressed:text-white">All services</button>
            {% for key, label in whereLabels %}
              <button type="button" data-filter="{{ key }}" aria-pressed="false" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink transition hover:border-brand-300 aria-pressed:border-brand-700 aria-pressed:bg-brand-700 aria-pressed:text-white">{{ label }}</button>
            {% endfor %}
          </div>
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>

      {# Table: tablets and up #}
      <div class="reveal mt-10 hidden overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-line md:block">
        <table class="w-full text-left">
          <caption class="sr-only">Comparison of HLO services</caption>
          <thead class="bg-brand-900 text-sm tracking-wide text-brand-100 uppercase">
            <tr>
              <th scope="col" class="px-6 py-4 font-semibold">Service</th>
              <th scope="col" class="px-6 py-4 font-semibold">Where support happens</th>
              <th scope="col" class="px-6 py-4 font-semibold">May suit</th>
              <th scope="col" class="px-6 py-4"><span class="sr-only">Details</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {% for s in services %}
              {% set red = loop.index is odd %}
              <tr data-where="{{ s.where | join(' ') }}" class="group/row align-middle transition-colors hover:bg-surface">
                <th scope="row" class="relative px-6 py-5">
                  <span class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 transition-transform duration-300 group-hover/row:scale-y-100 {{ 'bg-accent-600' if red else 'bg-brand-600' }}" aria-hidden="true"></span>
                  <span class="flex items-center gap-4">
                    <img src="{{ cms.image('service-' + s.slug + '.image', s.photo).srcSm }}" alt="" width="64" height="64" loading="lazy" class="size-16 shrink-0 rounded-2xl object-cover transition duration-300 group-hover/row:scale-105">
                    <a href="/services/{{ s.slug }}" class="font-display text-lg font-bold text-ink hover:text-brand-700">{{ cms.text('service-' + s.slug + '.name', s.name) }}</a>
                  </span>
                </th>
                <td class="px-6 py-5">
                  <span class="flex flex-wrap gap-1.5">
                    {% for w in s.where %}
                      <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-semibold {{ 'bg-accent-50 text-accent-700' if red else 'bg-brand-50 text-brand-800' }}">{{ icon('map-pin', 'size-3.5') }} {{ whereLabels[w] }}</span>
                    {% endfor %}
                  </span>
                  <span class="mt-2 block text-[15px] text-ink">{{ cms.text('service-' + s.slug + '.setting', s.setting) }}</span>
                </td>
                <td class="max-w-sm px-6 py-5 text-[15px] text-muted">{{ cms.text('service-' + s.slug + '.suitedFor', s.suitedFor) }}</td>
                <td class="px-6 py-5 text-right">
                  <a href="/services/{{ s.slug }}" class="inline-grid size-10 place-items-center rounded-full transition duration-300 group-hover/row:translate-x-1 group-hover/row:text-white {{ 'bg-accent-50 text-accent-600 group-hover/row:bg-accent-600' if red else 'bg-brand-50 text-brand-700 group-hover/row:bg-brand-700' }}">
                    {{ icon('arrow-right', 'size-5') }}<span class="sr-only">Learn more about {{ s.name }}</span>
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {# Cards: phones #}
      <ul class="mt-8 space-y-4 md:hidden">
        {% for s in services %}
          {% set red = loop.index is odd %}
          <li data-where="{{ s.where | join(' ') }}" class="reveal">
            <a href="/services/{{ s.slug }}" class="block overflow-hidden rounded-3xl border border-line bg-white shadow-soft transition active:scale-[0.99]">
              <span class="flex items-center gap-4 p-5">
                <img src="{{ cms.image('service-' + s.slug + '.image', s.photo).srcSm }}" alt="" width="64" height="64" loading="lazy" class="size-16 shrink-0 rounded-2xl object-cover">
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-lg leading-snug font-bold text-ink">{{ s.name }}</span>
                  <span class="mt-1.5 flex flex-wrap gap-1.5">
                    {% for w in s.where %}
                      <span class="rounded-full px-2 py-0.5 text-xs font-semibold {{ 'bg-accent-50 text-accent-700' if red else 'bg-brand-50 text-brand-800' }}">{{ whereLabels[w] }}</span>
                    {% endfor %}
                  </span>
                </span>
                {{ icon('arrow-right', 'size-5 shrink-0 ' + ('text-accent-600' if red else 'text-brand-700')) }}
              </span>
              <span class="block border-t border-line bg-surface px-5 py-4 text-[15px]">
                <span class="block text-xs font-semibold tracking-wide text-muted uppercase">May suit</span>
                <span class="mt-1 block text-ink">{{ s.suitedFor }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>

      <p class="mt-8 text-center text-sm text-muted">{{ cms.text('getting-started.compare.note', 'A starting point only. The services each person receives depend on their eligibility and person-centered plan.') }}</p>
    </div>
  </section>

  {% elif sec.key == 'referrals' %}
  {% set refCta1 = cms.link('getting-started.referrals.cta1', 'Send a referral', '/referrals') %}
  {% set refCta2 = cms.link('getting-started.referrals.cta2', 'Message our intake team', '/contact?to=intake') %}
  {# Referrals — "Talk to us about intake" (requirements §6.2) #}
  <section id="referrals" class="section">
    <div class="container-page">
      <div class="reveal grid gap-10 overflow-hidden rounded-[2rem] bg-surface ring-1 ring-line lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <p class="eyebrow">{{ cms.text('getting-started.referrals.eyebrow', 'For coordinators, families and professionals') }}</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{{ cms.text('getting-started.referrals.title', page.referralTitle) }}</h2>
          <p class="mt-5 text-lg text-muted">{{ cms.text('getting-started.referrals.text', page.referralText) }}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="{{ refCta1.href }}" {{ refCta1.attrs }} class="btn-primary">{{ icon('document', 'size-4') }} {{ refCta1.label }}</a>
            <a href="{{ refCta2.href }}" {{ refCta2.attrs }} class="btn-secondary">{{ icon('mail', 'size-4') }} {{ refCta2.label }}</a>
          </div>
        </div>
        <div class="flex flex-col justify-center gap-4 bg-brand-900 p-8 text-brand-100 sm:p-12">
          <h3 class="text-xl font-bold text-white">{{ cms.text('getting-started.referrals.readyTitle', 'Helpful to have ready') }}</h3>
          <ul class="space-y-3">
            {% for item in cms.list('getting-started.referrals.ready', cms.objects(['Name and best contact details', 'County where the person lives', 'The service or support being considered', 'Coordinator of Community Services contact, if known'])) %}
              <li class="flex gap-3" {{ item.attrs }}>{{ icon('check', 'mt-1 size-4 shrink-0 text-brand-300') }} <span>{{ item.text('label') }}</span></li>
            {% endfor %}
          </ul>
          <p class="mt-2 flex gap-3 rounded-2xl bg-white/10 p-4 text-sm">{{ icon('shield', 'size-5 shrink-0') }} <span>{{ cms.text('getting-started.referrals.privacy', 'To protect privacy, please don’t send diagnoses or medication details through the website.') }}</span></p>
        </div>
      </div>
    </div>
  </section>

  {% elif sec.key == 'resources' %}
  {% set resLink = cms.link('getting-started.resources.link', 'resources page', '/resources') %}
  <section class="container-page pb-8">
    <p class="text-center text-[15px] text-muted">{{ cms.text('getting-started.resources.text', 'Looking for planning help from other organizations? See our') }} <a href="{{ resLink.href }}" {{ resLink.attrs }} class="link">{{ resLink.label }}</a>.</p>
  </section>

  {% elif sec.key == 'cta' %}
  {{ ui.ctaBand(site) }}
  {% endif %}
  </div>
  {% endfor %}
{% endblock %}
