{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}
{% import "partials/sections.njk" as shared %}

{% block content %}
  {{ ui.pageHero(cms.text('referrals.hero.eyebrow', 'For coordinators, agencies and families'), cms.text('referrals.hero.title', 'Send a referral'), cms.text('referrals.hero.intro', 'Take the time to send a referral. Know that this referral allows us to help more people who require our special assistance. The information you provide here will be kept strictly confidential.'), [{ label: 'Make a referral' }], cms.image('referrals.hero.image', 'approach', 'A support worker kneeling to talk with a woman using a wheelchair')) }}

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="min-w-0">
        {{ ui.flash(flash) }}
        <form method="post" action="/referrals" class="relative space-y-8" novalidate data-once>
          {{ ui.errorSummary(errors) }}
          <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
          {{ ui.honeypot() }}

          <fieldset class="card space-y-6">
            <legend class="float-left mb-2 flex w-full items-center gap-3 text-xl font-bold">
              <span class="grid size-9 place-items-center rounded-full bg-accent-600 font-display text-base text-white">1</span> {{ cms.text('referrals.step1', 'Referrer') }}
            </legend>
            <div class="clear-both grid gap-6 sm:grid-cols-2">
              {{ ui.input('referrer_name', 'Name of referrer', values, errors, autocomplete='name') }}
              {{ ui.input('organization', 'Agency or organization', values, errors, required=false, autocomplete='organization') }}
              {{ ui.select('referrer_role', 'Your role', values, errors, roles, required=true) }}
              {{ ui.input('referrer_phone', 'Your phone', values, errors, type='tel', autocomplete='tel') }}
            </div>
            {{ ui.input('referrer_email', 'Your email address', values, errors, type='email', autocomplete='email') }}
          </fieldset>

          <fieldset class="card space-y-6">
            <legend class="float-left mb-2 flex w-full items-center gap-3 text-xl font-bold">
              <span class="grid size-9 place-items-center rounded-full bg-brand-700 font-display text-base text-white">2</span> {{ cms.text('referrals.step2', 'Person being referred') }}
            </legend>
            <div class="clear-both grid gap-6 sm:grid-cols-2">
              {{ ui.input('person_name', 'Person’s first name or initials', values, errors, autocomplete='off', hint='Full details can wait for our follow-up call.') }}
              {{ ui.select('county', 'County', values, errors, counties, required=true) }}
              {{ ui.select('living_situation', 'Current living situation', values, errors, options.livingSituation) }}
              {{ ui.select('dda_eligibility', 'DDA eligibility', values, errors, options.ddaEligibility) }}
              {{ ui.select('priority_category', 'DDA funding priority (CR / CP)', values, errors, options.priority) }}
              {{ ui.select('pcp', 'Person-Centered Plan (PCP)', values, errors, options.pcp) }}
            </div>
            {{ shared.serviceChoices('services', 'Services needed', services, values, errors) }}
            <div class="sm:w-1/2 sm:pr-3">{{ ui.select('timeline', 'How soon is support needed?', values, errors, options.timeline) }}</div>
            {{ ui.textarea('notes', 'Additional information', values, errors, required=false, rows=4, maxlength=1500, hint='We will arrange secure sharing of the PCP or ISP after our first conversation, so please do not paste them here.') }}
          </fieldset>

          <div>
            <label class="flex gap-3 text-[15px] text-ink" for="f-consent">
              <input id="f-consent" type="checkbox" name="consent" value="yes" class="mt-1 size-5 shrink-0 accent-brand-700" required
                {% if values.consent == 'yes' %}checked{% endif %}
                {% if errors.consent %}aria-invalid="true" aria-describedby="f-consent-error"{% endif %}>
              <span>{{ cms.text('referrals.consent', 'I am authorized to share this information, and I have not included Social Security numbers or medical records.') }} See our <a href="/privacy" class="link">Privacy Policy</a>.</span>
            </label>
            {{ ui.fieldError('consent', errors) }}
          </div>

          {{ ui.captcha(turnstileSiteKey, errors) }}
          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary">{{ cms.text('referrals.submit', 'Submit referral') }} {{ icon('arrow-right', 'size-4') }}</button>
            <p class="text-sm text-muted">Fields marked (optional) can be left blank.</p>
          </div>
        </form>
      </div>

      {{ shared.formSidebar(site) }}
    </div>
  </section>
{% endblock %}
