{% extends "layouts/public.njk" %}
{% import "partials/ds.njk" as ds %}
{% import "partials/ds-fields.njk" as f %}
{% import "partials/ui.njk" as ui %}

{% block mainClass %}ds{% endblock %}

{% block content %}
  {{ ds.pageHead('Refer someone', cms.text('referrals.head.title', 'Send a referral'), cms.text('referrals.head.intro', 'Take the time to send a referral. Know that this referral allows us to help more individuals who require our special assistance. The information you provide here will be kept strictly confidential.')) }}

  <section><div class="d-wrap d-form-layout">
    {% if flash and flash.type == 'success' %}
      <div class="d-card">{{ f.success(flash, '/referrals') }}</div>
    {% else %}
    <form id="referral-form" class="d-card" method="post" action="/referrals#referral-form" novalidate data-wizard data-once>
      <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
      {{ ui.honeypot() }}
      {{ f.progress(['Referrer', 'Individual referred', 'Review']) }}
      {% include "partials/ds-form-status.njk" %}

      <fieldset class="d-step" data-step="1"><legend>{{ cms.text('referrals.step1', 'Referrer') }}</legend>
        <div class="d-row">{{ f.text('rf-referrer_name', 'referrer_name', 'Name of referrer', values, errors, true, 'text', 'name', 120) }}{{ f.text('rf-organization', 'organization', 'Agency or organization', values, errors, false, 'text', 'organization', 160) }}</div>
        {{ f.select('rf-referrer_role', 'referrer_role', 'Your role', values, errors, roles, true) }}
        <div class="d-row">{{ f.text('rf-referrer_phone', 'referrer_phone', 'Your phone', values, errors, true, 'tel', 'tel', 30) }}{{ f.text('rf-referrer_email', 'referrer_email', 'Your email address', values, errors, true, 'email', 'email', 191) }}</div>
      </fieldset>

      <fieldset class="d-step" data-step="2"><legend>{{ cms.text('referrals.step2', 'Individual being referred') }}</legend>
        <div class="d-row">
          {{ f.text('rf-person_name', 'person_name', 'Individual’s first name or initials', values, errors, true, 'text', '', 60, 'Full details can wait for our follow-up call.') }}
          {{ f.select('rf-county', 'county', 'County', values, errors, counties, true) }}
        </div>
        <div class="d-row">{{ f.select('rf-living_situation', 'living_situation', 'Current living situation', values, errors, options.livingSituation) }}{{ f.select('rf-dda_eligibility', 'dda_eligibility', 'DDA eligibility', values, errors, options.ddaEligibility) }}</div>
        <div class="d-row">{{ f.select('rf-priority_category', 'priority_category', 'DDA funding priority (CR / CP)', values, errors, options.priority) }}{{ f.select('rf-pcp', 'pcp', 'Person-Centered Plan (PCP)', values, errors, options.pcp) }}</div>
        {{ f.services('grp-services', 'Services needed', values, errors, services) }}
        {{ f.select('rf-timeline', 'timeline', 'How soon is support needed?', values, errors, options.timeline) }}
        <div class="d-field"><label for="rf-notes">Additional information</label><textarea id="rf-notes" name="notes" maxlength="1500"{{ f.invalid('notes', errors) }}>{{ values.notes }}</textarea><div class="d-hint">Optional. We will arrange secure sharing of the PCP or PIP after our first conversation, so please do not paste them here.</div>{{ ds.err('notes', errors) }}</div>
      </fieldset>

      <fieldset class="d-step" data-step="3"><legend>Review and send</legend>
        <div class="d-review-wrap"><p class="d-hint d-review-hint">Please check the details below.</p><dl class="d-review"></dl></div>
        <div class="d-field"><label class="d-check-row"><input type="checkbox" name="consent" value="yes" required{% if values.consent == 'yes' %} checked{% endif %}{{ f.invalid('consent', errors) }}> <span>{{ cms.text('referrals.consent', 'I am authorized to share this information, and I have not included Social Security numbers or medical records.') }}</span></label>{{ ds.err('consent', errors) }}</div>
        {{ ui.captcha(turnstileSiteKey, errors) }}
      </fieldset>

      {{ f.actions(cms.text('referrals.submit', 'Submit referral')) }}
      <p class="d-form-note">Fields marked <span class="d-req">*</span> are required.</p>
    </form>
    {% endif %}

    {% set doc = 'referrals' %}
    {% include "partials/ds-form-aside.njk" %}
  </div></section>
{% endblock %}
