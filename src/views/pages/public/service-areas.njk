{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% for sec in cms.sections('service-areas', { hero: 'Top banner', counties: 'Counties and office', cta: 'Call to action' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'hero' %}
    {{ ui.pageHero(cms.text('service-areas.hero.eyebrow', 'Service areas'), cms.text('service-areas.hero.title', 'Ten counties across Central and Southern Maryland'), cms.text('service-areas.hero.intro', 'Our office is in Catonsville, and our teams support people in their homes and communities across the region.'), [{ label: 'Service areas' }], cms.image('service-areas.hero.image', 'service-areas', 'A green, tree-lined park on a sunny day')) }}

  {% elif sec.key == 'counties' %}
    {% set dirLink = cms.link('service-areas.office.cta', 'Directions', '/contact#visit') %}
    <section class="section">
      <div class="container-page grid gap-6 md:grid-cols-2">
        {# The county list itself matches the referral form, so it changes with the code, not here. #}
        {% for area in areas %}
          <div class="card">
            <div class="flex items-center gap-4">
              <span class="{{ 'icon-tile-red' if loop.first else 'icon-tile' }}">{{ icon('map-pin', 'size-6') }}</span>
              <h2 class="text-2xl font-bold">{{ cms.text('service-areas.region' + loop.index, area.region) }}</h2>
            </div>
            <ul class="mt-6 divide-y divide-line">
              {% for c in area.counties %}
                <li class="flex items-center gap-3 py-3 text-lg text-ink">{{ icon('check', 'size-5 text-brand-600') }} {{ c }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>

      <div class="container-page mt-10">
        <div class="flex flex-col gap-6 rounded-3xl bg-surface p-6 ring-1 ring-line sm:p-8 md:flex-row md:items-center md:justify-between">
          <div class="flex gap-4">
            <span class="icon-tile !bg-white">{{ icon('home', 'size-6') }}</span>
            <div>
              <h2 class="text-lg font-bold">{{ cms.text('service-areas.office.title', 'Our office') }}</h2>
              <p class="mt-1 text-muted">{{ site.address.street }}, {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</p>
            </div>
          </div>
          <a href="{{ dirLink.href }}" {{ dirLink.attrs }} class="btn-secondary shrink-0">{{ dirLink.label }}</a>
        </div>
        {% set outsideLink = cms.link('service-areas.outside.link', 'Contact us', '/contact') %}
        <p class="mt-6 text-center text-[15px] text-muted">{{ cms.text('service-areas.outside.text', 'Live outside these counties?') }} <a href="{{ outsideLink.href }}" {{ outsideLink.attrs }} class="link">{{ outsideLink.label }}</a> {{ cms.text('service-areas.outside.after', 'and we will help where we can.') }}</p>
      </div>
    </section>

  {% elif sec.key == 'cta' %}
    {{ ui.ctaBand(site) }}
  {% endif %}
  </div>
  {% endfor %}
{% endblock %}
