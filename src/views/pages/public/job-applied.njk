{% extends "layouts/public.njk" %}

{% block content %}
  <section class="section bg-cream">
    <div class="container-page max-w-2xl text-center">
      <span class="mx-auto grid size-16 place-items-center rounded-full bg-brand-700 text-white shadow-lift">{{ icon('check', 'size-8') }}</span>
      <h1 class="mt-6 text-3xl font-extrabold sm:text-4xl">Thank you for applying</h1>
      <p class="mt-4 text-lg text-muted">
        We received your application for <strong class="text-ink">{{ done.title }}</strong>.
        Your reference is <strong class="font-mono text-ink">{{ done.reference }}</strong>{% if done.emailed %}, and we have emailed you a confirmation{% endif %}.
      </p>
      <p class="mt-3 text-[15px] text-muted">Our team reviews every application. If your experience is a good match, we will contact you.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/careers" class="btn-primary">See other open positions {{ icon('arrow-right', 'size-4') }}</a>
        <a href="/" class="btn-secondary">Back to the home page</a>
      </div>
    </div>
  </section>
{% endblock %}
