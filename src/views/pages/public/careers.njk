{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% for sec in cms.sections('careers', { hero: 'Top banner', positions: 'Open positions', roles: 'Roles we hire for', why: 'Why work at HLO', apply: 'How to apply' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'hero' %}
  {% set careersCta1 = cms.link('careers.hero.cta1', 'See open positions', '#positions') %}
  {% set careersCta2 = cms.link('careers.hero.cta2', 'How to apply', '#how-to-apply') %}
  {% call ui.pageHero(cms.text('careers.hero.eyebrow', 'Careers'), cms.text('careers.hero.title', copy.title), cms.text('careers.hero.intro', copy.intro), [{ label: 'Careers' }], cms.image('careers.hero.image', 'careers-team', 'Colleagues smiling and talking around a meeting table')) %}
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="{{ careersCta1.href }}" {{ careersCta1.attrs }} class="btn-primary">{{ careersCta1.label }} {{ icon('arrow-right', 'size-4') }}</a>
      <a href="{{ careersCta2.href }}" {{ careersCta2.attrs }} class="btn-secondary">{{ careersCta2.label }}</a>
    </div>
  {% endcall %}

  {% elif sec.key == 'positions' %}

  {# Open positions: search, filters, list, pagination. Plain GET form, so it works without JS. #}
  <section id="positions" class="section">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{{ cms.text('careers.positions.eyebrow', 'Join our team') }}</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{{ cms.text('careers.positions.title', 'Open positions') }}</h2>
        </div>
      </div>

      <form method="get" action="/careers#positions" role="search" aria-label="Search open positions"
            class="mt-8 rounded-3xl border border-line bg-surface p-4 sm:p-5" data-live-search="#job-results">
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-[2fr_1fr_1fr_1fr_auto]">
          <div class="relative col-span-2 lg:col-span-1">
            <label for="f-q" class="sr-only">Search by job title, keyword or location</label>
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-muted">{{ icon('search', 'size-5') }}</span>
            <input id="f-q" type="search" name="q" value="{{ criteria.q }}" maxlength="100" placeholder="Job title, keyword or location"
                   class="form-control !pl-12" autocomplete="off">
          </div>
          {% for f in [
            { name: 'type', label: 'Schedule', all: 'Any schedule', values: options.type },
            { name: 'location', label: 'Location', all: 'Any location', values: options.location },
            { name: 'department', label: 'Department', all: 'Any department', values: options.department }
          ] %}
            <div>
              <label for="f-{{ f.name }}" class="sr-only">{{ f.label }}</label>
              <select id="f-{{ f.name }}" name="{{ f.name }}" class="form-control !px-3 text-[15px] sm:!px-4">
                <option value="">{{ f.all }}</option>
                {% for v in f.values %}<option value="{{ v }}" {% if criteria[f.name] == v %}selected{% endif %}>{{ v }}</option>{% endfor %}
              </select>
            </div>
          {% endfor %}
          <button type="submit" class="btn-green !px-4">{{ icon('search', 'size-4') }} Search</button>
        </div>
      </form>

      <p class="sr-only" aria-live="polite" data-results-status></p>
      <div id="job-results" class="transition-opacity duration-150 aria-busy:opacity-50" data-results>
        {% include "partials/careers-results.njk" %}
      </div>
    </div>
  </section>

  {% elif sec.key == 'roles' %}
  {% set rolesContact = cms.link('careers.roles.cta', 'Contact us', '/contact') %}
  <section class="section pt-0">
    <div class="container-page">
      <div class="rounded-[2rem] bg-cream p-7 ring-1 ring-line sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-center">
          <div>
            <p class="eyebrow">{{ cms.text('careers.roles.eyebrow', 'Positions available') }}</p>
            <h2 class="mt-3 text-2xl font-extrabold sm:text-3xl">{{ cms.text('careers.roles.title', 'Roles we hire for') }}</h2>
            <p class="mt-3 text-[15px] text-muted">{{ cms.text('careers.roles.text', 'Current openings for these roles are listed above, each with its own Apply button. Don’t see the role you want right now?') }} <a href="{{ rolesContact.href }}" {{ rolesContact.attrs }} class="link">{{ rolesContact.label }}</a>.</p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2">
            {% for r in cms.list('careers.roles.items', cms.objects(copy.roles)) %}
              <li class="flex items-center gap-3 rounded-2xl bg-white px-4 py-3.5 font-medium text-ink shadow-soft ring-1 ring-line" {{ r.attrs }}>
                <span class="grid size-8 shrink-0 place-items-center rounded-full {{ 'bg-accent-50 text-accent-600' if loop.index is odd else 'bg-brand-50 text-brand-700' }}">{{ icon('briefcase', 'size-4') }}</span>
                <span>{{ r.text('label') }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {% elif sec.key == 'why' %}
  {# Why work at HLO #}
  <section class="section bg-brand-900 text-white">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow !text-accent-100 before:!bg-accent-500">{{ cms.text('careers.why.eyebrow', 'Why work at HLO') }}</p>
        <h2 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">{{ cms.text('careers.why.title', copy.whyTitle) }}</h2>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {% set whyIcons = ['heart', 'document', 'users', 'map-pin'] %}
        {% for p in cms.list('careers.why.items', copy.why) %}
          <li class="reveal group rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:bg-white/10" {{ p.attrs }}>
            <span class="grid size-12 place-items-center rounded-2xl transition duration-300 {{ 'bg-accent-600' if loop.index is odd else 'bg-brand-500' }} text-white group-hover:scale-110">{{ icon(whyIcons[loop.index0] or 'heart', 'size-6') }}</span>
            <h3 class="mt-5 text-lg font-bold text-white">{{ p.text('title') }}</h3>
            <p class="mt-1.5 text-[15px] text-brand-100">{{ p.text('text') }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {% elif sec.key == 'apply' %}
  {% set applyContact = cms.link('careers.apply.contact', 'Questions? Contact us', '/contact') %}
  {# How to apply #}
  <section id="how-to-apply" class="section">
    <div class="container-page">
      {{ ui.sectionHeading(cms.text('careers.apply.eyebrow', 'How to apply'), cms.text('careers.apply.title', 'Three simple steps'), null, true) }}
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {% for step in cms.list('careers.apply.steps', copy.steps) %}
          <li class="reveal card relative !p-6 sm:!p-7" {{ step.attrs }}>
            <span class="grid size-11 place-items-center rounded-full font-display text-lg font-bold text-white {{ 'bg-accent-600' if loop.index is odd else 'bg-brand-700' }}">{{ loop.index }}</span>
            <h3 class="mt-5 text-lg font-bold">{{ step.text('title') }}</h3>
            <p class="mt-1.5 text-[15px] text-muted">{{ step.text('text') }}</p>
          </li>
        {% endfor %}
      </ol>

      <div class="mt-8 flex flex-col gap-5 rounded-3xl bg-surface p-6 ring-1 ring-line sm:p-7 md:flex-row md:items-center md:justify-between">
        <p class="flex items-start gap-3 text-[15px] text-muted">
          {{ icon('shield', 'mt-0.5 size-5 shrink-0 text-brand-700') }}
          <span>{{ cms.text('careers.apply.note', copy.applyNote) }}</span>
        </p>
        <a href="{{ applyContact.href }}" {{ applyContact.attrs }} class="btn-secondary shrink-0">{{ icon('mail', 'size-4') }} {{ applyContact.label }}</a>
      </div>
    </div>
  </section>
  {% endif %}
  </div>
  {% endfor %}
{% endblock %}
