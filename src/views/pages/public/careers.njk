{% extends "layouts/public.njk" %}
{% import "partials/ds.njk" as ds %}
{% import "partials/ds-fields.njk" as f %}
{% import "partials/ui.njk" as ui %}

{#
  Careers (HLO's design, version 41, October 2026): open positions first, then benefits,
  then one apply form. Positions come from Jobs in the portal; the form sends to
  Applications (with a resume upload, which the design left out), and has a
  "General application" choice. The previous design: careers-old.njk.
#}
{% block mainClass %}ds{% endblock %}
{% block meta %}{% if structuredData.length %}<script type="application/ld+json">{{ structuredData | jsonld }}</script>{% endif %}{% endblock %}

{% macro benefitIcon(name) %}
  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- if name == 'dental' %}<path d="M8 4c-2.5 0-4 1.8-4 4.2 0 2 1 3.2 1.4 5 .4 2 .6 6.8 2.1 6.8 1.3 0 1.3-4 3.5-4s2.2 4 3.5 4c1.5 0 1.7-4.8 2.1-6.8C17 11.4 18 10.2 18 8.2 18 5.8 16.5 4 14 4c-1.2 0-1.6.6-3 .6S9.2 4 8 4z"/>
    {%- elif name == 'vision' %}<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
    {%- elif name == 'pto' %}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>
    {%- elif name == 'sick' %}<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M12 8v8M8 12h8"/>
    {%- elif name == 'life' %}<path d="M12 3 5 6v5.5c0 4.2 2.8 7.4 7 9.5 4.2-2.1 7-5.3 7-9.5V6l-7-3z"/><path d="m9 12 2 2 4-4.5"/>
    {%- elif name == 'cash' %}<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/>
    {%- elif name == 'gift' %}<rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v7.5h14V12M12 8v11.5"/><path d="M12 8c-1-3.2-4.8-3.4-4.8-1.3 0 1.5 2.4 1.3 4.8 1.3zm0 0c1-3.2 4.8-3.4 4.8-1.3 0 1.5-2.4 1.3-4.8 1.3z"/>
    {%- elif name == 'referral' %}<circle cx="9" cy="8" r="3.2"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M18 8v6M15 11h6"/>
    {%- elif name == 'retirement' %}<path d="M3 17 9 11l4 4 8-8"/><path d="M15 7h6v6"/>
    {%- else %}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M12 9v5M9.5 11.5h5"/>{% endif -%}
  </svg>
{% endmacro %}

{% block content %}
  {{ ds.pageHead('Careers', cms.text('careers.head.title', 'Come work with us'), cms.text('careers.head.lede', 'Join a team that helps adults with intellectual and developmental disabilities live the lives they choose. We would love to hear from you.')) }}
  {{ ds.pagenav([
    { id: 'openings', label: cms.text('careers.nav.openings', 'Open positions') },
    { id: 'benefits', label: cms.text('careers.nav.benefits', 'Benefits') },
    { id: 'apply', label: cms.text('careers.nav.apply', 'Apply') }
  ]) }}

  {% for sec in cms.sections('careers', { openings: 'Open positions', benefits: 'Benefits we offer', apply: 'Apply' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'openings' %}
    <section id="openings"><div class="d-wrap">
      <div class="d-section-head"><h2>{{ cms.text('careers.openings.title', 'Open positions') }}</h2><p>{{ cms.text('careers.openings.intro', 'We post new roles here as they open.') }}</p></div>
      {% if jobs.length > 3 %}<p class="d-job-count">{{ jobs.length }} open positions. Scroll the list to see them all.</p>{% endif %}
      {# Scrolls inside a fixed height, so the page stays short however many jobs are posted. #}
      <div class="d-job-list{{ ' d-job-scroll' if jobs.length > 3 }}"{% if jobs.length > 3 %} tabindex="0" role="region" aria-label="Open positions (scrolls)"{% endif %}>
        {% for j in jobs %}
          <article class="d-job" id="job-{{ j.slug }}">
            <div class="d-job-main">
              <h3>{{ j.title }}</h3>
              {# Pay is under "Role details" (Maryland requires it in every posting). #}
              {% set facts = [] %}{% for x in [j.employment_type, j.location, j.department] %}{% if x %}{% set _ = facts.push(x) %}{% endif %}{% endfor %}
              {% if facts.length %}<ul class="d-job-meta">{% for x in facts %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
              <p>{{ j.description | richText | firstParagraph | excerpt(220) }}</p>
              <details class="d-job-more">
                <summary>{{ cms.text('careers.openings.details', 'Role details') }}</summary>
                <div class="d-job-body">
                  <dl class="d-job-facts">
                    {% if j.department %}<dt>Department</dt><dd>{{ j.department }}</dd>{% endif %}
                    {% if j.location %}<dt>Location</dt><dd>{{ j.location }}</dd>{% endif %}
                    {% if j.employment_type %}<dt>Schedule</dt><dd>{{ j.employment_type }}</dd>{% endif %}
                    {% if j.pay_range %}<dt>Pay</dt><dd>{{ j.pay_range }}</dd>{% endif %}
                  </dl>
                  <h4>About the role</h4>
                  <div class="d-job-text">{{ j.description | richText }}</div>
                  {% if j.requirements %}<h4>Requirements</h4><div class="d-job-text">{{ j.requirements | richText }}</div>{% endif %}
                  {% if j.benefits %}<h4>Benefits</h4><div class="d-job-text">{{ j.benefits | richText }}</div>{% endif %}
                </div>
              </details>
            </div>
            <a class="d-btn d-btn-primary d-job-apply" href="/careers?job={{ j.slug | urlencode }}#apply" data-apply-job="{{ j.slug }}">Apply<span class="d-sr-only"> for {{ j.title }}</span></a>
          </article>
        {% else %}
          <div class="d-job-empty">
            <h3>{{ cms.text('careers.openings.emptyTitle', 'No positions are posted right now') }}</h3>
            <p>{{ cms.text('careers.openings.emptyText', 'We are always glad to meet caring people. Send a general application below, and we will contact you when a role that fits opens up.') }}</p>
            <a class="d-btn d-btn-primary" href="/careers?job=general#apply" data-apply-job="general">{{ cms.text('careers.openings.emptyCta', 'Send a general application') }}</a>
          </div>
        {% endfor %}
      </div>
    </div></section>

  {% elif sec.key == 'benefits' %}
    <section class="d-alt" id="benefits"><div class="d-wrap">
      <div class="d-section-head">
        <h2>{{ cms.text('careers.benefits.title', 'Benefits we offer') }}</h2>
        <p>{{ cms.text('careers.benefits.lede', 'We value the people who care for our neighbors every day, and we offer a benefits package to match.') }}</p>
      </div>
      <ul class="d-benefit-grid">
        {% for b in cms.list('careers.benefits.list', [
          { name: 'Health insurance', icon: 'heart' }, { name: 'Dental', icon: 'dental' }, { name: 'Vision', icon: 'vision' },
          { name: 'Paid time off', icon: 'pto' }, { name: 'Sick leave', icon: 'sick' }, { name: 'Life insurance', icon: 'life' },
          { name: '401(k)', icon: 'retirement' }, { name: 'Bonuses', icon: 'gift' }, { name: 'Employee referral incentives', icon: 'referral' }
        ]) %}
          <li class="d-benefit" {{ b.attrs }}><span class="d-benefit-ic">{{ benefitIcon(b.icon) }}</span><span class="d-benefit-name">{{ b.text('name') }}</span></li>
        {% endfor %}
      </ul>
    </div></section>

  {% elif sec.key == 'apply' %}
    <section id="apply"><div class="d-wrap d-form-layout">
      <div>
        <h2>{{ cms.text('careers.apply.title', 'Apply to join our team') }}</h2>
        <p>{{ cms.text('careers.apply.intro', 'Tell us a little about yourself. If a role is posted above, choose it. If not, send a general application.') }}</p>
        <div class="d-aside-card d-mt-28"><h3>{{ cms.text('careers.resume.title', 'Include your resume') }}</h3>
          <p class="d-privacy">{{ cms.text('careers.resume.text', 'Attach your resume (PDF or Word) to the form. It is checked for viruses, only seen by our hiring team, and deleted after 3 months.') }}</p></div>
      </div>

      {% if flash and flash.type == 'success' %}
        <div class="d-card">
          <div class="d-success">
            <svg class="d-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24"/><path d="M14 27l8 8 16-17"/></svg>
            <h2 class="d-s-title">Thank you. We have your application.</h2>
            <p class="d-s-text">{{ flash.message }}</p>
            <p class="d-s-text">Our hiring team reviews every application and will contact you if your experience is a good match.</p>
            <div class="d-s-actions"><a class="d-btn d-btn-dark" href="/">Back to home</a><a class="d-btn d-btn-ghost" href="/careers#openings">See open positions</a></div>
          </div>
        </div>
      {% else %}
        <form class="d-card" method="post" action="/careers/apply#apply" enctype="multipart/form-data" novalidate data-once>
          <input type="hidden" name="_csrf" value="{{ csrfToken() }}">
          {{ ui.honeypot() }}
          <p class="d-req-note">Fields marked <span class="d-req" aria-hidden="true">*</span><span class="d-sr-only">with an asterisk</span> are required.</p>
          <fieldset><legend>{{ cms.text('careers.form.title', 'Apply online') }}</legend>
            {% include "partials/ds-form-status.njk" %}
            <div class="d-row">{{ f.text('jb-first_name', 'first_name', 'First name', values, errors, true, 'text', 'given-name', 80) }}{{ f.text('jb-last_name', 'last_name', 'Last name', values, errors, true, 'text', 'family-name', 80) }}</div>
            <div class="d-row">{{ f.text('jb-email', 'email', 'Email address', values, errors, true, 'email', 'email', 191) }}{{ f.text('jb-phone', 'phone', 'Phone number', values, errors, true, 'tel', 'tel') }}</div>
            {{ f.text('jb-cell', 'cell', 'Cell number', values, errors, true, 'tel', 'tel') }}
            <div class="d-field"><label for="jb-job">Position <span class="d-req">*</span></label>
              <select id="jb-job" name="job" required{{ f.invalid('job', errors) }}>
                <option value="">Select…</option>
                {% for j in jobs %}<option value="{{ j.slug }}"{% if values.job == j.slug %} selected{% endif %}>{{ j.title }}{% if j.location %} ({{ j.location }}){% endif %}</option>{% endfor %}
                <option value="general"{% if values.job == 'general' %} selected{% endif %}>General application (no specific role)</option>
              </select>{{ ds.err('job', errors) }}</div>
            <div class="d-field"><label for="jb-resume">Resume <span class="d-req">*</span></label>
              <input type="file" id="jb-resume" name="resume" required accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="d-file"{{ f.invalid('resume', errors) }}>
              <div class="d-hint">PDF or Word (.docx), up to {{ maxLabel }}. Checked for viruses before our team sees it.</div>{{ ds.err('resume', errors) }}</div>
            <div class="d-field"><label for="jb-message">Tell us about yourself</label><textarea id="jb-message" name="cover_note" maxlength="3000" aria-describedby="jb-message-h"{{ f.invalid('cover_note', errors) }}>{{ values.cover_note }}</textarea>
              <div class="d-hint" id="jb-message-h">{{ cms.text('careers.form.messageHint', 'Optional. A sentence or two about your experience or certifications is plenty.') }}</div>{{ ds.err('cover_note', errors) }}</div>
            <div class="d-field"><label class="d-check-row"><input type="checkbox" name="consent" value="yes" required{% if values.consent == 'yes' %} checked{% endif %}{{ f.invalid('consent', errors) }}> <span>{{ cms.text('careers.form.consent', 'I agree that HLO may keep my details and resume to consider me for this and similar roles, as described in our') }} <a href="/privacy">Privacy Policy</a>.</span></label>{{ ds.err('consent', errors) }}</div>
          </fieldset>
          <p class="d-fine-print d-mt-s">{{ cms.text('careers.form.eoe', 'Healthy Living Option Inc. is an equal opportunity employer.') }}</p>
          {{ ui.captcha(turnstileSiteKey, errors) }}
          <div class="d-form-actions"><button class="d-btn d-btn-primary" type="submit">{{ cms.text('careers.form.submit', 'Submit application') }}</button></div>
          <p class="d-form-note">{{ cms.text('careers.form.noPay', 'HLO will never ask you to pay anything to apply.') }}</p>
        </form>
      {% endif %}
    </div></section>
  {% endif %}
  </div>
  {% endfor %}

  {{ ds.pager(design.pageOrder, '/careers') }}
{% endblock %}
