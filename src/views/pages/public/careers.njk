{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {{ ui.pageHero('Careers', 'Do work that matters', 'Join a team that helps adults across Maryland live independent, connected lives. We value kindness, reliability and respect.', [{ label: 'Careers' }], 'careers-team', 'Colleagues smiling and talking around a meeting table') }}

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <h2 class="text-2xl font-bold">Open positions</h2>
        {% if jobs.length %}
          <ul class="mt-6 space-y-4">
            {% for job in jobs %}
              <li>
                <a href="/careers/{{ job.slug }}" class="card card-hover group flex flex-col gap-4 !p-6 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h3 class="text-xl font-bold group-hover:text-brand-700">{{ job.title }}</h3>
                    <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[15px] text-muted">
                      {% if job.department %}<span class="flex items-center gap-1.5">{{ icon('briefcase', 'size-4') }} {{ job.department }}</span>{% endif %}
                      {% if job.location %}<span class="flex items-center gap-1.5">{{ icon('map-pin', 'size-4') }} {{ job.location }}</span>{% endif %}
                      {% if job.employment_type %}<span class="flex items-center gap-1.5">{{ icon('clock', 'size-4') }} {{ job.employment_type }}</span>{% endif %}
                    </p>
                  </div>
                  <span class="inline-flex shrink-0 items-center gap-1.5 font-semibold text-brand-700">View role {{ icon('arrow-right', 'size-4 transition group-hover:translate-x-1') }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="mt-6 rounded-3xl border-2 border-dashed border-line p-10 text-center">
            <span class="icon-tile mx-auto">{{ icon('briefcase', 'size-6') }}</span>
            <p class="mt-4 text-lg font-semibold text-ink">There are no open positions right now.</p>
            <p class="mt-1 text-muted">New roles are posted here first. Please check back soon.</p>
          </div>
        {% endif %}
      </div>

      <aside class="space-y-5">
        <div class="card !p-6">
          <h2 class="text-lg font-bold">Why work at HLO</h2>
          <ul class="mt-4 space-y-3 text-[15px] text-ink">
            {% for p in ['Meaningful work that changes lives', 'Training and support from day one', 'A team that values every voice', 'Roles across Central and Southern Maryland'] %}
              <li class="flex gap-2.5">{{ icon('check', 'mt-1 size-4 shrink-0 text-brand-600') }} {{ p }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="rounded-3xl bg-surface p-6 text-[15px] text-muted ring-1 ring-line">
          <p class="flex gap-3">{{ icon('info', 'mt-0.5 size-5 shrink-0 text-brand-700') }} Applications are handled through our secure ADP careers portal. Each role has an <strong class="text-ink">Apply</strong> button that takes you there.</p>
        </div>
      </aside>
    </div>
  </section>
{% endblock %}
