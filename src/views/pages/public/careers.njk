{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% call ui.pageHero('Careers', 'Do work that matters', 'Join a team that helps adults across Maryland live independent, connected lives. We value kindness, reliability and respect.', [{ label: 'Careers' }], 'careers-team', 'Colleagues smiling and talking around a meeting table') %}
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#positions" class="btn-primary">See open positions {{ icon('arrow-right', 'size-4') }}</a>
      <a href="#how-to-apply" class="btn-secondary">How to apply</a>
    </div>
  {% endcall %}

  {# Open positions: search, filters, list, pagination. Plain GET form, so it works without JS. #}
  <section id="positions" class="section">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Join our team</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Open positions</h2>
        </div>
      </div>

      <form method="get" action="/careers#positions" role="search" aria-label="Search open positions"
            class="mt-8 rounded-3xl border border-line bg-surface p-4 sm:p-5" data-live-search="#job-results">
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-[2fr_1fr_1fr_1fr_auto]">
          <div class="relative col-span-2 lg:col-span-1">
            <label for="f-q" class="sr-only">Search by job title, keyword or location</label>
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-muted">{{ icon('search', 'size-5') }}</span>
            <input id="f-q" type="search" name="q" value="{{ criteria.q }}" maxlength="100" placeholder="Job title, keyword or location"
                   class="form-control !pl-12" autocomplete="off">
          </div>
          {% for f in [
            { name: 'type', label: 'Schedule', all: 'Any schedule', values: options.type },
            { name: 'location', label: 'Location', all: 'Any location', values: options.location },
            { name: 'department', label: 'Department', all: 'Any department', values: options.department }
          ] %}
            <div>
              <label for="f-{{ f.name }}" class="sr-only">{{ f.label }}</label>
              <select id="f-{{ f.name }}" name="{{ f.name }}" class="form-control !px-3 text-[15px] sm:!px-4">
                <option value="">{{ f.all }}</option>
                {% for v in f.values %}<option value="{{ v }}" {% if criteria[f.name] == v %}selected{% endif %}>{{ v }}</option>{% endfor %}
              </select>
            </div>
          {% endfor %}
          <button type="submit" class="btn-green !px-4">{{ icon('search', 'size-4') }} Search</button>
        </div>
      </form>

      <p class="sr-only" aria-live="polite" data-results-status></p>
      <div id="job-results" class="transition-opacity duration-150 aria-busy:opacity-50" data-results>
        {% include "partials/careers-results.njk" %}
      </div>
    </div>
  </section>

  {# Why work at HLO #}
  <section class="section bg-brand-900 text-white">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow !text-accent-100 before:!bg-accent-500">Why work at HLO</p>
        <h2 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">A place to grow while helping others</h2>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {% for p in [
          { icon: 'heart', t: 'Meaningful work', d: 'Help people live the lives they choose, every single day.' },
          { icon: 'document', t: 'Training from day one', d: 'Paid training and ongoing support to build your skills.' },
          { icon: 'users', t: 'A team that listens', d: 'Supportive colleagues and leaders who value every voice.' },
          { icon: 'map-pin', t: 'Close to home', d: 'Roles across ten counties in Central and Southern Maryland.' }
        ] %}
          <li class="reveal group rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:bg-white/10">
            <span class="grid size-12 place-items-center rounded-2xl transition duration-300 {{ 'bg-accent-600' if loop.index is odd else 'bg-brand-500' }} text-white group-hover:scale-110">{{ icon(p.icon, 'size-6') }}</span>
            <h3 class="mt-5 text-lg font-bold text-white">{{ p.t }}</h3>
            <p class="mt-1.5 text-[15px] text-brand-100">{{ p.d }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# How to apply #}
  <section id="how-to-apply" class="section">
    <div class="container-page">
      {{ ui.sectionHeading('How to apply', 'Three simple steps', null, true) }}
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {% for step in [
          { t: 'Find a role', d: 'Search or browse open positions and read the full details.' },
          { t: 'Apply on ADP', d: 'Select “Apply on ADP”. Our secure ADP careers portal opens in a new tab.' },
          { t: 'Hear from us', d: 'Our team reviews your application and contacts you about next steps.' }
        ] %}
          <li class="reveal card relative !p-6 sm:!p-7">
            <span class="grid size-11 place-items-center rounded-full font-display text-lg font-bold text-white {{ 'bg-accent-600' if loop.index is odd else 'bg-brand-700' }}">{{ loop.index }}</span>
            <h3 class="mt-5 text-lg font-bold">{{ step.t }}</h3>
            <p class="mt-1.5 text-[15px] text-muted">{{ step.d }}</p>
          </li>
        {% endfor %}
      </ol>

      <div class="mt-8 flex flex-col gap-5 rounded-3xl bg-surface p-6 ring-1 ring-line sm:p-7 md:flex-row md:items-center md:justify-between">
        <p class="flex items-start gap-3 text-[15px] text-muted">
          {{ icon('shield', 'mt-0.5 size-5 shrink-0 text-brand-700') }}
          <span>Applications are handled securely by ADP, our recruitment provider. HLO will never ask for payment to apply.</span>
        </p>
        <a href="/contact" class="btn-secondary shrink-0">{{ icon('mail', 'size-4') }} Questions? Contact us</a>
      </div>
    </div>
  </section>
{% endblock %}
