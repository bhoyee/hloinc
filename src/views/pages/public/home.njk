{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% if announcements.length %}
    <section aria-label="Announcements" class="border-b border-accent-100 bg-accent-50">
      <div class="container-page py-3">
        {% for a in announcements %}
          <div class="flex items-start gap-3 py-1 text-[15px] text-ink">
            {{ icon('megaphone', 'mt-0.5 size-5 shrink-0 text-accent-600') }}
            <p><strong class="font-semibold">{{ a.title }}</strong> <span class="text-muted">— {{ a.body }}</span></p>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Hero #}
  <section class="relative overflow-hidden bg-gradient-to-b from-surface to-white">
    <div class="pointer-events-none absolute top-0 -left-40 size-[32rem] rounded-full bg-brand-100/50 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative grid items-center gap-14 py-16 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:py-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-brand-800 shadow-soft ring-1 ring-line">
          <span class="size-2 rounded-full bg-accent-500" aria-hidden="true"></span>
          {{ page.eyebrow }}
        </p>
        <h1 class="mt-6 text-4xl leading-[1.08] font-extrabold sm:text-5xl lg:text-6xl">{{ page.title }}</h1>
        <p class="mt-6 max-w-xl text-lg text-muted sm:text-xl">{{ page.intro }}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/getting-started" class="btn-primary">Start intake {{ icon('arrow-right', 'size-4') }}</a>
          <a href="/services" class="btn-secondary">Explore our services</a>
        </div>
        <ul class="mt-10 grid gap-3 text-[15px] text-muted sm:grid-cols-2">
          {% for point in ['Person-centered support', 'Licensed community homes', 'Trained, caring staff', '10 Maryland counties'] %}
            <li class="flex items-center gap-2.5">
              <span class="grid size-6 place-items-center rounded-full bg-brand-100 text-brand-700">{{ icon('check', 'size-3.5') }}</span>
              {{ point }}
            </li>
          {% endfor %}
        </ul>
      </div>

      {# Visual composition — swap the panel for a photograph once HLO supplies one. #}
      <div class="relative mx-auto w-full max-w-lg lg:max-w-none" aria-hidden="true">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900 shadow-lift sm:aspect-[5/5]">
          <div class="absolute -top-16 -right-16 size-64 rounded-full bg-brand-400/40 blur-2xl"></div>
          <div class="absolute -bottom-20 -left-10 size-72 rounded-full bg-accent-500/25 blur-3xl"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.14)_1px,transparent_0)] [background-size:22px_22px]"></div>
          <div class="absolute inset-x-8 top-10 sm:inset-x-12 sm:top-14">
            <span class="grid size-16 place-items-center rounded-2xl bg-white/15 text-white ring-1 ring-white/30 backdrop-blur">{{ icon('heart', 'size-8') }}</span>
            <p class="mt-6 max-w-xs font-display text-2xl leading-snug font-bold text-white sm:text-3xl">Dignity, choice and community, every day.</p>
          </div>
        </div>

        <div class="absolute -bottom-6 -left-4 w-64 rounded-3xl bg-white p-5 shadow-lift ring-1 ring-line sm:-left-10 sm:w-72">
          <p class="text-xs font-semibold tracking-wide text-muted uppercase">Your plan, your goals</p>
          <ul class="mt-3 space-y-2.5 text-sm font-medium text-ink">
            {% for g in ['Daily living skills', 'Community activities', 'A home of your own'] %}
              <li class="flex items-center gap-2.5"><span class="grid size-6 place-items-center rounded-full bg-brand-500 text-white">{{ icon('check', 'size-3.5') }}</span>{{ g }}</li>
            {% endfor %}
          </ul>
        </div>

        <div class="absolute top-8 -right-3 rounded-2xl bg-white px-4 py-3 shadow-lift ring-1 ring-line sm:-right-8">
          <p class="flex items-center gap-2 text-sm font-semibold text-ink">{{ icon('map-pin', 'size-5 text-accent-600') }} Catonsville, MD</p>
          <p class="mt-0.5 text-xs text-muted">Serving 10 counties</p>
        </div>
      </div>
    </div>
  </section>

  {# Quick paths (requirements §3: Services, Location, Careers, Contact) #}
  <section class="container-page relative z-10 -mt-2 pb-8 lg:-mt-6">
    <h2 class="sr-only">Find what you need</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {% for p in [
        { href: '/services', icon: 'heart', title: 'Our services', text: 'Supports at home, in community homes and out in the community.' },
        { href: '/service-areas', icon: 'map-pin', title: 'Location & areas', text: 'Our Catonsville office and the 10 counties we serve.' },
        { href: '/careers', icon: 'briefcase', title: 'Careers', text: 'Join a team that puts people first.' },
        { href: '/contact', icon: 'chat', title: 'Contact us', text: 'Call, email, visit or send us a message.' }
      ] %}
        <li>
          <a href="{{ p.href }}" class="card card-hover group flex h-full flex-col !p-6">
            <span class="icon-tile">{{ icon(p.icon, 'size-6') }}</span>
            <span class="mt-5 flex items-center justify-between font-display text-lg font-bold text-ink">
              {{ p.title }} {{ icon('arrow-right', 'size-5 text-brand-600 transition group-hover:translate-x-1') }}
            </span>
            <span class="mt-1.5 text-[15px] text-muted">{{ p.text }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>

  {# Services #}
  <section class="section">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        {{ ui.sectionHeading('What we offer', 'Supports shaped around each person', 'Every service follows the person’s own plan and goals, and adapts as they grow.') }}
        <a href="/services" class="link shrink-0">View all services</a>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {% for s in services %}
          <li class="{{ 'lg:col-span-2' if loop.first }}">
            <a href="/services/{{ s.slug }}" class="card card-hover group flex h-full flex-col {{ 'bg-gradient-to-br from-brand-50 to-white' if loop.first }}">
              <span class="icon-tile">{{ icon(s.icon, 'size-6') }}</span>
              <h3 class="mt-6 text-xl font-bold">{{ s.name }}</h3>
              <p class="mt-2 flex-1 text-muted">{{ s.summary }}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[15px] font-semibold text-brand-700">
                Learn more <span class="sr-only">about {{ s.name }}</span> {{ icon('arrow-right', 'size-4 transition group-hover:translate-x-1') }}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# Approach #}
  <section class="section bg-cream">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{{ page.approachTitle }}</h2>
        <p class="mt-5 text-lg text-muted">{{ page.approach }}</p>
        <a href="/about" class="btn-secondary mt-8">More about HLO</a>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2">
        {% for step in [
          { t: 'We listen', d: 'We start by understanding the person, their family and what matters to them.' },
          { t: 'We plan together', d: 'Support follows the person-centered plan agreed with their coordinator.' },
          { t: 'We support', d: 'Trained staff provide day-to-day support with dignity and respect.' },
          { t: 'We grow with you', d: 'We check in regularly and adjust as goals and needs change.' }
        ] %}
          <li class="card !p-6">
            <span class="font-display text-sm font-bold text-accent-600">0{{ loop.index }}</span>
            <h3 class="mt-2 text-lg font-bold">{{ step.t }}</h3>
            <p class="mt-1.5 text-[15px] text-muted">{{ step.d }}</p>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  {# Service areas #}
  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        {{ ui.sectionHeading('Where we work', 'Serving Central and Southern Maryland', 'Our office is in Catonsville, and our teams support people across ten counties.') }}
        <div class="card mt-8 !p-6">
          <p class="flex gap-3 text-ink">{{ icon('map-pin', 'mt-0.5 size-5 shrink-0 text-brand-600') }}
            <span>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span></p>
          <p class="mt-3 flex gap-3 text-ink">{{ icon('clock', 'mt-0.5 size-5 shrink-0 text-brand-600') }} {{ site.hours }}</p>
          <a href="/contact#visit" class="link mt-5 inline-block">Directions and walk-in information</a>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {% for area in areas %}
          <div class="rounded-3xl bg-surface p-6 ring-1 ring-line sm:p-8">
            <h3 class="text-lg font-bold">{{ area.region }}</h3>
            <ul class="mt-4 space-y-2.5">
              {% for c in area.counties %}
                <li class="flex items-center gap-2.5 text-[15px] text-ink">{{ icon('check', 'size-4 text-brand-600') }} {{ c }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {{ ui.ctaBand(site) }}
{% endblock %}
