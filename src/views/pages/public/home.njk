{% extends "layouts/public.njk" %}
{% import "partials/ds.njk" as ds %}

{% block mainClass %}ds{% endblock %}

{% block content %}
  {% if announcements.length %}
    <section class="d-news" aria-label="Announcements"><div class="d-wrap">
      {% for a in announcements %}
        <p><strong>{{ a.title }}</strong> — {{ a.body }}{% if a.link_url %} <a href="{{ a.link_url }}" {% if a.link_url.startsWith('https://') %}target="_blank" rel="noopener"{% endif %}>{{ a.link_label or 'Learn more' }} &rarr;</a>{% endif %}</p>
      {% endfor %}
    </div></section>
  {% endif %}

  {% for sec in cms.sections('home', { hero: 'Top banner', glance: 'At a glance', services: 'Services we offer', intro: 'Introducing HLO', refer: 'Referral and support band', contact: 'Contact details' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'hero' %}
    {% set heroImg = cms.image('home.hb.image', 'd-boardwalk', 'Friends on a relaxed walk along a boardwalk, one using a wheelchair') %}
    {% set cta1 = cms.link('home.hb.cta1', 'Ask about services', '/request-services') %}
    {% set cta2 = cms.link('home.hb.cta2', 'Refer someone', '/referrals') %}
    <section class="d-hb">{{ ds.img(heroImg, '(min-width: 900px) 44vw, 100vw', 'class="d-hb-bg"', false) }}<div class="d-wrap">
      <div class="d-hb-copy">
        <span class="d-eyebrow d-eyebrow-bold">{{ cms.text('home.hb.eyebrow', 'We are a licensed Maryland DDA Provider') }}</span>
        <h1>{{ cms.text('home.hb.title', 'Serving adult individuals with intellectual and developmental disabilities in Central & Southern Maryland') }}</h1>
        <p class="d-lead">{{ cms.text('home.hb.intro', 'A place to live, help with daily life, activities in the community, breaks for caregivers, and transportation. Every service is planned around what the individual wants for their life.') }}</p>
        <div class="d-hb-actions">
          <a class="d-btn d-btn-primary" href="{{ cta1.href }}" {{ cta1.attrs }}>{{ cta1.label }}</a>
          <a class="d-btn d-btn-outline-light" href="{{ cta2.href }}" {{ cta2.attrs }}>{{ cta2.label }}</a>
        </div>
      </div>
    </div></section>
    {{ ds.pagenav([
      { id: 'services-offer', label: cms.text('home.nav.services', 'Services') },
      { id: 'introducing', label: cms.text('home.nav.about', 'About us') },
      { id: 'contact-details', label: cms.text('home.nav.contact', 'Contact') }
    ]) }}

  {% elif sec.key == 'glance' %}
    <section class="d-glance-band" aria-labelledby="gc-title"><div class="d-wrap">
      <div class="d-glance-card">
        <h2 class="d-gc-title" id="gc-title">At a glance</h2>
        <dl class="d-glance">
          <div><dt>{{ cms.text('home.glance.whoTitle', 'Who we support') }}</dt><dd>{{ cms.text('home.glance.who', 'Adults with intellectual and developmental disabilities, including autism') }}</dd></div>
          <div><dt>{{ cms.text('home.glance.offerTitle', 'What we offer') }}</dt><dd><ul class="d-offer-list">
            {% for s in design.services %}<li><a href="/services#{{ s.anchor }}">{{ s.name }}</a></li>{% endfor %}
          </ul></dd></div>
          <div><dt>{{ cms.text('home.glance.whereTitle', 'Where we serve') }}</dt><dd>
            <label for="county-check" class="d-sr-only">Choose your county to check whether we serve it</label>
            <select id="county-check" data-county-check data-phone="{{ site.phone }}" data-tel="{{ site.phone | telHref }}">
              <option value="">Check your county…</option>
              {% for c in ['Anne Arundel', 'Baltimore City', 'Baltimore', 'Calvert', 'Charles', 'Harford', 'Howard', 'Montgomery', 'Prince George’s', 'St. Mary’s'] %}
                <option value="{{ c }}">{{ c }}{% if c != 'Baltimore City' %} County{% endif %}</option>
              {% endfor %}
              <option value="Somewhere else">Somewhere else</option>
            </select>
            <p class="d-county-result" id="county-result" role="status" aria-live="polite">{{ cms.text('home.glance.where', 'Anne Arundel, Baltimore City, Baltimore, Calvert, Charles, Harford, Howard, Montgomery, Prince George’s and St. Mary’s.') }}</p>
          </dd></div>
        </dl>
      </div>
    </div></section>

  {% elif sec.key == 'services' %}
    {% set allLink = cms.link('home.offer.all', 'View all services', '/services') %}
    <section class="d-svc-home" id="services-offer"><div class="d-wrap">
      <div class="d-section-head d-center">
        <h2>{{ cms.text('home.offer.title', 'Services We Offer') }}</h2>
        <p>{{ cms.text('home.offer.intro', 'Six services, each planned around the individual’s own plan and delivered at home and out in the community. Choose a service to read more.') }}</p>
      </div>
      <div class="d-svc-list">
        {% for s in cms.list('home.offer.items', design.cards) %}
          {% set photo = s.image('photo', s.alt) %}
          <div class="d-svc" {{ s.attrs }}>
            <div class="d-svc-img">{{ ds.img(photo, '(min-width: 1000px) 30vw, (min-width: 620px) 50vw, 100vw') }}</div>
            <div class="d-svc-body">
              <h3>{{ s.text('name') }}</h3>
              <p class="d-svc-desc">{{ s.text('summary') }}</p>
              <a class="d-btn d-btn-primary d-btn-sm" href="{{ s.href }}" {{ s.hrefAttrs }}>Learn more<span class="d-sr-only"> about {{ s.name }}</span></a>
            </div>
          </div>
        {% endfor %}
      </div>
      <p><a class="d-btn d-btn-ghost" href="{{ allLink.href }}" {{ allLink.attrs }}>{{ allLink.label }}</a></p>
    </div></section>

  {% elif sec.key == 'intro' %}
    {% set introImg = cms.image('home.intro.image', 'd-friends-waterfront', 'Friends enjoying time together outdoors by the waterfront') %}
    {% set aboutLink = cms.link('home.intro.cta', 'About us', '/about') %}
    <section class="d-intro-simple" id="introducing"><div class="d-wrap">
      <div class="d-is-text">
        <h2>{{ cms.text('home.intro.title', 'Introducing Healthy Living Option Inc.') }}</h2>
        {{ cms.rich('home.intro.text', 'We support each individual’s rights, choices and dignity. Our approach is person-centered: the individual leads, and our trained staff support them to reach the goals they set.\n\nOur services meet individuals’ needs today and help prepare them for independence and a full life, at home in a comfortable apartment and out in the community.') }}
        <p class="d-is-mission"><strong>{{ cms.text('home.intro.missionLabel', 'Our mission:') }}</strong> {{ cms.text('home.intro.mission', 'to support adults with developmental disabilities to live independent, self-directed lives, with community inclusion as a choice.') }}</p>
        <a class="d-btn d-btn-dark" href="{{ aboutLink.href }}" {{ aboutLink.attrs }}>{{ aboutLink.label }}</a>
      </div>
      <div class="d-intro-photo">{{ ds.img(introImg, '(min-width: 900px) 45vw, 100vw') }}</div>
    </div></section>

  {% elif sec.key == 'refer' %}
    {% set referLink = cms.link('home.refer.cta', 'Refer someone', '/referrals') %}
    {% set askLink = cms.link('home.support.cta', 'Ask about services', '/request-services') %}
    <section class="d-refer-band" aria-label="Get started"><div class="d-wrap">
      <aside class="d-refer-card">
        <h3>{{ cms.text('home.refer.title', 'Send Your Referrals') }}</h3>
        <p>{{ cms.text('home.refer.text', 'Take the time to send a referral. It allows us to help more individuals who require our special assistance. Information is kept strictly confidential.') }}</p>
        <a class="d-btn d-btn-primary" href="{{ referLink.href }}" {{ referLink.attrs }}>{{ referLink.label }}</a>
      </aside>
      <aside class="d-refer-card d-navy">
        <h3>{{ cms.text('home.support.title', 'Looking for Support?') }}</h3>
        <p>{{ cms.text('home.support.text', 'Tell us a little about the individual who needs support and we will reach out to talk through the options. You do not need every answer ready.') }}</p>
        <a class="d-btn d-btn-primary" href="{{ askLink.href }}" {{ askLink.attrs }}>{{ askLink.label }}</a>
      </aside>
    </div></section>

  {% elif sec.key == 'contact' %}
    <section class="d-alt" id="contact-details"><div class="d-wrap d-cd">
      <div>
        <h2>{{ cms.text('home.cd.title', 'Contact Details') }}</h2>
        <p class="d-lede">{{ cms.text('home.cd.intro', 'Stop by, call or write. We serve Central Maryland and the Southern Region, across nine counties and Baltimore City.') }}</p>
        {% include "partials/ds-contact-list.njk" %}
      </div>
      {{ ds.map(site) }}
    </div></section>
  {% endif %}
  </div>
  {% endfor %}

  {{ ds.pager(design.pageOrder, '/') }}
{% endblock %}
