{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% if announcements.length %}
    <section aria-label="Announcements" class="bg-accent-700 text-white">
      <div class="container-page py-3">
        {% for a in announcements %}
          <div class="flex items-start gap-3 py-0.5 text-[15px]">
            {{ icon('megaphone', 'mt-0.5 size-5 shrink-0') }}
            <p><strong class="font-semibold">{{ a.title }}</strong> <span class="text-accent-50">— {{ a.body }}</span>{% if a.link_url %} <a href="{{ a.link_url }}" class="font-semibold whitespace-nowrap text-white underline decoration-white/50 underline-offset-4 hover:decoration-white" {% if a.link_url.startsWith('https://') %}target="_blank" rel="noopener"{% endif %}>{{ a.link_label or 'Learn more' }} &rarr;</a>{% endif %}</p>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Hero #}
  <section class="bg-cream">
    <div class="container-page grid items-center gap-8 py-8 sm:gap-12 sm:py-16 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:py-24">
      <div>
        <p class="eyebrow">{{ page.eyebrow }}</p>
        <h1 class="mt-5 text-4xl leading-[1.08] font-extrabold sm:text-5xl xl:text-6xl">{{ page.title }}</h1>
        <p class="mt-6 max-w-xl text-lg text-muted sm:text-xl">{{ page.intro }}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/getting-started" class="btn-primary">Start intake {{ icon('arrow-right', 'size-4') }}</a>
          <a href="/services" class="btn-secondary">Explore our services</a>
        </div>
        <div class="mt-10 flex items-center gap-4 border-t border-line pt-6">
          <a href="{{ site.phone | telHref }}" class="grid size-12 shrink-0 place-items-center rounded-full bg-brand-700 text-white hover:bg-brand-800">
            {{ icon('phone', 'size-5') }}<span class="sr-only">Call {{ site.phone }}</span>
          </a>
          <p class="text-[15px] leading-snug text-muted">
            Questions? Call us at <a href="{{ site.phone | telHref }}" class="font-semibold text-ink hover:text-brand-700">{{ site.phone }}</a><br>
            {{ site.hours }}
          </p>
        </div>
      </div>

      <div class="relative order-first mb-4 lg:order-last lg:mb-0">
        <img src="/img/photos/hero-support.webp" srcset="/img/photos/hero-support-sm.webp 560w, /img/photos/hero-support.webp 960w"
             sizes="(min-width: 1024px) 50vw, 100vw" width="960" height="640" fetchpriority="high"
             alt="A support worker and a smiling woman holding hands during a conversation"
             class="photo aspect-[4/3] object-[30%_center] shadow-lift lg:aspect-[4/3.4]">
        <div class="absolute -bottom-6 left-4 hidden max-w-[17rem] rounded-2xl bg-brand-800 p-5 text-white shadow-lift sm:block lg:-left-6">
          <p class="flex items-center gap-2 font-display font-bold">{{ icon('heart', 'size-5 text-accent-500') }} Person-centered</p>
          <p class="mt-1.5 text-sm text-brand-100">Support built around each person’s goals, choices and plan.</p>
        </div>
      </div>
    </div>
  </section>

  {# Key facts #}
  <section class="border-y border-brand-800 bg-brand-900 text-white">
    <h2 class="sr-only">HLO at a glance</h2>
    <dl class="container-page grid grid-cols-2 gap-y-6 py-8 lg:grid-cols-4">
      {% for f in [
        { v: '10', l: 'Maryland counties served' },
        { v: '5', l: 'Community-based services' },
        { v: 'DDA', l: 'Approved & licensed services' },
        { v: '9–5', l: 'Office open Monday to Friday' }
      ] %}
        <div class="flex flex-col-reverse px-2 lg:border-l lg:border-white/15 lg:px-8 lg:first:border-l-0 lg:first:pl-0">
          <dt class="mt-1 text-sm text-brand-200">{{ f.l }}</dt>
          <dd class="font-display text-3xl font-extrabold text-white">{{ f.v }}</dd>
        </div>
      {% endfor %}
    </dl>
  </section>

  {# Services #}
  <section class="section">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        {{ ui.sectionHeading('What we offer', 'Supports shaped around each person', 'Every service follows the person’s own plan and goals, and adapts as they grow.') }}
        <a href="/services" class="btn-secondary shrink-0">View all services</a>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for s in services %}
          <li class="{{ 'lg:col-span-2' if loop.first }}">
            <a href="/services/{{ s.slug }}" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-white shadow-soft transition hover:-translate-y-0.5 hover:shadow-lift">
              <div class="aspect-[16/9] overflow-hidden {{ 'lg:aspect-[21/9]' if loop.first }}">
                <img src="/img/photos/{{ s.slug }}-sm.webp" srcset="/img/photos/{{ s.slug }}-sm.webp 560w, /img/photos/{{ s.slug }}.webp 960w"
                     sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" alt="" loading="lazy" width="560" height="373"
                     class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <h3 class="text-xl font-bold group-hover:text-brand-700">{{ s.name }}</h3>
                <p class="mt-2 flex-1 text-muted">{{ s.summary }}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-[15px] font-semibold text-accent-600">
                  Learn more <span class="sr-only">about {{ s.name }}</span> {{ icon('arrow-right', 'size-4 transition group-hover:translate-x-1') }}
                </span>
              </div>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# Approach #}
  <section class="section bg-brand-50">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2">
      <div class="relative order-last lg:order-first">
        <img src="/img/photos/approach.webp" srcset="/img/photos/approach-sm.webp 560w, /img/photos/approach.webp 960w"
             sizes="(min-width: 1024px) 50vw, 100vw" width="960" height="640" loading="lazy"
             alt="A support worker kneeling to talk with a woman using a wheelchair"
             class="photo aspect-[5/4] shadow-lift">
        <div class="absolute -top-5 -right-3 rounded-2xl bg-accent-600 px-5 py-4 text-white shadow-lift sm:-right-6">
          <p class="font-display text-2xl font-extrabold">Dignity</p>
          <p class="text-sm text-accent-50">in every interaction</p>
        </div>
      </div>
      <div>
        <p class="eyebrow">Our approach</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">{{ page.approachTitle }}</h2>
        <p class="mt-5 text-lg text-muted">{{ page.approach }}</p>
        <ol class="mt-8 space-y-5">
          {% for step in [
            { t: 'We listen', d: 'We get to know the person, their family and what matters to them.' },
            { t: 'We plan together', d: 'Support follows the person-centered plan agreed with their coordinator.' },
            { t: 'We support and grow', d: 'Trained staff support day to day, and we adjust as goals change.' }
          ] %}
            <li class="flex gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-full {{ 'bg-accent-600' if loop.index == 2 else 'bg-brand-700' }} font-display font-bold text-white">{{ loop.index }}</span>
              <div>
                <h3 class="text-lg font-bold">{{ step.t }}</h3>
                <p class="mt-0.5 text-muted">{{ step.d }}</p>
              </div>
            </li>
          {% endfor %}
        </ol>
        <a href="/about" class="btn-green mt-9">More about HLO</a>
      </div>
    </div>
  </section>

  {# Quick paths (requirements §3: Services, Location, Careers, Contact) #}
  <section class="section">
    <div class="container-page">
      {{ ui.sectionHeading('Find your way', 'How can we help today?', null, true) }}
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {% for p in [
          { href: '/getting-started', icon: 'heart', title: 'Start intake', text: 'How to begin services with HLO, step by step.', red: true },
          { href: '/service-areas', icon: 'map-pin', title: 'Location & areas', text: 'Our Catonsville office and the 10 counties we serve.' },
          { href: '/careers', icon: 'briefcase', title: 'Careers', text: 'Join a team that puts people first.', red: true },
          { href: '/contact', icon: 'chat', title: 'Contact us', text: 'Call, email, visit or send us a message.' }
        ] %}
          <li>
            <a href="{{ p.href }}" class="card card-hover group flex h-full flex-col !p-6">
              <span class="{{ 'icon-tile-red' if p.red else 'icon-tile' }}">{{ icon(p.icon, 'size-6') }}</span>
              <span class="mt-5 flex items-center justify-between font-display text-lg font-bold text-ink">
                {{ p.title }} {{ icon('arrow-right', 'size-5 text-muted transition group-hover:translate-x-1 group-hover:text-accent-600') }}
              </span>
              <span class="mt-1.5 text-[15px] text-muted">{{ p.text }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# Service areas #}
  <section class="section pt-0">
    <div class="container-page">
      <div class="grid overflow-hidden rounded-[2rem] bg-brand-900 text-white lg:grid-cols-2">
        <div class="relative min-h-64">
          <img src="/img/photos/service-areas.webp" srcset="/img/photos/service-areas-sm.webp 560w, /img/photos/service-areas.webp 960w"
               sizes="(min-width: 1024px) 50vw, 100vw" width="960" height="540" loading="lazy"
               alt="A green, tree-lined park on a sunny day" class="absolute inset-0 h-full w-full object-cover">
        </div>
        <div class="p-8 sm:p-12">
          <p class="eyebrow !text-accent-100 before:!bg-accent-500">Where we work</p>
          <h2 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">Serving Central and Southern Maryland</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2">
            {% for area in areas %}
              <div>
                <h3 class="font-bold text-white">{{ area.region }}</h3>
                <ul class="mt-3 space-y-2 text-[15px] text-brand-100">
                  {% for c in area.counties %}
                    <li class="flex items-center gap-2">{{ icon('check', 'size-4 text-brand-300') }} {{ c }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>
          <a href="/service-areas" class="btn-light mt-9">Service areas &amp; office {{ icon('arrow-right', 'size-4') }}</a>
        </div>
      </div>
    </div>
  </section>

  {{ ui.ctaBand(site) }}
{% endblock %}
