{% extends "layouts/public.njk" %}
{% import "partials/ds.njk" as ds %}

{% block mainClass %}ds{% endblock %}

{% block content %}
  {{ ds.pageHead('About', cms.text('about.head.title', 'About Us'), cms.text('about.head.intro', 'Who we are, what we believe, and where we serve.')) }}
  {{ ds.pagenav([
    { id: 'who', label: cms.text('about.nav.who', 'Who we are') },
    { id: 'leadership', label: cms.text('about.nav.leadership', 'Leadership') },
    { id: 'apply', label: cms.text('about.nav.apply', 'How to apply') },
    { id: 'service-area', label: cms.text('about.nav.area', 'Service area') }
  ]) }}

  {% for sec in cms.sections('about', { who: 'Who we are', leadership: 'Leadership', apply: 'How to get started', area: 'Where we serve' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'who' %}
    {% set aboutImg = cms.image('about.who.image', 'd-team-wheelchair', 'Two smiling support staff standing behind a young man in a wheelchair') %}
    <section id="who"><div class="d-wrap d-split d-top">
      <div>
        <h2>{{ cms.text('about.who.title', 'Compassionate, person-centered care') }}</h2>
        {{ cms.rich('about.who.text', 'We support each individual’s rights, choices and dignity. Our approach is person-centered: the individual leads, and our trained staff support them to reach the goals they set.\n\nOur services meet individuals’ needs today and help prepare them for independence and a full life.\n\nEach person’s supports start with a plan they help write, called a Person-Centered Plan, and are carried out through a Provider Implementation Plan (PIP) that we write. Support happens in comfortable, furnished apartment homes and out in the community.') }}
        {% for st in cms.list('about.who.statements', [
          { title: 'Mission statement', text: 'Healthy Living Option Inc. supports adults with intellectual and developmental disabilities to live independent, self-directed lives, with community inclusion as a choice. In everything we do, we honor each individual’s rights, respect their choices, and treat them with dignity.' },
          { title: 'Vision statement', text: 'We envision a community where every adult we serve is seen for who they are, supported to reach their goals, and welcomed as a valued neighbor. Through person-centered care and community integration, we help individuals build the lives they want and become all they can be.' }
        ]) %}
          <div class="d-statement" {{ st.attrs }}><h3>{{ st.text('title') }}</h3><p>{{ st.text('text') }}</p></div>
        {% endfor %}
      </div>
      <div>
        <div class="d-photo d-photo-gap">{{ ds.img(aboutImg, '(min-width: 900px) 40vw, 100vw', 'class="d-pos-45"') }}</div>
        <div class="d-aside-card d-facts">
          <h3>{{ cms.text('about.glance.title', 'HLO at a glance') }}</h3>
          <dl>
            {% for g in cms.list('about.glance.rows', [
              { label: 'Provider', value: 'Maryland DDA provider' },
              { label: 'Region', value: 'Central Maryland and Southern Region' },
              { label: 'Counties', value: 'Nine Maryland counties and Baltimore City' }
            ]) %}<dt {{ g.attrs }}>{{ g.text('label') }}</dt><dd>{{ g.text('value') }}</dd>{% endfor %}
            <dt>Hours</dt><dd>{{ site.hours }}</dd>
            <dt>Phone</dt><dd><a href="{{ site.phone | telHref }}">{{ site.phone }}</a></dd>
            <dt>Fax</dt><dd>{{ cms.text('site.fax', '(410) 553-4151') }}</dd>
          </dl>
        </div>
      </div>
    </div></section>

  {% elif sec.key == 'leadership' %}
    <section id="leadership"><div class="d-wrap">
      <div class="d-section-head"><h2>{{ cms.text('about.lead.title', 'Who leads HLO') }}</h2></div>
      {% for p in cms.list('about.lead.people', [
        { initials: 'SO', role: 'Chief Executive Officer', name: 'Dr. Sam Odedokun', text: 'Dr. Odedokun leads Healthy Living Option Inc. Questions about our approach, or about how we work with families and coordinators, are always welcome. Call (410) 874-8551.' }
      ]) %}
        <div class="d-leader" {{ p.attrs }}><span class="d-mono" aria-hidden="true">{{ p.text('initials') }}</span><div><span class="d-role">{{ p.text('role') }}</span><h3>{{ p.text('name') }}</h3><p>{{ p.text('text') }}</p></div></div>
      {% endfor %}
    </div></section>

  {% elif sec.key == 'apply' %}
    {% set ask = cms.link('about.apply.cta1', 'Ask about services', '/request-services') %}
    {% set refer = cms.link('about.apply.cta2', 'Refer someone', '/referrals') %}
    <section class="d-alt" id="apply"><div class="d-wrap">
      <div class="d-section-head"><h2>{{ cms.text('about.apply.title', 'How to get started') }}</h2>
        <p>{{ cms.text('about.apply.intro', 'You do not need every answer ready. Contact us and we will guide you through each step.') }}</p></div>
      <div class="d-steps">
        {% for st in cms.list('about.apply.steps', [
          { title: 'Contact us', text: 'Submit the request form or call (410) 874-8551. Referrals from coordinators, agencies, and families are welcome.' },
          { title: 'Talk with our team', text: 'We learn about the individual’s goals, needs, and preferences, and explain which of our services may fit.' },
          { title: 'Plan the next steps together', text: 'We coordinate with the individual, family, and Coordinator of Community Services to align services with the Person-Centered Plan and write the Provider Implementation Plan (PIP).' }
        ]) %}
          <div class="d-step" {{ st.attrs }}><h3>{{ st.text('title') }}</h3><p>{{ st.text('text') }}</p></div>
        {% endfor %}
      </div>
      <p class="d-mt-30 d-acts-inline"><a class="d-btn d-btn-primary" href="{{ ask.href }}" {{ ask.attrs }}>{{ ask.label }}</a><a class="d-btn d-btn-ghost" href="{{ refer.href }}" {{ refer.attrs }}>{{ refer.label }}</a></p>
    </div></section>

  {% elif sec.key == 'area' %}
    <section id="service-area"><div class="d-wrap">
      <h2>{{ cms.text('about.area.title', 'Where we serve') }}</h2>
      <dl class="d-region"><dt>{{ cms.text('about.area.regionLabel', 'DDA regions:') }}</dt><dd>{{ cms.text('about.area.regions', 'Central Maryland and Southern Region') }}</dd></dl>
      <p class="d-mt-14">{{ cms.text('about.area.countiesLabel', 'Counties served:') }}</p>
      <ul class="d-counties">{% for c in cms.list('about.area.counties', design.counties | listOf('name')) %}<li {{ c.attrs }}>{{ c.text('name') }}</li>{% endfor %}</ul>
    </div></section>
  {% endif %}
  </div>
  {% endfor %}

  {{ ds.pager(design.pageOrder, '/about') }}
{% endblock %}
