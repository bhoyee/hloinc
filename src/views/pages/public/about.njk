{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {% for sec in cms.sections('about', { hero: 'Top banner', mission: 'Mission & vision', values: 'Our values', support: 'Who we support', cta: 'Call to action' }) %}
  <div {{ sec.attrs }}>
  {% if sec.key == 'hero' %}
    {{ ui.pageHero(cms.text('about.hero.eyebrow', 'About HLO'), cms.text('about.hero.title', 'People first, in everything we do'), cms.text('about.hero.intro', page.intro), [{ label: 'About' }], cms.image('about.hero.image', 'about-team', 'Three team members talking and laughing together')) }}

  {% elif sec.key == 'mission' %}
    <section class="section">
      <div class="container-page grid gap-6 md:grid-cols-2">
        {% for item in cms.list('about.mission.cards', [
          { title: 'Our mission', text: page.mission, icon: 'heart' },
          { title: 'Our vision', text: page.vision, icon: 'sun' }
        ]) %}
          {% set red = loop.index is even %}
          {% set bar = 'bg-accent-600' if red else 'bg-brand-600' %}
          <article class="reveal group relative overflow-hidden rounded-3xl border border-line bg-white p-7 shadow-soft transition duration-300 hover:-translate-y-1.5 hover:border-transparent hover:shadow-lift sm:p-10" {{ item.attrs }}>
            <span class="absolute inset-x-0 top-0 h-1.5 origin-left scale-x-0 {{ bar }} transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
            <span class="pointer-events-none absolute -right-6 -bottom-8 opacity-[0.06] transition duration-500 group-hover:scale-110 group-hover:opacity-[0.1] {{ 'text-accent-600' if red else 'text-brand-700' }}" aria-hidden="true">{{ icon(item.icon or 'heart', 'size-44') }}</span>
            <span class="grid size-14 place-items-center rounded-2xl ring-1 transition duration-300 {{ 'bg-accent-50 text-accent-600 ring-accent-100 group-hover:bg-accent-600' if red else 'bg-brand-50 text-brand-700 ring-brand-100 group-hover:bg-brand-700' }} group-hover:text-white group-hover:ring-transparent">
              {{ icon(item.icon or 'heart', 'size-7') }}
            </span>
            <h2 class="relative mt-6 text-2xl font-bold sm:text-3xl">{{ item.text('title') }}</h2>
            <p class="relative mt-4 text-lg leading-relaxed text-muted">{{ item.text('text') }}</p>
          </article>
        {% endfor %}
      </div>
    </section>

  {% elif sec.key == 'values' %}
    <section class="section bg-cream">
      <div class="container-page">
        {{ ui.sectionHeading(cms.text('about.values.eyebrow', 'Our values'), cms.text('about.values.title', 'What guides our work'), null, true) }}
        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {% for v in cms.list('about.values.items', page.values) %}
            {% set red = loop.index is odd %}
            <li class="reveal group relative overflow-hidden rounded-3xl border border-line bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1.5 hover:shadow-lift sm:p-7 {{ 'hover:border-accent-600 hover:bg-accent-600' if red else 'hover:border-brand-700 hover:bg-brand-700' }}" {{ v.attrs }}>
              {# Decorative watermark drawn by CSS, so it isn't text for screen readers or contrast checks. #}
              <span data-n="0{{ loop.index }}" class="absolute -top-4 -right-2 font-display text-8xl font-extrabold opacity-[0.07] transition duration-300 before:content-[attr(data-n)] group-hover:text-white group-hover:opacity-15 {{ 'text-accent-600' if red else 'text-brand-700' }}" aria-hidden="true"></span>
              <span class="font-display text-3xl font-extrabold transition-colors duration-300 group-hover:text-white {{ 'text-accent-600' if red else 'text-brand-600' }}" aria-hidden="true">0{{ loop.index }}</span>
              <span class="mt-3 block h-1 w-10 rounded-full transition-all duration-300 group-hover:w-16 group-hover:bg-white/70 {{ 'bg-accent-500' if red else 'bg-brand-500' }}" aria-hidden="true"></span>
              <h3 class="mt-4 text-xl font-bold transition-colors duration-300 group-hover:text-white">{{ v.text('name') }}</h3>
              <p class="mt-2 text-[15px] text-muted transition-colors duration-300 group-hover:text-white/90">{{ v.text('text') }}</p>
            </li>
          {% endfor %}
        </ul>
      </div>
    </section>

  {% elif sec.key == 'support' %}
    {% set friendsImg = cms.image('about.support.image', { src: '/img/photos/about-friends.webp', srcSm: '/img/photos/about-friends-sm.webp', w: 960, h: 1313, alt: 'Two friends sitting together and smiling outdoors' }) %}
    <section id="who-we-support" class="section">
      <div class="container-page">
        <div class="grid gap-4 lg:grid-cols-[1fr_1.3fr] lg:items-end lg:gap-12">
          <div>
            <p class="eyebrow">{{ cms.text('about.support.eyebrow', 'Who we support') }}</p>
            <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">{{ cms.text('about.support.title', 'Adults with intellectual and developmental disabilities') }}</h2>
          </div>
          <p class="text-lg text-muted lg:pb-1">{{ cms.text('about.support.intro', 'We support adults with a wide range of support needs. Every person’s support is shaped around their own goals, choices and plan, including people with:') }}</p>
        </div>

        <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-[1fr_1.3fr] lg:gap-12">
          <div class="reveal relative aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[28rem]">
            <img src="{{ friendsImg.srcSm }}" srcset="{{ friendsImg.srcset }}" sizes="(min-width: 1024px) 40vw, 100vw" width="560" height="766" loading="lazy"
                 alt="{{ friendsImg.alt }}" class="absolute inset-0 h-full w-full rounded-3xl object-cover object-[center_30%] shadow-lift" {{ friendsImg.attrs }}>
            <div class="absolute right-4 bottom-4 left-4 rounded-2xl bg-white/95 p-4 shadow-lift backdrop-blur sm:right-auto sm:max-w-xs">
              <p class="flex items-center gap-2 font-display font-bold text-ink">{{ icon('heart', 'size-5 text-accent-600') }} {{ cms.text('about.support.badgeTitle', 'Every person, their own plan') }}</p>
              <p class="mt-1 text-sm text-muted">{{ cms.text('about.support.badgeText', 'Support that follows each person’s goals and choices.') }}</p>
            </div>
          </div>

          <div class="flex flex-col">
            <ul class="grid flex-1 content-start gap-3 sm:grid-cols-2">
              {% for need in cms.list('about.support.needs', cms.objects(page.supportNeeds)) %}
                {% set red = loop.index is odd %}
                <li class="group flex items-center gap-3 rounded-2xl border border-line bg-surface px-4 py-3.5 text-ink transition duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-soft {{ 'hover:border-accent-200' if red else 'hover:border-brand-300' }}" {{ need.attrs }}>
                  <span class="grid size-8 shrink-0 place-items-center rounded-full transition duration-200 {{ 'bg-accent-50 text-accent-600 group-hover:bg-accent-600' if red else 'bg-brand-50 text-brand-700 group-hover:bg-brand-700' }} group-hover:text-white">
                    {{ icon('check', 'size-4') }}
                  </span>
                  <span class="font-medium">{{ need.text('label') }}</span>
                </li>
              {% endfor %}
            </ul>
            <p class="mt-6 flex gap-3 rounded-2xl border border-brand-200 bg-brand-50 p-4 text-[15px] text-brand-900">
              {{ icon('info', 'mt-0.5 size-5 shrink-0') }} <span>{{ cms.text('about.support.note', page.eligibilityNote) }}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

  {% elif sec.key == 'cta' %}
    {{ ui.ctaBand(site) }}
  {% endif %}
  </div>
  {% endfor %}
{% endblock %}
