{% extends "layouts/public.njk" %}
{% import "partials/ui.njk" as ui %}

{% block content %}
  {{ ui.pageHero('About HLO', 'People first, in everything we do', page.intro, [{ label: 'About' }], 'about-team', 'Three team members talking and laughing together') }}

  <section class="section">
    <div class="container-page grid gap-6 lg:grid-cols-2">
      <div class="card bg-gradient-to-br from-brand-50 to-white">
        <span class="icon-tile">{{ icon('heart', 'size-6') }}</span>
        <h2 class="mt-6 text-2xl font-bold">Our mission</h2>
        <p class="mt-3 text-lg text-muted">{{ page.mission }}</p>
      </div>
      <div class="card">
        <span class="icon-tile-red">{{ icon('sun', 'size-6') }}</span>
        <h2 class="mt-6 text-2xl font-bold">Our vision</h2>
        <p class="mt-3 text-lg text-muted">{{ page.vision }}</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-page">
      {{ ui.sectionHeading('Our values', 'What guides our work', null, true) }}
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {% for v in page.values %}
          <li class="card !p-6">
            <span class="font-display text-3xl font-extrabold {{ 'text-accent-600' if loop.index is odd else 'text-brand-600' }}" aria-hidden="true">0{{ loop.index }}</span>
            <h3 class="mt-3 text-xl font-bold">{{ v.name }}</h3>
            <p class="mt-2 text-[15px] text-muted">{{ v.text }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="eyebrow">Who we support</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Adults with intellectual and developmental disabilities</h2>
        <p class="mt-5 text-lg text-muted">We support adults with a wide range of support needs, including:</p>
        <img src="/img/photos/about-friends-sm.webp" srcset="/img/photos/about-friends-sm.webp 560w, /img/photos/about-friends.webp 960w"
             sizes="(min-width: 1024px) 35vw, 100vw" width="560" height="766" loading="lazy"
             alt="Two friends sitting together and smiling outdoors" class="photo mt-8 hidden aspect-[4/5] shadow-soft lg:block">
      </div>
      <div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {% for need in page.supportNeeds %}
            <li class="flex items-center gap-3 rounded-2xl bg-surface px-4 py-3 text-ink ring-1 ring-line">
              {{ icon('check', 'size-4 shrink-0 text-brand-600') }} {{ need }}
            </li>
          {% endfor %}
        </ul>
        <p class="mt-6 flex gap-3 rounded-2xl border border-brand-200 bg-brand-50 p-4 text-[15px] text-brand-900">
          {{ icon('info', 'mt-0.5 size-5 shrink-0') }} {{ page.eligibilityNote }}
        </p>
      </div>
    </div>
  </section>

  {{ ui.ctaBand(site) }}
{% endblock %}
