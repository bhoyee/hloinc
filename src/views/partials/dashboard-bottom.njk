{# Recent activity, staff account security, your account and your next shift. Refreshed live. #}
  <div class="mt-8 grid gap-4 lg:grid-cols-[1.5fr_1fr] lg:gap-5">
    {% if recentActivity.length %}
      <section class="rounded-3xl border border-line bg-white p-6 shadow-soft {{ 'lg:row-span-3' if staffSecurity else 'lg:row-span-2' }}">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold">Recent activity</h2>
          <a href="/portal/audit" class="text-sm font-semibold text-brand-700 hover:text-brand-800">Full audit log &rarr;</a>
        </div>
        <ul class="mt-4 divide-y divide-line">
          {% for e in recentActivity %}
            <li class="flex items-start justify-between gap-4 py-3">
              <p class="text-[15px] text-ink">{{ e.summary or e.action }}</p>
              <time class="shrink-0 text-sm text-muted">{{ e.created_at | date({ month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) }}</time>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% else %}
      <section class="rounded-3xl border border-line bg-white p-6 shadow-soft {{ 'lg:row-span-3' if staffSecurity else 'lg:row-span-2' }}">
        <h2 class="text-lg font-bold">Welcome to the staff portal</h2>
        <p class="mt-2 text-muted">Use the menu on the left to reach the areas your role can use, or search from the bar at the top.</p>
      </section>
    {% endif %}

    <section class="rounded-3xl border border-line bg-white p-6 shadow-soft">
      <h2 class="text-lg font-bold">Your account security</h2>
      <ul class="mt-4 space-y-3 text-[15px]">
        <li class="flex items-center gap-3">
          {% if user.twoStepOff %}
            <span class="grid size-8 place-items-center rounded-full bg-surface text-muted ring-1 ring-line">{{ icon('info', 'size-4') }}</span>
            <span>Two-step sign-in is switched off for everyone{% if can('security.edit') %} · <a href="/portal/settings/security" class="link">Security settings</a>{% endif %}</span>
          {% elif security.mfaEnabled %}
            <span class="grid size-8 place-items-center rounded-full bg-brand-100 text-brand-800">{{ icon('check', 'size-4') }}</span>
            <span>Two-step sign-in is on · {{ security.recoveryLeft }} recovery codes left</span>
          {% else %}
            <span class="grid size-8 place-items-center rounded-full bg-amber-100 text-amber-900">{{ icon('exclamation', 'size-4') }}</span>
            <span>Two-step sign-in is off. <a href="/portal/account/two-step" class="link">Turn it on</a></span>
          {% endif %}
        </li>
        <li class="flex items-center gap-3">
          <span class="hidden size-8 shrink-0 place-items-center rounded-full bg-surface sm:grid text-muted ring-1 ring-line">{{ icon('clock', 'size-4') }}</span>
          <span>Previous sign-in: {{ previousLogin | date({ month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) if previousLogin else 'this is your first' }}</span>
        </li>
      </ul>
      <a href="/portal/account" class="btn-secondary mt-5 w-full">Manage my account</a>
    </section>

    {% if staffSecurity %}
      {% set sec = staffSecurity %}
      {% set problems = sec.noTwoStep.length + sec.locked.length + sec.invited.length %}
      <section class="rounded-3xl border border-line bg-white p-6 shadow-soft" aria-labelledby="staffsec-h">
        <div class="flex items-center justify-between gap-3">
          <h2 id="staffsec-h" class="text-lg font-bold">Staff account security</h2>
          <a href="/portal/accounts" class="text-sm font-semibold text-brand-700 hover:text-brand-800">Accounts &rarr;</a>
        </div>
        {% if not problems %}
          <p class="mt-4 flex items-center gap-3 rounded-2xl bg-brand-50/70 p-3 text-[15px] text-ink ring-1 ring-brand-100">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand-700 text-white">{{ icon('check', 'size-4') }}</span>
            Everyone is set up, nobody is locked out and no invites are waiting.
          </p>
        {% else %}
          <ul class="mt-4 space-y-2">
            {% for row in [
              { list: sec.noTwoStep, key: 'mfa', icon: 'lock', tone: 'red' if (sec.noTwoStep | selectattr('required') | length) else 'amber',
                title: (sec.noTwoStep.length ~ (' person has' if sec.noTwoStep.length == 1 else ' people have') ~ ' not set up two-step sign-in'),
                hint: ('People marked “required” will be asked to set it up at their next sign-in.' if sec.twoStepOn else 'Two-step sign-in is switched off for everyone right now, so nobody is asked to set it up.') },
              { list: sec.locked, key: 'locked', icon: 'exclamation', tone: 'red',
                title: (sec.locked.length ~ (' account is' if sec.locked.length == 1 else ' accounts are') ~ ' locked after failed sign-ins'), hint: 'They unlock on their own, or reset access from the account page.' },
              { list: sec.invited, key: 'invites', icon: 'mail', tone: 'amber',
                title: (sec.invited.length ~ (' invite has' if sec.invited.length == 1 else ' invites have') ~ ' not been accepted'), hint: 'Open the account to resend an invite that has run out.' }
            ] %}
              {% if row.list.length %}
                <li>
                  <details class="group/sec rounded-2xl ring-1 {{ 'bg-accent-50/60 ring-accent-100' if row.tone == 'red' else 'bg-amber-50 ring-amber-100' }}">
                    <summary class="flex cursor-pointer list-none items-center gap-3 p-3">
                      <span class="grid size-8 shrink-0 place-items-center rounded-lg text-white {{ 'bg-accent-600' if row.tone == 'red' else 'bg-amber-500' }}">{{ icon(row.icon, 'size-4') }}</span>
                      <span class="min-w-0 flex-1 text-[15px] leading-snug font-semibold text-ink">{{ row.title }}</span>
                      <span class="shrink-0 text-muted transition group-open/sec:rotate-90" aria-hidden="true">{{ icon('chevron-right', 'size-4') }}</span>
                    </summary>
                    <div class="px-3 pb-3">
                      <p class="text-sm text-muted">{{ row.hint }}</p>
                      <ul class="mt-2 flex flex-wrap gap-1.5">
                        {% for u in row.list %}{% if loop.index <= 12 %}
                          <li><a href="{{ u.href }}" class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-sm font-medium text-ink ring-1 ring-line hover:text-brand-700 hover:ring-brand-200">
                            {{ u.name }}
                            {% if row.key == 'mfa' and u.required %}<span class="text-xs font-semibold text-accent-700">· required</span>{% endif %}
                            {% if row.key == 'locked' %}<span class="text-xs text-muted">· until {{ u.until }}</span>{% endif %}
                            {% if row.key == 'invites' %}<span class="text-xs {{ 'font-semibold text-accent-700' if u.expired else 'text-muted' }}">· {{ 'link expired' if u.expired else 'pending' }}</span>{% endif %}
                          </a></li>
                        {% endif %}{% endfor %}
                        {% if row.list.length > 12 %}<li class="px-1 py-1 text-sm text-muted">and {{ row.list.length - 12 }} more</li>{% endif %}
                      </ul>
                    </div>
                  </details>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endif %}

    <section class="rounded-3xl border border-line bg-white p-6 shadow-soft" aria-labelledby="shift-h">
      <h2 id="shift-h" class="text-lg font-bold">My next shift</h2>
      {% if nextShift %}
        <p class="mt-3 font-display text-xl font-bold text-ink">{{ nextShift.start_at | dateTime }}</p>
        <p class="text-[15px] text-muted">{{ 'Time off' if nextShift.kind == 'time_off' else (nextShift.label or 'Shift') }}{% if nextShift.location %} · {{ nextShift.location }}{% endif %} · until {{ nextShift.end_at | time }}</p>
      {% else %}
        <p class="mt-2 text-[15px] text-muted">Nothing scheduled.</p>
      {% endif %}
      <a href="/portal/schedule?view=mine" class="btn-secondary mt-5 w-full">My schedule</a>
    </section>
  </div>
