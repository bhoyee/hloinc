{# "Needs attention" and "Today at HLO". Rendered with the dashboard, and again on its own
   (GET /portal/dashboard/panels) when the live refresh sees something has changed. #}
{% set showAttention = panels.attention.length or can('messages.view') or can('messages.view_intake') or can('appointments.view') %}
{% set showToday = panels.today.appointments or panels.today.working %}
{% if showAttention or showToday %}
<div class="grid gap-4 lg:gap-5 {{ 'lg:grid-cols-2' if showAttention and showToday }}">

  {% if showAttention %}
    <section class="flex flex-col rounded-3xl border border-line bg-white p-5 shadow-soft sm:p-6 lg:h-[30rem]" aria-labelledby="attention-h">
      <div class="flex items-center justify-between gap-3">
        <h2 id="attention-h" class="flex items-center gap-2.5 text-lg font-bold">
          Needs attention
          {% if panels.attention.length %}<span class="grid h-6 min-w-6 place-items-center rounded-full bg-accent-600 px-1.5 text-xs font-bold text-white">{{ panels.attention.length }}</span>{% endif %}
        </h2>
      </div>
      {% if panels.attention.length %}
        <ul class="scroll-panel -mx-1 mt-4 max-h-[24rem] min-h-0 flex-1 space-y-2.5 overflow-y-auto px-1 pb-1 lg:max-h-none" tabindex="0" aria-label="Items needing attention">
          {% for item in panels.attention %}
            <li>
              <a href="{{ item.href }}" class="group flex items-center gap-3.5 rounded-2xl p-3 ring-1 transition duration-200 hover:-translate-y-0.5 hover:shadow-soft {{ 'bg-accent-50/60 ring-accent-100 hover:ring-accent-300' if item.tone == 'red' else 'bg-amber-50 ring-amber-100 hover:ring-amber-300' }}">
                <span class="grid size-10 shrink-0 place-items-center rounded-xl text-white {{ 'bg-accent-600' if item.tone == 'red' else 'bg-amber-500' }}">{{ icon(item.icon, 'size-5') }}</span>
                <span class="min-w-0 flex-1">
                  <span class="block text-[15px] leading-snug font-semibold text-ink">{{ item.title }}</span>
                  <span class="block text-sm text-muted">{{ item.detail }}</span>
                </span>
                <span class="shrink-0 transition duration-200 group-hover:translate-x-0.5 {{ 'text-accent-700' if item.tone == 'red' else 'text-amber-800' }}" aria-hidden="true">{{ icon('chevron-right', 'size-5') }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="mt-4 flex flex-1 flex-col items-center justify-center rounded-2xl bg-brand-50/70 px-6 py-8 text-center ring-1 ring-brand-100">
          <span class="grid size-12 place-items-center rounded-full bg-brand-700 text-white">{{ icon('check', 'size-6') }}</span>
          <p class="mt-3 font-display text-lg font-bold text-ink">All caught up</p>
          <p class="mt-1 text-sm text-muted">Nothing has been waiting too long.</p>
        </div>
      {% endif %}
    </section>
  {% endif %}

  {% if showToday %}
    <section class="flex flex-col rounded-3xl border border-line bg-white p-5 shadow-soft sm:p-6 lg:h-[30rem]" aria-labelledby="today-h">
      <div class="flex items-center justify-between gap-3">
        <h2 id="today-h" class="text-lg font-bold">Today at HLO</h2>
        <span class="text-sm text-muted">{{ panels.today.date | date({ weekday: 'long', month: 'short', day: 'numeric', timeZone: 'UTC' }) }}</span>
      </div>

      <div class="scroll-panel -mx-1 mt-4 max-h-[24rem] min-h-0 flex-1 overflow-y-auto px-1 lg:max-h-none" tabindex="0" aria-label="Today’s appointments and staff">
      {% if panels.today.appointments %}
        <h3 class="flex items-center gap-2 text-xs font-bold tracking-wide text-muted uppercase">Appointments{% if panels.today.appointments.length %} <span class="rounded-full bg-surface px-2 py-0.5 text-[11px] text-ink ring-1 ring-line">{{ panels.today.appointments.length }}</span>{% endif %}</h3>
        {% if panels.today.appointments.length %}
          <ol class="mt-2 divide-y divide-line">
            {% for a in panels.today.appointments %}
              <li>
                <a href="{{ a.href }}" class="group -mx-2 flex items-center gap-3 rounded-xl px-2 py-2.5 hover:bg-surface {{ 'opacity-60' if a.past }}">
                  <span class="w-[4.5rem] shrink-0 font-display text-sm font-bold text-ink tabular-nums">{{ a.time }}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[15px] font-semibold text-ink group-hover:text-brand-700">{{ a.name }}</span>
                    <span class="block truncate text-sm text-muted">{{ a.type }}{% if a.with %} · with {{ a.with }}{% endif %}</span>
                  </span>
                  {% if a.status == 'completed' %}<span class="shrink-0 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-semibold text-brand-800">Done</span>
                  {% elif a.status == 'no_show' %}<span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">No-show</span>{% endif %}
                </a>
              </li>
            {% endfor %}
          </ol>
        {% else %}
          <p class="mt-2 rounded-2xl bg-surface px-4 py-3 text-[15px] text-muted">No appointments booked for today.</p>
        {% endif %}
      {% endif %}

      {% if panels.today.working %}
        <h3 class="mt-5 flex items-center gap-2 text-xs font-bold tracking-wide text-muted uppercase">Working today{% if panels.today.working.length %} <span class="rounded-full bg-surface px-2 py-0.5 text-[11px] text-ink ring-1 ring-line">{{ panels.today.working.length }}</span>{% endif %}</h3>
        {% if panels.today.working.length %}
          {% set crew = panels.today.working %}
          {# Works for 3 people or 50: a summary, a few faces, then the first 8 (on now first). #}
          <div class="mt-2 flex items-center gap-3">
            <span class="flex -space-x-2" aria-hidden="true">
              {% for p in crew %}{% if loop.index <= 6 %}
                <span class="relative grid size-8 place-items-center rounded-full text-[11px] font-bold text-white ring-2 ring-white {{ ['bg-brand-700', 'bg-[#2a78d6]', 'bg-accent-600', 'bg-[#1e293b]', 'bg-brand-600', 'bg-amber-600'][loop.index0 % 6] }}" title="{{ p.name }}">{{ p.name | first }}{{ (p.name.split(' ') | last) | first }}</span>
              {% endif %}{% endfor %}
              {% if crew.length > 6 %}<span class="grid size-8 place-items-center rounded-full bg-surface text-[11px] font-bold text-ink ring-2 ring-white">+{{ crew.length - 6 }}</span>{% endif %}
            </span>
            <p class="text-sm"><span class="font-semibold text-ink">{{ crew.length }} working</span> <span class="text-muted">·</span> <span class="inline-flex items-center gap-1 text-brand-800"><span class="size-2 rounded-full bg-brand-500" aria-hidden="true"></span>{{ panels.today.onNow }} on now</span></p>
          </div>
          <ul class="mt-3 divide-y divide-line">
            {% for p in crew %}{% if loop.index <= 8 %}
              <li class="flex items-center gap-3 py-2">
                <span class="size-2 shrink-0 rounded-full {{ 'bg-brand-500' if p.onNow else 'bg-line' }}" aria-hidden="true"></span>
                <span class="min-w-0 flex-1 truncate text-[15px] text-ink">{% if can('accounts.view') %}<a href="/portal/accounts/{{ p.id }}" class="font-semibold text-ink underline-offset-2 hover:text-brand-700 hover:underline">{{ p.name }}</a>{% else %}<span class="font-semibold">{{ p.name }}</span>{% endif %}{% if p.label %} <span class="text-sm text-muted">· {{ p.label }}</span>{% endif %}{% if p.onNow %}<span class="sr-only"> (working now)</span>{% endif %}</span>
                <span class="shrink-0 text-sm text-muted tabular-nums">{{ p.from }}–{{ p.until }}</span>
              </li>
            {% endif %}{% endfor %}
          </ul>
          {% if crew.length > 8 %}<a href="/portal/schedule" class="mt-1 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800">+{{ crew.length - 8 }} more on the team schedule</a>{% endif %}
        {% else %}
          <p class="mt-2 rounded-2xl bg-surface px-4 py-3 text-[15px] text-muted">No shifts on the schedule today.</p>
        {% endif %}
        {% if panels.today.off.length %}
          <p class="mt-3 text-sm text-muted"><span class="font-semibold text-ink">Off today:</span> {% for p in panels.today.off %}{{ p.name }}{{ ', ' if not loop.last }}{% endfor %}</p>
        {% endif %}
      {% endif %}
      </div>

      <div class="mt-3 flex flex-wrap gap-2 border-t border-line pt-4">
        {% if panels.today.appointments %}<a href="/portal/appointments/calendar?date={{ panels.today.date }}" class="btn-green flex-1 !px-4 !py-2 text-sm sm:flex-none">{{ icon('calendar', 'size-4') }} Open the calendar</a>{% endif %}
        {% if panels.today.working %}<a href="/portal/schedule" class="btn-dark flex-1 !px-4 !py-2 text-sm sm:flex-none">{{ icon('users', 'size-4') }} Team schedule</a>{% endif %}
      </div>
    </section>
  {% endif %}

</div>
{% endif %}
