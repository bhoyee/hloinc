{% set footerCta = cms.link('site.footer.cta', 'Request services', '/request-services') %}
{% set footerCta2 = cms.link('site.footer.cta2', 'Make a referral', '/referrals') %}
<footer class="bg-brand-950 text-brand-100">
  <div class="container-page grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="font-display text-2xl font-bold text-white">{{ cms.text('site.footer.tagline', 'We care, we can.') }}</p>
      <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-brand-200">
        {{ cms.text('site.footer.blurb', 'Supporting people with developmental disabilities to live independent lives as adults, with community inclusion as a choice.') }}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="{{ footerCta.href }}" {{ footerCta.attrs }} class="btn-light">{{ footerCta.label }} {{ icon('arrow-right', 'size-4') }}</a>
        <a href="{{ footerCta2.href }}" {{ footerCta2.attrs }} class="btn-ghost-light">{{ footerCta2.label }}</a>
      </div>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">{{ cms.text('site.footer.startHeading', 'Get started') }}</h2>
      <ul class="mt-4 space-y-2.5 text-[15px] text-brand-200">
        {% for l in cms.list('site.footer.start', [
          { label: 'Request services', href: '/request-services' }, { label: 'Make a referral', href: '/referrals' },
          { label: 'Join our team', href: '/careers' }, { label: 'Resources', href: '/resources' }
        ]) %}
          <li {{ l.attrs }}><a class="hover:text-white" href="{{ l.href }}" {{ l.hrefAttrs }}>{{ l.text('label') }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">{{ cms.text('site.footer.aboutHeading', 'About HLO') }}</h2>
      <ul class="mt-4 space-y-2.5 text-[15px] text-brand-200">
        {% for l in cms.list('site.footer.links', [
          { label: 'Who we are', href: '/about' }, { label: 'Our services', href: '/services' },
          { label: 'Service area', href: '/about#service-area' }, { label: 'Getting started', href: '/getting-started' },
          { label: 'Contact us', href: '/contact' }
        ]) %}
          <li {{ l.attrs }}><a class="hover:text-white" href="{{ l.href }}" {{ l.hrefAttrs }}>{{ l.text('label') }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="lg:col-span-4">
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">{{ cms.text('site.footer.contactHeading', 'Contact') }}</h2>
      <address class="mt-4 space-y-3 text-[15px] not-italic text-brand-200">
        <p class="flex gap-3">{{ icon('map-pin', 'mt-0.5 size-5 shrink-0 text-brand-400') }}
          <span>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span></p>
        <p><a class="flex items-center gap-3 hover:text-white" href="{{ site.phone | telHref }}">{{ icon('phone', 'size-5 shrink-0 text-brand-400') }} {{ site.phone }}</a></p>
        <p><a class="flex items-center gap-3 hover:text-white" href="mailto:{{ site.email }}">{{ icon('mail', 'size-5 shrink-0 text-brand-400') }} {{ site.email }}</a></p>
        <p class="flex gap-3">{{ icon('clock', 'mt-0.5 size-5 shrink-0 text-brand-400') }} <span>{{ site.hours }}<br>{{ cms.text('site.footer.weekend', 'Sat – Sun closed') }}</span></p>
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-4 py-6 text-sm text-brand-300 lg:flex-row lg:items-center lg:justify-between">
      <p>&copy; {{ currentYear }} {{ site.legalName }} {{ cms.text('site.footer.rights', 'All rights reserved.') }}</p>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {% for l in cms.list('site.footer.legal', [
            { label: 'Terms & Conditions', href: '/terms' }, { label: 'Privacy Policy', href: '/privacy' }, { label: 'Data Protection', href: '/data-protection' },
            { label: 'Cookie Policy', href: '/cookies' }, { label: 'Staff login', href: '/portal' }
          ]) %}
            <li {{ l.attrs }}><a href="{{ l.href }}" {{ l.hrefAttrs }} class="hover:text-white">{{ l.text('label') }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <p>Powered by <a href="https://giddyhost.com" target="_blank" rel="noopener" class="font-semibold text-white hover:text-accent-100">GiddyHost</a><span class="sr-only"> (opens in a new tab)</span></p>
    </div>
  </div>
</footer>
