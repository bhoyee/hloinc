<footer class="mt-24 bg-brand-900 text-brand-50">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-bold text-white">{{ site.legalName }}</p>
      <p class="mt-3 text-sm text-brand-100">Community-based supports across Central and Southern Maryland.</p>
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Visit</h2>
      <address class="mt-3 text-sm not-italic leading-relaxed text-brand-100">
        {{ site.address.street }}<br>
        {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}
      </address>
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Contact</h2>
      <ul class="mt-3 space-y-1 text-sm text-brand-100">
        <li><a class="hover:text-white" href="tel:{{ site.phone | replace('-', '') }}">{{ site.phone }}</a></li>
        <li><a class="hover:text-white" href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li>{{ site.hours }}</li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Explore</h2>
      <ul class="mt-3 space-y-1 text-sm text-brand-100">
        {% for item in nav %}<li><a class="hover:text-white" href="{{ item.href }}">{{ item.label }}</a></li>{% endfor %}
        <li><a class="hover:text-white" href="/portal">Staff login</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-800">
    <p class="container-page py-5 text-xs text-brand-200">&copy; {{ currentYear }} {{ site.legalName }} All rights reserved.</p>
  </div>
</footer>
