{# Staff board: every live announcement with who it is for. Scrolls inside a fixed height. Refreshed live. #}
{% if board.length or can('announcements.edit') %}
  {% set AUDIENCE = {
    public: { label: 'Website only', cls: 'bg-[#eaf2fc] text-[#1f5fae] ring-[#c9ddf5]', icon: 'external', bar: 'from-[#2a78d6] to-[#1f5fae]' },
    internal: { label: 'Staff only', cls: 'bg-[#eef1f5] text-[#1e293b] ring-[#d5dbe3]', icon: 'users', bar: 'from-accent-500 to-accent-700' },
    both: { label: 'Website & staff', cls: 'bg-brand-50 text-brand-800 ring-brand-200', icon: 'megaphone', bar: 'from-brand-500 to-brand-700' }
  } %}
  <section id="staff-board" class="flex h-full scroll-mt-24 flex-col rounded-3xl border border-line bg-white p-5 shadow-soft sm:p-6 lg:h-[30rem]" aria-labelledby="board-h">
    <div class="flex items-center justify-between gap-3">
      <h2 id="board-h" class="flex items-center gap-2.5 text-lg font-bold">
        Staff board
        {% if board.length %}<span class="rounded-full bg-surface px-2 py-0.5 text-xs font-semibold text-ink ring-1 ring-line">{{ board.length }}</span>{% endif %}
      </h2>
      {% if can('announcements.edit') %}<a href="/portal/announcements/new" class="text-sm font-semibold text-brand-700 hover:text-brand-800">{{ icon('plus', 'inline size-4') }} Post</a>{% endif %}
    </div>
    {% if board.length %}
      <ul class="scroll-panel -mx-1 mt-4 max-h-[26rem] min-h-0 flex-1 space-y-3 overflow-y-auto px-1 pb-1 lg:max-h-none" tabindex="0" aria-label="Announcements">
        {% for a in board %}
          {% set aud = AUDIENCE[a.audience] %}
          {% set paused = a.paused_at %}
          {% set mayDelete = can('announcements.delete') or (can('announcements.archive') and a.created_by == user.id) %}
          <li class="group/post relative overflow-hidden rounded-2xl p-4 pl-5 ring-1 ring-line {{ 'bg-surface' if paused }}">
            <span class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b {{ aud.bar }}" aria-hidden="true"></span>
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h3 class="min-w-0 font-display text-base leading-snug font-bold text-ink">
                {% if can('announcements.edit') %}<a href="/portal/announcements/{{ a.id }}" class="hover:text-brand-700">{{ a.title }}</a>{% else %}{{ a.title }}{% endif %}
              </h3>
              <span class="flex shrink-0 items-center gap-1.5">
                {% if paused %}<span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900 ring-1 ring-amber-200">{{ icon('pause', 'size-3.5') }} Paused</span>{% endif %}
                <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold ring-1 {{ aud.cls }}">{{ icon(aud.icon, 'size-3.5') }} {{ aud.label }}</span>
              </span>
            </div>
            <p class="mt-1 line-clamp-3 text-[15px] {{ 'text-muted' if paused else 'text-ink/85' }}">{{ a.body }}</p>
            {% if a.link_url %}<a href="{{ a.link_url }}" class="link mt-1.5 inline-block text-sm" {% if a.link_url.startsWith('https://') %}target="_blank" rel="noopener"{% endif %}>{{ a.link_label or 'Learn more' }}</a>{% endif %}
            <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
              <p class="text-xs text-muted">{{ a.author or 'HLO' }} · {{ a.starts_at | date({ month: 'short', day: 'numeric' }) }}{% if a.ends_at %} · until {{ a.ends_at | date({ month: 'short', day: 'numeric' }) }}{% endif %}</p>
              {% if can('announcements.edit') or mayDelete %}
                {# Quick actions: shown on hover or keyboard focus, always on touch screens. #}
                <div class="flex items-center gap-1 opacity-0 transition-opacity duration-150 group-hover/post:opacity-100 group-focus-within/post:opacity-100 [@media(hover:none)]:opacity-100" role="group" aria-label="Actions for {{ a.title }}">
                  {% if can('announcements.edit') %}
                    <a href="/portal/announcements/{{ a.id }}" class="grid size-8 place-items-center rounded-lg text-muted ring-1 ring-line hover:bg-white hover:text-brand-700" title="Edit">{{ icon('pencil', 'size-4') }}<span class="sr-only">Edit</span></a>
                    <form method="post" action="/portal/announcements/{{ a.id }}/pause">
                      <input type="hidden" name="_csrf" value="{{ csrfToken() }}"><input type="hidden" name="back" value="/portal#staff-board">
                      <input type="hidden" name="action" value="{{ 'resume' if paused else 'pause' }}">
                      {% if paused %}<button type="submit" class="grid size-8 place-items-center rounded-lg bg-brand-700 text-white hover:bg-brand-800" title="Resume">{{ icon('play', 'size-4') }}<span class="sr-only">Resume</span></button>
                      {% else %}<button type="submit" class="grid size-8 place-items-center rounded-lg text-muted ring-1 ring-line hover:bg-white hover:text-amber-700" title="Pause">{{ icon('pause', 'size-4') }}<span class="sr-only">Pause</span></button>{% endif %}
                    </form>
                    <form method="post" action="/portal/announcements/{{ a.id }}/end" data-confirm-title="End this announcement?" data-confirm="“{{ a.title }}” stops showing everywhere. It stays on record under Ended.">
                      <input type="hidden" name="_csrf" value="{{ csrfToken() }}"><input type="hidden" name="back" value="/portal#staff-board">
                      <button type="submit" class="grid size-8 place-items-center rounded-lg text-muted ring-1 ring-line hover:bg-white hover:text-ink" title="End now">{{ icon('stop', 'size-4') }}<span class="sr-only">End now</span></button>
                    </form>
                  {% endif %}
                  {% if mayDelete %}
                    <form method="post" action="/portal/announcements/{{ a.id }}/archive" data-confirm-title="Delete this announcement?" data-confirm="“{{ a.title }}” will be hidden on the website and staff board. {{ 'An Admin can restore it.' if not can('announcements.delete') else 'You can restore it from the Deleted tab.' }}">
                      <input type="hidden" name="_csrf" value="{{ csrfToken() }}"><input type="hidden" name="back" value="/portal#staff-board">
                      <input type="hidden" name="action" value="delete">
                      <button type="submit" class="grid size-8 place-items-center rounded-lg text-muted ring-1 ring-line hover:bg-accent-50 hover:text-accent-700" title="Delete">{{ icon('trash', 'size-4') }}<span class="sr-only">Delete</span></button>
                    </form>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="mt-4 flex flex-1 items-center justify-center rounded-2xl border-2 border-dashed border-line p-6 text-center text-sm text-muted">No announcements right now. Anything you post appears here, marked website, staff or both.</p>
    {% endif %}
  </section>
{% endif %}
