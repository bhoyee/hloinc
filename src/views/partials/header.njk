{% set navItems = cms.list('site.nav', nav) %}
{% set headerCta = cms.link('site.header.cta', 'Request Services', '/request-services') %}
{% set headerCta2 = cms.link('site.header.cta2', 'Make a Referral', '/referrals') %}
<header class="sticky top-0 z-40 border-b border-line/80 bg-white">
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="{{ site.legalName }} home">
      {% set logo = cms.image('site.logo', { src: '/img/logo.png', srcSm: '/img/logo.png', w: 647, h: 200, alt: site.legalName }) %}
      <img src="{{ logo.src }}" alt="{{ logo.alt or site.legalName }}" width="{{ logo.w }}" height="{{ logo.h }}" class="h-12 w-auto sm:h-16 dark:hidden" {{ logo.attrs }}>
      {# The same logo with light lettering on a clear background, for the dark theme. #}
      <img src="/img/logo-dark.png" alt="{{ logo.alt or site.legalName }}" width="647" height="200" class="hidden h-12 w-auto sm:h-16 dark:block">
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {% for item in navItems %}
          {% set active = currentPath == item.href or (item.href != '/' and currentPath.startsWith(item.href + '/')) %}
          <li {{ item.attrs }}>
            <a href="{{ item.href }}" {{ item.hrefAttrs }}
               class="rounded-full px-4 py-2 text-[15px] font-semibold transition {{ 'bg-brand-50 text-brand-800' if active else 'text-muted hover:bg-surface hover:text-ink' }}"
               {% if active %}aria-current="page"{% endif %}>{{ item.text('label') }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" data-theme-toggle class="grid size-11 place-items-center rounded-full text-muted transition hover:bg-surface hover:text-ink"
              aria-label="Switch to dark theme" title="Switch to dark theme">
        <span class="dark:hidden">{{ icon('moon', 'size-5') }}</span>
        <span class="hidden dark:inline">{{ icon('sun', 'size-5') }}</span>
      </button>
      <a href="{{ headerCta.href }}" {{ headerCta.attrs }} class="btn-primary hidden !px-5 sm:inline-flex">{{ headerCta.label }} {{ icon('arrow-right', 'size-4') }}</a>
      <button type="button" class="grid size-11 place-items-center rounded-full text-brand-900 hover:bg-surface lg:hidden"
              aria-controls="mobile-nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only" data-menu-label>Open menu</span>
        <span data-menu-open>{{ icon('menu', 'size-6') }}</span>
        <span data-menu-close class="hidden">{{ icon('close', 'size-6') }}</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-line bg-white lg:hidden">
    <ul class="container-page flex flex-col gap-1 py-4">
      {% for item in navItems %}
        {% set active = currentPath == item.href or (item.href != '/' and currentPath.startsWith(item.href + '/')) %}
        <li><a href="{{ item.href }}" class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-surface {{ 'bg-brand-50 text-brand-800' if active else 'text-ink' }}"
               {% if active %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
      <li class="pt-3"><a href="{{ headerCta.href }}" class="btn-primary w-full">{{ headerCta.label }}</a></li>
      <li><a href="{{ headerCta2.href }}" class="btn-green mt-2 w-full">{{ headerCta2.label }}</a></li>
      <li><a href="{{ site.phone | telHref }}" class="btn-secondary mt-2 w-full">{{ icon('phone', 'size-4') }} Call {{ site.phone }}</a></li>
    </ul>
  </nav>
</header>
