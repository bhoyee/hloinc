<header class="sticky top-0 z-40 border-b border-brand-100 bg-white/95 backdrop-blur">
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 font-display text-xl font-bold text-brand-800">
      {# Replace with the HLO logo once supplied (public/img/logo.svg). #}
      <span class="grid size-9 place-items-center rounded-lg bg-brand-600 text-sm text-white" aria-hidden="true">HLO</span>
      <span>{{ site.legalName }}</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {% for item in nav %}
          <li>
            <a href="{{ item.href }}"
               class="text-sm font-medium text-muted hover:text-brand-700 {% if currentPath.startsWith(item.href) %}text-brand-700{% endif %}"
               {% if currentPath.startsWith(item.href) %}aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/getting-started" class="btn-accent hidden sm:inline-flex">Start intake</a>
      <button type="button" class="rounded-md p-2 text-brand-800 lg:hidden"
              aria-controls="mobile-nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-brand-100 lg:hidden">
    <ul class="container-page flex flex-col py-3">
      {% for item in nav %}
        <li><a href="{{ item.href }}" class="block py-2.5 font-medium text-ink">{{ item.label }}</a></li>
      {% endfor %}
      <li class="pt-2"><a href="/getting-started" class="btn-accent w-full">Start intake</a></li>
    </ul>
  </nav>
</header>
