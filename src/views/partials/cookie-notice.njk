{# Informational only: the site uses strictly necessary cookies, which need no consent.
   Hidden until site.js confirms it hasn't been dismissed, so it never flashes. #}
<div id="cookie-notice" role="region" aria-label="Cookie notice" hidden
     class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-xl rounded-2xl bg-ink p-4 text-white shadow-lift sm:inset-x-auto sm:right-6 sm:bottom-6 sm:p-5">
  <div class="flex items-start gap-4">
    <p class="flex-1 text-sm leading-relaxed text-white/90">
      {{ cms.text('site.cookie.text', 'We use only essential cookies to keep forms secure and staff signed in. No tracking or advertising.') }}
      <a href="/cookies" class="font-semibold text-white underline underline-offset-2">Cookie Policy</a>
    </p>
    <button type="button" data-cookie-dismiss class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-semibold text-ink hover:bg-brand-50">OK</button>
  </div>
</div>
