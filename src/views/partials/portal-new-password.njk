{# New-password fields, shared by invite, reset and change-password forms. Expects `errors`. #}
{% import "partials/ui.njk" as ui %}
<div>
  <label for="f-password" class="form-label">New password</label>
  <input id="f-password" type="password" name="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="128" required aria-required="true"
    aria-describedby="f-password-hint{% if errors.password %} f-password-error{% endif %}" {% if errors.password %}aria-invalid="true"{% endif %}>
  <p id="f-password-hint" class="form-hint">At least 12 characters. A short phrase of a few unrelated words is strong and easy to remember.</p>
  {{ ui.fieldError('password', errors) }}
</div>
<div>
  <label for="f-confirm" class="form-label">Type it again</label>
  <input id="f-confirm" type="password" name="confirm" class="form-control" autocomplete="new-password" maxlength="128" required aria-required="true"
    {% if errors.confirm %}aria-invalid="true" aria-describedby="f-confirm-error"{% endif %}>
  {{ ui.fieldError('confirm', errors) }}
</div>
