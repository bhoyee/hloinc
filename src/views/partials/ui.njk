{# Shared UI macros. Import with: {% import "partials/ui.njk" as ui %} #}

{% macro pageHero(eyebrow, title, intro, crumbs=[]) %}
  <section class="relative overflow-hidden border-b border-line bg-surface">
    <div class="pointer-events-none absolute -top-24 -right-24 size-96 rounded-full bg-brand-100/60 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative py-14 sm:py-20">
      {% if crumbs.length %}
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
            <li><a href="/" class="hover:text-brand-700">Home</a></li>
            {% for c in crumbs %}
              <li class="flex items-center gap-1.5">
                {{ icon('chevron-right', 'size-3.5 text-[#93a49b]') }}
                {% if c.href %}<a href="{{ c.href }}" class="hover:text-brand-700">{{ c.label }}</a>
                {% else %}<span aria-current="page" class="font-medium text-ink">{{ c.label }}</span>{% endif %}
              </li>
            {% endfor %}
          </ol>
        </nav>
      {% endif %}
      {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold sm:text-5xl">{{ title }}</h1>
      {% if intro %}<p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">{{ intro }}</p>{% endif %}
      {{ caller() if caller }}
    </div>
  </section>
{% endmacro %}

{% macro sectionHeading(eyebrow, title, intro, center=false) %}
  <div class="{{ 'mx-auto text-center' if center }} max-w-2xl">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{{ title }}</h2>
    {% if intro %}<p class="mt-4 text-lg text-muted">{{ intro }}</p>{% endif %}
  </div>
{% endmacro %}

{% macro flash(flash) %}
  {% if flash %}
    <div role="status" class="mb-8 flex gap-3 rounded-2xl border p-4 {{ 'border-brand-200 bg-brand-50 text-brand-900' if flash.type == 'success' else 'border-accent-100 bg-accent-50 text-accent-700' }}">
      {{ icon('check' if flash.type == 'success' else 'exclamation', 'size-6 shrink-0') }}
      <p class="font-medium">{{ flash.message }}</p>
    </div>
  {% endif %}
{% endmacro %}

{# errors: { field: message }; labels: { field: 'Label' } — links each error to its field. #}
{% macro errorSummary(errors, labels) %}
  {% if errors | length %}
    <div class="mb-8 rounded-2xl border-2 border-accent-600 bg-accent-50 p-5" role="alert" tabindex="-1" id="error-summary" data-focus-on-load>
      <h2 class="flex items-center gap-2 text-lg font-bold text-accent-700">
        {{ icon('exclamation', 'size-6') }} Please fix the following
      </h2>
      <ul class="mt-3 list-disc space-y-1 pl-6 text-accent-700">
        {% for field, message in errors %}
          <li><a href="#f-{{ field }}" class="underline underline-offset-2">{{ message }}</a></li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endmacro %}

{% macro fieldError(name, errors) %}
  {% if errors[name] %}
    <p id="f-{{ name }}-error" class="form-error">{{ icon('exclamation', 'size-4 shrink-0') }} {{ errors[name] }}</p>
  {% endif %}
{% endmacro %}

{% macro describedBy(name, errors, hint=false) -%}
  {%- set d = ('f-' + name + '-hint') if hint else '' -%}
  {%- if errors[name] %}{% set d = ((d + ' ') if d else '') + 'f-' + name + '-error' %}{% endif -%}
  {%- if d %} aria-describedby="{{ d }}"{% endif -%}
{%- endmacro %}

{% macro input(name, label, values, errors, type='text', required=true, hint='', autocomplete='', attrs='') %}
  <div>
    <label for="f-{{ name }}" class="form-label">{{ label }}{% if not required %} <span class="font-normal text-muted">(optional)</span>{% endif %}</label>
    <input id="f-{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ values[name] }}" class="form-control"
      {% if required %}required aria-required="true"{% endif %}
      {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
      {% if errors[name] %}aria-invalid="true"{% endif %}
      {{ describedBy(name, errors, hint) }} {{ attrs | safe }}>
    {% if hint %}<p id="f-{{ name }}-hint" class="form-hint">{{ hint }}</p>{% endif %}
    {{ fieldError(name, errors) }}
  </div>
{% endmacro %}

{% macro textarea(name, label, values, errors, required=true, hint='', rows=5, maxlength=3000) %}
  <div>
    <label for="f-{{ name }}" class="form-label">{{ label }}{% if not required %} <span class="font-normal text-muted">(optional)</span>{% endif %}</label>
    <textarea id="f-{{ name }}" name="{{ name }}" rows="{{ rows }}" maxlength="{{ maxlength }}" class="form-control"
      {% if required %}required aria-required="true"{% endif %}
      {% if errors[name] %}aria-invalid="true"{% endif %}
      {{ describedBy(name, errors, hint) }}>{{ values[name] }}</textarea>
    {% if hint %}<p id="f-{{ name }}-hint" class="form-hint">{{ hint }}</p>{% endif %}
    {{ fieldError(name, errors) }}
  </div>
{% endmacro %}

{# Hidden field bots fill in; people never see it. #}
{% macro honeypot() %}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for="f-website">Leave this field empty</label>
    <input id="f-website" type="text" name="website" tabindex="-1" autocomplete="off">
  </div>
{% endmacro %}

{% macro ctaBand(site) %}
  <section class="container-page section">
    <div class="relative overflow-hidden rounded-[2rem] bg-brand-900 px-6 py-14 text-white sm:px-14 sm:py-16">
      <div class="pointer-events-none absolute -right-16 -bottom-24 size-80 rounded-full bg-brand-600/40 blur-2xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -top-20 left-1/3 size-56 rounded-full bg-accent-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <h2 class="text-3xl font-extrabold text-white sm:text-4xl">Ready to talk about support?</h2>
          <p class="mt-3 max-w-xl text-lg text-brand-100">Our team is available {{ site.hours | replace(r/\.$/, "") }}. Reach out and we will walk you through your options.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/getting-started" class="btn-light">Start intake {{ icon('arrow-right', 'size-4') }}</a>
          <a href="{{ site.phone | telHref }}" class="btn-ghost-light">{{ icon('phone', 'size-4') }} {{ site.phone }}</a>
        </div>
      </div>
    </div>
  </section>
{% endmacro %}
