{# Shared UI macros. Import with: {% import "partials/ui.njk" as ui %} #}

{% macro pageHero(eyebrow, title, intro, crumbs=[], image=null, imageAlt='') %}
  <section class="border-b border-line bg-cream">
    <div class="container-page grid items-center gap-10 py-12 sm:py-16 {{ 'lg:grid-cols-[1.15fr_1fr] lg:gap-16' if image }}">
      <div>
        {% if crumbs.length %}
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
              <li><a href="/" class="hover:text-brand-700">Home</a></li>
              {% for c in crumbs %}
                <li class="flex items-center gap-1.5">
                  {{ icon('chevron-right', 'size-3.5 text-[#93a49b]') }}
                  {% if c.href %}<a href="{{ c.href }}" class="hover:text-brand-700">{{ c.label }}</a>
                  {% else %}<span aria-current="page" class="font-medium text-ink">{{ c.label }}</span>{% endif %}
                </li>
              {% endfor %}
            </ol>
          </nav>
        {% endif %}
        {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
        <h1 class="mt-4 max-w-3xl text-4xl font-extrabold sm:text-5xl">{{ title }}</h1>
        {% if intro %}<p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">{{ intro }}</p>{% endif %}
        {{ caller() if caller }}
      </div>
      {% if image %}
        <div class="relative">
          <div class="absolute -right-3 -bottom-3 hidden h-full w-full rounded-3xl bg-brand-100 sm:block" aria-hidden="true"></div>
          {% if image.src %}
            <img src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="(min-width: 1024px) 40vw, 100vw" alt="{{ image.alt }}" width="{{ image.w }}" height="{{ image.h }}"
                 class="photo relative aspect-[3/2] shadow-lift" {{ image.attrs }}>
          {% else %}
            <img src="/img/photos/{{ image }}.webp" srcset="/img/photos/{{ image }}-sm.webp 560w, /img/photos/{{ image }}.webp 960w"
                 sizes="(min-width: 1024px) 40vw, 100vw" alt="{{ imageAlt }}" width="960" height="640"
                 class="photo relative aspect-[3/2] shadow-lift">
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>
{% endmacro %}

{% macro sectionHeading(eyebrow, title, intro, center=false) %}
  <div class="{{ 'mx-auto text-center' if center }} max-w-2xl">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{{ title }}</h2>
    {% if intro %}<p class="mt-4 text-lg text-muted">{{ intro }}</p>{% endif %}
  </div>
{% endmacro %}

{% macro flash(flash) %}
  {% if flash %}
    {% if flash.type == 'success' %}{% set tone = 'border-brand-200 bg-brand-50 text-brand-900' %}
    {% elif flash.type == 'warning' %}{% set tone = 'border-amber-200 bg-amber-50 text-amber-900' %}
    {% elif flash.type == 'info' %}{% set tone = 'border-line bg-white text-ink' %}
    {% else %}{% set tone = 'border-accent-100 bg-accent-50 text-accent-700' %}{% endif %}
    <div role="status" class="mb-8 flex gap-3 rounded-2xl border p-4 {{ tone }}">
      {{ icon('check' if flash.type == 'success' else ('info' if flash.type == 'info' else 'exclamation'), 'size-6 shrink-0') }}
      <p class="font-medium">{{ flash.message }}</p>
    </div>
  {% endif %}
{% endmacro %}

{# errors: { field: message }; labels: { field: 'Label' } — links each error to its field. #}
{% macro errorSummary(errors, labels) %}
  {% if errors | length %}
    <div class="mb-8 rounded-2xl border-2 border-accent-600 bg-accent-50 p-5" role="alert" tabindex="-1" id="error-summary" data-focus-on-load>
      <h2 class="flex items-center gap-2 text-lg font-bold text-accent-700">
        {{ icon('exclamation', 'size-6') }} Please fix the following
      </h2>
      <ul class="mt-3 list-disc space-y-1 pl-6 text-accent-700">
        {% for field, message in errors %}
          <li><a href="#f-{{ field }}" class="underline underline-offset-2">{{ message }}</a></li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endmacro %}

{% macro fieldError(name, errors) %}
  {% if errors[name] %}
    <p id="f-{{ name }}-error" class="form-error">{{ icon('exclamation', 'size-4 shrink-0') }} {{ errors[name] }}</p>
  {% endif %}
{% endmacro %}

{% macro describedBy(name, errors, hint=false) -%}
  {%- set d = ('f-' + name + '-hint') if hint else '' -%}
  {%- if errors[name] %}{% set d = ((d + ' ') if d else '') + 'f-' + name + '-error' %}{% endif -%}
  {%- if d %} aria-describedby="{{ d }}"{% endif -%}
{%- endmacro %}

{% macro input(name, label, values, errors, type='text', required=true, hint='', autocomplete='', attrs='') %}
  <div>
    <label for="f-{{ name }}" class="form-label">{{ label }}{% if not required %} <span class="font-normal text-muted">(optional)</span>{% endif %}</label>
    <input id="f-{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ values[name] }}" class="form-control"
      {% if required %}required aria-required="true"{% endif %}
      {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
      {% if errors[name] %}aria-invalid="true"{% endif %}
      {{ describedBy(name, errors, hint) }} {{ attrs | safe }}>
    {% if hint %}<p id="f-{{ name }}-hint" class="form-hint">{{ hint }}</p>{% endif %}
    {{ fieldError(name, errors) }}
  </div>
{% endmacro %}

{% macro textarea(name, label, values, errors, required=true, hint='', rows=5, maxlength=3000) %}
  <div>
    <label for="f-{{ name }}" class="form-label">{{ label }}{% if not required %} <span class="font-normal text-muted">(optional)</span>{% endif %}</label>
    <textarea id="f-{{ name }}" name="{{ name }}" rows="{{ rows }}" maxlength="{{ maxlength }}" class="form-control"
      {% if required %}required aria-required="true"{% endif %}
      {% if errors[name] %}aria-invalid="true"{% endif %}
      {{ describedBy(name, errors, hint) }}>{{ values[name] }}</textarea>
    {% if hint %}<p id="f-{{ name }}-hint" class="form-hint">{{ hint }}</p>{% endif %}
    {{ fieldError(name, errors) }}
  </div>
{% endmacro %}

{# A dropdown. options: { value: 'Label' } or a list of strings (value = label). #}
{% macro select(name, label, values, errors, options, required=false, placeholder='Select…', hint='') %}
  <div>
    <label for="f-{{ name }}" class="form-label">{{ label }}{% if not required %} <span class="font-normal text-muted">(optional)</span>{% endif %}</label>
    <select id="f-{{ name }}" name="{{ name }}" class="form-control" {% if required %}required aria-required="true"{% endif %}
      {% if errors[name] %}aria-invalid="true"{% endif %} {{ describedBy(name, errors, hint) }}>
      <option value="">{{ placeholder }}</option>
      {% if options.length is defined %}
        {% for o in options %}<option value="{{ o }}" {% if values[name] == o %}selected{% endif %}>{{ o }}</option>{% endfor %}
      {% else %}
        {% for key, text in options %}<option value="{{ key }}" {% if values[name] == key %}selected{% endif %}>{{ text }}</option>{% endfor %}
      {% endif %}
    </select>
    {% if hint %}<p id="f-{{ name }}-hint" class="form-hint">{{ hint }}</p>{% endif %}
    {{ fieldError(name, errors) }}
  </div>
{% endmacro %}

{# Hidden fields bots fill in; people never see them (names must match lib/spam.js). #}
{% macro honeypot() %}
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for="f-website">Leave this field empty</label>
    <input id="f-website" type="text" name="website" tabindex="-1" autocomplete="off">
    <label for="f-email_confirm">Leave this field empty</label>
    <input id="f-email_confirm" type="email" name="email_confirm" tabindex="-1" autocomplete="off">
  </div>
{% endmacro %}

{# Cloudflare Turnstile security check — only rendered when keys are configured. #}
{% macro captcha(siteKey, errors) %}
  {% if siteKey %}
    <div id="f-captcha" tabindex="-1">
      <div class="cf-turnstile" data-sitekey="{{ siteKey }}" data-theme="light" data-size="flexible"></div>
      {{ fieldError('captcha', errors) }}
    </div>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  {% endif %}
  {% if errors.limit %}
    <p id="f-limit" class="flex gap-3 rounded-2xl border border-accent-200 bg-accent-50 p-4 text-[15px] text-accent-800" role="alert">
      {{ icon('exclamation', 'mt-0.5 size-5 shrink-0') }} {{ errors.limit }}
    </p>
  {% endif %}
{% endmacro %}

{# emergency: also show the 911 notice just above the band. #}
{% macro ctaBand(site, emergency=false) %}
  {% set ctaPrimary = cms.link('site.cta.primary', 'Request services', '/request-services') %}
  {% set ctaSecondary = cms.link('site.cta.secondary', 'Make a referral', '/referrals') %}
  <section class="container-page section">
    {% if emergency %}
      <p class="mb-4 flex items-center gap-3 rounded-2xl border border-accent-200 bg-accent-50 px-5 py-3.5 text-[15px] font-medium text-accent-800">
        <span class="rounded-lg bg-accent-600 px-2 py-0.5 font-display font-extrabold text-white">911</span>
        <span>{{ cms.text('site.emergency', 'For a life-threatening emergency, call 911.') }}</span>
      </p>
    {% endif %}
    <div class="relative overflow-hidden rounded-[2rem] bg-accent-700 px-6 py-14 text-white sm:px-14 sm:py-16">
      <svg class="pointer-events-none absolute -right-10 -bottom-16 size-80 text-white/10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-9-4.78-9-12a4.5 4.5 0 0 1 9-1.27A4.5 4.5 0 0 1 21 9c0 7.22-9 12-9 12z"/></svg>
      <div class="relative grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{{ cms.text('site.cta.title', 'Not sure where to begin?') }}</h2>
          <p class="mt-3 max-w-xl text-lg text-accent-50">{{ cms.text('site.cta.text', 'Call us or send a short message. We will talk through your situation and the right next step.') }}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="{{ ctaPrimary.href }}" {{ ctaPrimary.attrs }} class="btn-light !text-accent-800">{{ ctaPrimary.label }} {{ icon('arrow-right', 'size-4') }}</a>
          <a href="{{ ctaSecondary.href }}" {{ ctaSecondary.attrs }} class="btn-ghost-light">{{ ctaSecondary.label }}</a>
          <a href="{{ site.phone | telHref }}" class="btn-ghost-light">{{ icon('phone', 'size-4') }} {{ site.phone }}</a>
        </div>
      </div>
    </div>
  </section>
{% endmacro %}
