<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.legalName }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% block meta %}{% endblock %}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-32.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#0b4532">
  {% block headEarly %}{% endblock %}
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/site.js" defer></script>
  {% block scripts %}{% endblock %}
  {% if cmsMode == 'edit' %}
    <meta name="csrf-token" content="{{ csrfToken() }}">
    <script src="/js/cms-frame.js" defer></script>
  {% endif %}
</head>
<body class="{% block bodyClass %}{% endblock %}{{ ' cms-editing' if cmsMode == 'edit' }}">
  <a href="#main" class="skip-link">Skip to main content</a>
  {% block body %}{% endblock %}
  {% if cmsMode == 'edit' %}<script type="application/json" id="cms-registry">{{ cms.registry() | jsonld }}</script>{% endif %}
</body>
</html>
