{% extends "layouts/base.njk" %}

{# The public website (HLO's design, version 20): html.site switches on public/css/site.css. #}
{% block htmlAttrs %} class="site"{% endblock %}

{# Light/dark theme: set before the page is drawn (public website only). #}
{% block headEarly %}<meta name="color-scheme" content="light dark"><script src="/js/theme.js?v={{ assetV }}"></script>{% endblock %}
{% block styles %}<link rel="stylesheet" href="/css/site.css?v={{ assetV }}"><script src="/js/ds.js?v={{ assetV }}" defer></script>{% endblock %}

{% block body %}
  {% include "partials/site-header.njk" %}
  <main id="main" class="{% block mainClass %}{% endblock %}">
    {% block content %}{% endblock %}
  </main>
  {% include "partials/site-footer.njk" %}
  {% include "partials/cookie-notice.njk" %}
{% endblock %}
