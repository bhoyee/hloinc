# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Minutes of inactivity before a staff session expires
SESSION_IDLE_MINUTES=60

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hloinc
DB_USER=root
DB_PASSWORD=

# --- Email (SMTP supplied by HLO) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HLO Inc. <no-reply@hloinc.com>"
