# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Minutes of inactivity before a staff session expires
SESSION_IDLE_MINUTES=60
# Hours after sign-in when staff must sign in again, even if active
SESSION_MAX_HOURS=12
# Encrypts MFA secrets. Same command as SESSION_SECRET; keep it safe and never change it casually.
APP_KEY=change-me-to-a-different-long-random-string

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hloinc
DB_USER=root
DB_PASSWORD=

# --- Email (SMTP supplied by HLO) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HLO Inc. <no-reply@hloinc.com>"

# --- Spam protection (optional) ---
# Cloudflare Turnstile keys (free: dash.cloudflare.com > Turnstile). Leave blank to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Max form submissions per email address per 24 hours
FORMS_MAX_PER_EMAIL_PER_DAY=10

# --- Virus scanning of job application resumes (ClamAV) ---
# auto = clamd daemon if CLAMD_SOCKET/CLAMD_HOST is set, else clamdscan/clamscan if installed
# (cPanel: /usr/local/cpanel/3rdparty/bin/clamdscan). Without a scanner, resumes are saved
# but stay locked until a scan passes.
VIRUS_SCAN=auto
# Shared hosting: scan in Cloudmersive's cloud instead (free key at cloudmersive.com; files are scanned
# in memory and not kept). The free plan scans files up to 2.5 MB, so set RESUME_MAX_MB=2.5 with it.
CLOUDMERSIVE_API_KEY=
RESUME_MAX_MB=5
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=3310
CLAMSCAN_PATH=
# clamscan only (found automatically if blank): virus database folder, ClamAV certificate folder
CLAMAV_DATABASE=
CLAMAV_CERTS_DIR=
