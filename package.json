{
  "name": "hloinc",
  "version": "1.0.0",
  "description": "HLO Inc. public website and staff portal",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon --watch src --ext js,njk app.js",
    "css:build": "tailwindcss -i src/assets/css/app.css -o public/css/app.css --minify",
    "css:watch": "tailwindcss -i src/assets/css/app.css -o public/css/app.css --watch",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "demo:remove": "node scripts/demo-remove.js",
    "create-admin": "node scripts/create-admin.js",
    "alerts:overdue": "node scripts/alerts-overdue.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "node tests/e2e/a11y.mjs",
    "screens": "node tests/e2e/screens.mjs"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.15",
    "nunjucks": "^3.2.4",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
